        <visual name="median_n2_curb"><pose>120.387 524.358 0.10 0 0 1.34512</pose><geometry><box><size>76.00 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
