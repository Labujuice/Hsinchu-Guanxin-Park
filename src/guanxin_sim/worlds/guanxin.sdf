    <!-- 6. 富宇君鼎大樓 (Fu Yu Jun Ding - 關新北路以北，關新路與關新東路間之 24 層現代豪華塔樓) -->
    <model name="fuyu_junding_tower">
      <static>true</static>
      <link name="junding_link">
        <collision name="junding_col"><pose>385 -60 26 0 0 0</pose><geometry><box><size>38 50 52</size></box></geometry></collision>
