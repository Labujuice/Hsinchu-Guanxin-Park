<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="guanxin_world">
    <!-- ==================== 物理引擎設定 (ODE 物理引擎，高頻步長 0.002s / 500Hz) ==================== -->
    <physics name="default_physics" type="ode" default="true">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- ==================== Gazebo Harmonic 核心系統外掛 ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ==================== 環境光照與太陽光源 ==================== -->
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.72 0.82 0.92 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>150 -60 200 0.6 0.4 -0.8</pose>
      <diffuse>0.92 0.90 0.86 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- ==================== 地面大底 (Ground Plane 600m x 600m) ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kd>100000</kd><kp>10000000</kp></ode></contact>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <material><ambient>0.42 0.44 0.42 1</ambient><diffuse>0.48 0.50 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 道路路網、巷弄、分隔島與人行道系統 ==================== -->
    <!-- 依據實測幾何: 關新路全長560m, 雙向四線道, 中央綠化分隔島, 關新一街(X=86), 關新二街(X=337), 關新北路(X=481) -->
    <model name="road_network">
      <static>true</static>
      <link name="road_link">
        <!-- 1. 關新路主幹道柏油路面 (X: 0 ~ 560, Y: -9 ~ +9, 寬 18m, 雙向四線道) -->
        <collision name="guanxin_asphalt_col"><pose>280 0 0.01 0 0 0</pose><geometry><box><size>560 18 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="guanxin_asphalt_vis"><pose>280 0 0.01 0 0 0</pose><geometry><box><size>560 18 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 中央綠化分隔島 (Green Median Strips with Curb & Keep-Right Signs) ===== -->
        <!-- 分隔島南段1 (光復路口至關新一街口 X: 15 ~ 75, Y: -0.9 ~ +0.9, 長 60m) -->
        <collision name="median_s1_col"><pose>45 0 0.10 0 0 0</pose><geometry><box><size>60 1.8 0.20</size></box></geometry></collision>
        <visual name="median_s1_curb"><pose>45 0 0.10 0 0 0</pose><geometry><box><size>60 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_s1_lawn"><pose>45 0 0.205 0 0 0</pose><geometry><box><size>58 1.4 0.01</size></box></geometry><material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <visual name="median_s1_tip_s"><pose>15.2 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="median_s1_tip_n"><pose>74.8 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>

        <!-- 分隔島中段 (關新一街口至關新二街口 X: 98 ~ 325, Y: -0.9 ~ +0.9, 長 227m) -->
        <collision name="median_mid_col"><pose>211.5 0 0.10 0 0 0</pose><geometry><box><size>227 1.8 0.20</size></box></geometry></collision>
        <visual name="median_mid_curb"><pose>211.5 0 0.10 0 0 0</pose><geometry><box><size>227 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_mid_lawn"><pose>211.5 0 0.205 0 0 0</pose><geometry><box><size>225 1.4 0.01</size></box></geometry><material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <visual name="median_mid_tip_s"><pose>98.2 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="median_mid_tip_n"><pose>324.8 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <!-- 關新二街路口遵行方向藍色指示牌 (Street_photo3 & 5 實景) -->
        <visual name="median_mid_sign_pole"><pose>324 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="median_mid_sign_board"><pose>324 0 2.2 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>0.04</length></cylinder></geometry><material><ambient>0.0 0.3 0.8 1</ambient><diffuse>0.0 0.4 0.9 1</diffuse><emissive>0.0 0.2 0.5 1</emissive></material></visual>

        <!-- 分隔島北段 (關新二街口至關新北路口 X: 349 ~ 469, Y: -0.9 ~ +0.9, 長 120m) -->
        <collision name="median_north_col"><pose>409 0 0.10 0 0 0</pose><geometry><box><size>120 1.8 0.20</size></box></geometry></collision>
        <visual name="median_north_curb"><pose>409 0 0.10 0 0 0</pose><geometry><box><size>120 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_north_lawn"><pose>409 0 0.205 0 0 0</pose><geometry><box><size>118 1.4 0.01</size></box></geometry><material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <visual name="median_north_tip_s"><pose>349.2 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="median_north_tip_n"><pose>468.8 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>

        <!-- ===== 2. 關新一街 (Guanxin 1st St. - X: 80 ~ 92, 中心 X=86, 路寬 12m) ===== -->
        <!-- 東段：自關新路延伸至關新東路 (Y: -112 ~ -9, 長 103m) -->
        <collision name="gx1st_east_col"><pose>86 -60.5 0.01 0 0 0</pose><geometry><box><size>12 103 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx1st_east_vis"><pose>86 -60.5 0.01 0 0 0</pose><geometry><box><size>12 103 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <!-- 西段：自關新路延伸至西側社區 (Y: 9 ~ 55, 長 46m) -->
        <collision name="gx1st_west_col"><pose>86 32 0.01 0 0 0</pose><geometry><box><size>12 46 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx1st_west_vis"><pose>86 32 0.01 0 0 0</pose><geometry><box><size>12 46 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 3. 關新二街 (Guanxin 2nd St. - X: 330 ~ 344, 中心 X=337, 路寬 14m) ===== -->
        <collision name="gx2nd_east_col"><pose>337 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx2nd_east_vis"><pose>337 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <collision name="gx2nd_west_col"><pose>337 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry></collision>
        <visual name="gx2nd_west_vis"><pose>337 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 4. 關新北路 (Guanxin North Rd. - X: 474 ~ 488, 中心 X=481, 路寬 14m) ===== -->
        <collision name="gxnorth_east_col"><pose>481 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry></collision>
        <visual name="gxnorth_east_vis"><pose>481 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <collision name="gxnorth_west_col"><pose>481 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry></collision>
        <visual name="gxnorth_west_vis"><pose>481 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 5. 關新東路全線 (Guanxin East Rd. - Y: -119 ~ -105, 寬 14m, 全長 X: 10 ~ 500) ===== -->
        <collision name="gxeast_col"><pose>255 -112 0.01 0 0 0</pose><geometry><box><size>490 14 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxeast_vis"><pose>255 -112 0.01 0 0 0</pose><geometry><box><size>490 14 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 6. 商圈後方南北向服務巷弄 (Mid-Block Service Alley: Y: -66 ~ -60, 寬 6m, X: 86 ~ 337) ===== -->
        <collision name="gx_midblock_alley_col"><pose>211.5 -63 0.01 0 0 0</pose><geometry><box><size>251 6 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_midblock_alley_vis"><pose>211.5 -63 0.01 0 0 0</pose><geometry><box><size>251 6 0.02</size></box></geometry><material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material></visual>

        <!-- ===== 7. 橫向社區聯絡弄 (East-West Community Connecting Alleys) ===== -->
        <collision name="gx_midblock_east_alley_col"><pose>170 -85.5 0.01 0 0 0</pose><geometry><box><size>6 39 0.02</size></box></geometry></collision>
        <visual name="gx_midblock_east_alley_vis"><pose>170 -85.5 0.01 0 0 0</pose><geometry><box><size>6 39 0.02</size></box></geometry><material><ambient>0.25 0.25 0.26 1</ambient><diffuse>0.27 0.27 0.28 1</diffuse></material></visual>

        <!-- ===== 8. 光復路一段268巷41弄 (X: 83 ~ 89, 寬 6m, Y: -145 ~ -119) ===== -->
        <collision name="guangfu_268_41_col"><pose>86 -132 0.01 0 0 0</pose><geometry><box><size>6 26 0.02</size></box></geometry></collision>
        <visual name="guangfu_268_41_vis"><pose>86 -132 0.01 0 0 0</pose><geometry><box><size>6 26 0.02</size></box></geometry><material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material></visual>

        <!-- ===== 9. 西側巷弄 (West Side Lanes & Alleys) ===== -->
        <collision name="gx_lane19_col"><pose>14 28.5 0.01 0 0 0</pose><geometry><box><size>6 39 0.02</size></box></geometry></collision>
        <visual name="gx_lane19_vis"><pose>14 28.5 0.01 0 0 0</pose><geometry><box><size>6 39 0.02</size></box></geometry><material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material></visual>
        <collision name="gx_lane19_curve_col"><pose>50 48 0.01 0 0 0</pose><geometry><box><size>66 6 0.02</size></box></geometry></collision>
        <visual name="gx_lane19_curve_vis"><pose>50 48 0.01 0 0 0</pose><geometry><box><size>66 6 0.02</size></box></geometry><material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material></visual>
        <collision name="gx_lane63_col"><pose>286 30.5 0.01 0 0 0</pose><geometry><box><size>7 43 0.02</size></box></geometry></collision>
        <visual name="gx_lane63_vis"><pose>286 30.5 0.01 0 0 0</pose><geometry><box><size>7 43 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>
        <collision name="gx_epileds_pass_col"><pose>322 20.5 0.01 0 0 0</pose><geometry><box><size>4.5 23 0.02</size></box></geometry></collision>
        <visual name="gx_epileds_pass_vis"><pose>322 20.5 0.01 0 0 0</pose><geometry><box><size>4.5 23 0.02</size></box></geometry><material><ambient>0.28 0.28 0.29 1</ambient><diffuse>0.3 0.3 0.31 1</diffuse></material></visual>

        <!-- ===== 10. 車道標線與指引 (Lane Markings, Crossings, Stop Lines, Turn Lanes) ===== -->
        <!-- 關新路車道分向虛線 (Lane Dividers: Y = -4.5, +4.5) -->
        <visual name="lane_div_r_south"><pose>45 -4.5 0.022 0 0 0</pose><geometry><box><size>60 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="lane_div_r_mid"><pose>211.5 -4.5 0.022 0 0 0</pose><geometry><box><size>225 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="lane_div_r_north"><pose>409 -4.5 0.022 0 0 0</pose><geometry><box><size>115 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="lane_div_l_south"><pose>45 4.5 0.022 0 0 0</pose><geometry><box><size>60 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="lane_div_l_mid"><pose>211.5 4.5 0.022 0 0 0</pose><geometry><box><size>225 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="lane_div_l_north"><pose>409 4.5 0.022 0 0 0</pose><geometry><box><size>115 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 關新東路黃色中央分向雙黃線 (Y = -112.0) -->
        <visual name="gxeast_center_line"><pose>255 -112.0 0.022 0 0 0</pose><geometry><box><size>480 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新一街黃色中央分向線 (X = 86.0) -->
        <visual name="gx1st_east_line"><pose>86.0 -60.5 0.022 0 0 0</pose><geometry><box><size>0.15 95 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新二街黃色中央分向線 (X = 337.0) -->
        <visual name="gx2nd_east_line"><pose>337.0 -60.5 0.022 0 0 0</pose><geometry><box><size>0.15 95 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>

        <!-- 行人穿越斑馬線 (Pedestrian Zebra Crossings) -->
        <!-- 關新一街路口 (X=78, X=94, Y=-11, Y=+11) -->
        <visual name="zebra_gx1_south"><pose>78 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx1_north"><pose>94 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx1_east"><pose>86 -11 0.025 0 0 0</pose><geometry><box><size>10 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx1_west"><pose>86 11 0.025 0 0 0</pose><geometry><box><size>10 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 關新二街路口 (X=328, X=346, Y=-11, Y=+11) -->
        <visual name="zebra_gx2_south"><pose>328 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx2_north"><pose>346 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx2_east"><pose>337 -11 0.025 0 0 0</pose><geometry><box><size>12 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx2_west"><pose>337 11 0.025 0 0 0</pose><geometry><box><size>12 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 關新二街機車停等區 (Motorcycle Waiting Box: Street_photo1 實景) -->
        <visual name="moto_wait_box_gx2"><pose>337 -15.5 0.025 0 0 0</pose><geometry><box><size>5.0 3.5 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="moto_wait_box_inner"><pose>337 -15.5 0.026 0 0 0</pose><geometry><box><size>4.6 3.1 0.002</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="moto_wait_icon"><pose>337 -15.5 0.027 0 0 0</pose><geometry><box><size>1.2 1.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 關新北路路口斑馬線 (X=472, X=490) -->
        <visual name="zebra_gxnorth_south"><pose>472 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gxnorth_north"><pose>490 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 路口與轉彎紅線 (Red Curb Lines - 絕對禁止停車) -->
