        <!-- 2F ~ 12F 現代連續景觀深凹陽台與玻璃欄杆 (Deep Balconies) -->
        <visual name="balconies_front"><pose>122 -14.2 23.0 0 0 0</pose><geometry><box><size>48 0.8 34.0</size></box></geometry><material><ambient>0.2 0.25 0.3 0.9</ambient><diffuse>0.25 0.3 0.35 0.9</diffuse></material></visual>

        <!-- 1F 商鋪立面基座與退縮騎樓雨遮 (Ground Floor Retail Arcade) -->
        <visual name="retail_canopy"><pose>122 -14.0 4.2 0 0 0</pose><geometry><box><size>52 1.8 0.3</size></box></geometry><material><ambient>0.22 0.22 0.24 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>

        <!-- 關新路 6 號：星島海南雞飯新竹關新店 (Singdao Hainan Chicken Rice - X: 96 ~ 112, Y: -14.5) -->
        <visual name="singdao_fascia"><pose>104 -14.4 3.2 0 0 0</pose><geometry><box><size>15.5 0.15 1.4</size></box></geometry><material><ambient>0.92 0.75 0.1 1</ambient><diffuse>0.98 0.82 0.12 1</diffuse><emissive>0.7 0.55 0.1 1</emissive></material></visual>
