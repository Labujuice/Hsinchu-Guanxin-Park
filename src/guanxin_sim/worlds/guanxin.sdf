        <!-- 車站標誌雨遮 / 招牌外觀 -->
        <visual name="station_canopy">
          <pose>402 0 6 0 0 0</pose>
          <geometry>
            <box><size>4 30 0.5</size></box>
          </geometry>
          <material>
