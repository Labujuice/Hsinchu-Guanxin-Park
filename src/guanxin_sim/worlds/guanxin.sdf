    <!-- ==================== 關新公園 / 日光公園 (Guanxin Park - 車行右手邊 Y: -105 ~ -14, X: 212 ~ 342) ==================== -->
    <!-- 尺寸：南北長 130m, 東西寬 91m, 面積約 11,830 m^2 (約 3,500 坪), 完全符合衛星圖與 Google Map 比例 -->
    <model name="guanxin_park">
      <static>true</static>
      <pose>277 -59.5 0.12 0 0 0</pose>
      <link name="park_link">
        <!-- 公園綠地大草坪主體 -->
        <collision name="park_lawn_col"><geometry><box><size>130 91 0.24</size></box></geometry></collision>
        <visual name="park_lawn_vis"><geometry><box><size>130 91 0.24</size></box></geometry><material><ambient>0.18 0.55 0.18 1</ambient><diffuse>0.22 0.62 0.22 1</diffuse></material></visual>

        <!-- 公園四周邊界花台/景觀路緣石 (西、南、北、東) -->
        <collision name="curb_west"><pose>0 45 0.25 0 0 0</pose><geometry><box><size>130 1.0 0.5</size></box></geometry></collision>
        <visual name="curb_west_vis"><pose>0 45 0.25 0 0 0</pose><geometry><box><size>130 1.0 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
        <collision name="curb_south"><pose>-64.5 0 0.25 0 0 0</pose><geometry><box><size>1.0 91 0.5</size></box></geometry></collision>
        <visual name="curb_south_vis"><pose>-64.5 0 0.25 0 0 0</pose><geometry><box><size>1.0 91 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
        <collision name="curb_north"><pose>64.5 0 0.25 0 0 0</pose><geometry><box><size>1.0 91 0.5</size></box></geometry></collision>
        <visual name="curb_north_vis"><pose>64.5 0 0.25 0 0 0</pose><geometry><box><size>1.0 91 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
        <collision name="curb_east"><pose>0 -45 0.25 0 0 0</pose><geometry><box><size>130 1.0 0.5</size></box></geometry></collision>
        <visual name="curb_east_vis"><pose>0 -45 0.25 0 0 0</pose><geometry><box><size>130 1.0 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>

