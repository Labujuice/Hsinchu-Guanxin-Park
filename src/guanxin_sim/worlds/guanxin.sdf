        <visual name="tower_balconies_3"><pose>235 20.8 32 0 0 0</pose><geometry><box><size>24 0.5 28</size></box></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse></material></visual>
        <visual name="tower_crown_3"><pose>235 34 49 0 0 0</pose><geometry><box><size>24 22 2.5</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>

        <!-- 住宅大樓 4 (Tower 4 - 餐廳街上方，高 48m) -->
        <collision name="tower_col_4"><pose>270 34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry></collision>
        <visual name="tower_vis_4"><pose>270 34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry><material><ambient>0.82 0.80 0.77 1</ambient><diffuse>0.85 0.83 0.80 1</diffuse></material></visual>
        <visual name="tower_balconies_4"><pose>270 20.8 32 0 0 0</pose><geometry><box><size>24 0.5 28</size></box></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse></material></visual>
        <visual name="tower_crown_4"><pose>270 34 49 0 0 0</pose><geometry><box><size>24 22 2.5</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>

        <!-- ==================== 左側北段建築群 (公園後至新莊車站 X: 285 ~ 410, Y: 14 ~ 50) ==================== -->
        <collision name="bldg_west_north_col">
          <pose>347.5 32 10 0 0 0</pose>
          <geometry><box><size>125 36 20</size></box></geometry>
        </collision>
        <visual name="bldg_west_north_vis">
          <pose>347.5 32 10 0 0 0</pose>
          <geometry><box><size>125 36 20</size></box></geometry>
          <material><ambient>0.72 0.70 0.68 1</ambient><diffuse>0.75 0.72 0.70 1</diffuse></material>
        </visual>

        <!-- ==================== 右側外圍街廓建築群 (避開關新公園與四周馬路) ==================== -->
        <!-- 1. 關新二街以南街區 (X: 0 ~ 170, Y: -16 ~ -50) -->
        <collision name="bldg_east_south_col">
          <pose>85 -34 10 0 0 0</pose>
          <geometry><box><size>170 34 20</size></box></geometry>
        </collision>
        <visual name="bldg_east_south_vis">
          <pose>85 -34 10 0 0 0</pose>
          <geometry><box><size>170 34 20</size></box></geometry>
          <material><ambient>0.68 0.65 0.60 1</ambient><diffuse>0.72 0.68 0.65 1</diffuse></material>
        </visual>

        <!-- 2. 關新北路以北至新莊車站街區 (東京中城等社區, X: 335 ~ 410, Y: -16 ~ -50) -->
        <collision name="bldg_east_north_col">
          <pose>372.5 -34 10 0 0 0</pose>
          <geometry><box><size>75 34 20</size></box></geometry>
        </collision>
        <visual name="bldg_east_north_vis">
          <pose>372.5 -34 10 0 0 0</pose>
          <geometry><box><size>75 34 20</size></box></geometry>
          <material><ambient>0.68 0.65 0.60 1</ambient><diffuse>0.72 0.68 0.65 1</diffuse></material>
        </visual>

        <!-- 3. 關新東路以東之「公園第一排」景觀大樓群 (豐邑一第等社區, X: 175 ~ 325, Y: -135) -->
        <collision name="bldg_east_park_first_row_col">
          <pose>251 -135 15 0 0 0</pose>
          <geometry><box><size>145 30 30</size></box></geometry>
        </collision>
        <visual name="bldg_east_park_first_row_vis">
          <pose>251 -135 15 0 0 0</pose>
          <geometry><box><size>145 30 30</size></box></geometry>
          <material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.78 0.75 0.72 1</diffuse></material>
        </visual>

        <!-- 光復路口邊界擋牆 -->
        <collision name="south_boundary_wall">
          <pose>-6 0 5 0 0 0</pose>
          <geometry><box><size>4 50 10</size></box></geometry>
        </collision>
        <visual name="south_boundary_vis">
          <pose>-6 0 5 0 0 0</pose>
          <geometry><box><size>4 50 10</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>

        <!-- ==================== 新莊火車站 (Xinzhuang Station) ==================== -->
        <collision name="xinzhuang_station_col">
          <pose>408 0 8 0 0 0</pose>
          <geometry><box><size>10 70 16</size></box></geometry>
        </collision>
        <visual name="xinzhuang_station_vis">
          <pose>408 0 8 0 0 0</pose>
          <geometry><box><size>10 70 16</size></box></geometry>
          <material><ambient>0.28 0.35 0.45 1</ambient><diffuse>0.32 0.40 0.52 1</diffuse></material>
        </visual>
        <visual name="station_canopy">
          <pose>402 0 6 0 0 0</pose>
          <geometry><box><size>4 30 0.5</size></box></geometry>
          <material><ambient>0.15 0.2 0.3 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 載入 Tesla Model Y 載具 ==================== -->
    <include>
      <name>model_y</name>
      <uri>model://model_y</uri>
      <!-- 起始位置換邊至右側通行車道 (Y = -5.0)，車頭朝向新莊車站 (+X 方向) -->
      <pose>5 -5.0 0.38 0 0 0</pose>
    </include>

  </world>
</sdf>
