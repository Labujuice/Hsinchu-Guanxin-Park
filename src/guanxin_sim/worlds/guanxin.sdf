        <!-- 2. 對角林蔭漫步道 (Diagonal Walkways linking SW, NW, NE, SE corners - Street_photo & satellite 實景) -->
        <!-- 對角步道1 (西南廣場至東北角) -->
        <visual name="park_diag1_vis"><pose>277 -59.5 0.125 0 0 0.55</pose><geometry><box><size>140 3.0 0.01</size></box></geometry><material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.80 0.77 0.72 1</diffuse></material></visual>
        <!-- 對角步道2 (西北角至東南角) -->
        <visual name="park_diag2_vis"><pose>277 -59.5 0.125 0 0 -0.55</pose><geometry><box><size>140 3.0 0.01</size></box></geometry><material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.80 0.77 0.72 1</diffuse></material></visual>

        <!-- 3. 中央核心向陽大草坪 (Central Main Lawn - 綠油油草皮質感, 高 0.14m) -->
        <collision name="park_lawn_col"><pose>277 -59.5 0.07 0 0 0</pose><geometry><box><size>120 81 0.14</size></box></geometry></collision>
        <visual name="park_lawn_vis"><pose>277 -59.5 0.13 0 0 0</pose><geometry><box><size>120 81 0.02</size></box></geometry><material><ambient>0.22 0.55 0.22 1</ambient><diffuse>0.28 0.62 0.28 1</diffuse></material></visual>

        <!-- 4. 林下深綠蔭涼草坪區 (Shaded Lawn Section - 色調偏深綠層次) -->
        <visual name="park_shaded_lawn_vis"><pose>245 -75 0.135 0 0 0</pose><geometry><box><size>45 40 0.01</size></box></geometry><material><ambient>0.16 0.42 0.16 1</ambient><diffuse>0.20 0.48 0.20 1</diffuse></material></visual>

