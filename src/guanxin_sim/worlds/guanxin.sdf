    <!-- ==================== 關新公園 / 日光公園 (Guanxin Park - 車行右手邊 Y: -105 ~ -14, X: 212 ~ 342) ==================== -->
    <!-- 面積約 3,500 坪 (130m x 91m)，採分區材質：外圍透水磚步道、對角漫步道、多層次草坪、兒童細沙坑、防護地墊與灌木綠籬 -->
    <model name="guanxin_park">
      <static>true</static>
      <link name="park_link">
        <!-- 1. 外圍環狀紅磚/透水磚漫步道 (Perimeter Brick Walkway - 寬 3.5m, 高 0.12m) -->
        <collision name="park_walkway_col"><pose>277 -59.5 0.06 0 0 0</pose><geometry><box><size>130 91 0.12</size></box></geometry></collision>
