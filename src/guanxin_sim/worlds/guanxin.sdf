        <collision name="station_col"><geometry><box><size>14 50 15</size></box></geometry></collision>
        <visual name="station_vis"><geometry><box><size>14 50 15</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.32 0.38 0.45 1</diffuse></material></visual>
        <visual name="station_glass"><pose>-7.1 0 0 0 0 0</pose><geometry><box><size>0.2 46 11</size></box></geometry><material><ambient>0.2 0.4 0.6 0.8</ambient><diffuse>0.3 0.5 0.7 0.8</diffuse><emissive>0.2 0.35 0.5 1</emissive></material></visual>
        <visual name="station_sign"><pose>-7.2 0 6.2 0 0 0</pose><geometry><box><size>0.3 14 1.8</size></box></geometry><material><ambient>0.05 0.25 0.6 1</ambient><diffuse>0.1 0.35 0.75 1</diffuse><emissive>0.2 0.5 0.9 1</emissive></material></visual>
        <!-- 死胡同實體擋牆 (阻止車輛衝出地圖) -->
        <collision name="dead_end_col"><pose>-8 0 -5 0 0 0</pose><geometry><box><size>2 40 5</size></box></geometry></collision>
        <visual name="dead_end_barrier"><pose>-8 0 -6.5 0 0 0</pose><geometry><box><size>1.5 36 1.2</size></box></geometry><material><ambient>0.85 0.75 0.1 1</ambient><diffuse>0.9 0.8 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ==================== 載入 Tesla Model Y 載具 ==================== -->
    <include>
      <name>model_y</name>
      <uri>model://model_y</uri>
      <!-- 起始位置位於右側通行車道 (Y = -5.0)，車頭朝向新莊車站 (+X 方向) -->
      <pose>5 -5.0 0.38 0 0 0</pose>
    </include>

  </world>
</sdf>
