<!-- ==================== 寶雅與關新一街之間中介建築群 (Intermediary Building Block: X: 94 ~ 150) ==================== -->
    <!-- 解除使用者質疑：寶雅旁邊絕非巷子，隔著整棟12層高現代住商大樓「十詠八方」，1F包含星島海南雞飯(關新路6號)及精品商鋪 -->
    <model name="block_gx1_to_poya">
      <static>true</static>
      <link name="bldg_link">
        <!-- 12層樓住商混合高層主體 (X: 96 ~ 148, Y: -45 ~ -14.5, 高 42m) -->
        <collision name="tower_col"><pose>122 -29.75 21.0 0 0 0</pose><geometry><box><size>52 30.5 42.0</size></box></geometry></collision>
        <visual name="tower_main_vis"><pose>122 -29.75 21.0 0 0 0</pose><geometry><box><size>52 30.5 42.0</size></box></geometry><material><ambient>0.76 0.74 0.70 1</ambient><diffuse>0.82 0.80 0.76 1</diffuse></material></visual>

        <!-- 建築屋頂造型冠頂框架 (Architectural Crown Pergola) -->
