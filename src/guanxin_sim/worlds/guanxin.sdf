        <!-- ===== 8. 關東路主幹道 (Guandong Road: 位於 s = 588.0m, 與關新路精確 90 度垂直交叉, 方位角 CROSS_YAW, 東西貫通長 300m, 寬 14m) ===== -->
        <collision name="guandong_road_col"><pose>151.068 568.614 0.01 0 0 -0.22568</pose><geometry><box><size>300.0 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
