        <!-- ===== 核心設施 2：地景磨石子大溜滑梯 (Landscape Mound & Stone Slide) ===== -->
        <!-- 綠化遊戲土丘 (高 2.4m, 直徑 12m) -->
        <collision name="slide_mound_col"><pose>-25 10 1.2 0 0 0</pose><geometry><cylinder><radius>5.5</radius><length>2.4</length></cylinder></geometry></collision>
