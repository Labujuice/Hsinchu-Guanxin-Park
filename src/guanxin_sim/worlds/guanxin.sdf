<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="guanxin_world">
    <!-- ==================== 物理引擎設定 (ODE 物理引擎，高頻步長 0.002s / 500Hz) ==================== -->
    <physics name="default_physics" type="ode" default="true">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- ==================== WGS84 地理基準原點 (Geospatial Datum) ==================== -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>24.7818444</latitude_deg>
      <longitude_deg>121.0209750</longitude_deg>
      <elevation>35.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- ==================== Gazebo Harmonic 核心系統外掛 ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ==================== 環境光照與太陽光源 ==================== -->
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.72 0.82 0.92 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>150 -60 200 0.6 0.4 -0.8</pose>
      <diffuse>0.92 0.90 0.86 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

        <!-- ==================== 地面大底 (Ground Plane 1400m x 1400m 覆蓋全域 58 公頃) ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <pose>-100 480 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry><plane><normal>0 0 1</normal><size>1400 1400</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kd>100000</kd><kp>10000000</kp></ode></contact>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry><plane><normal>0 0 1</normal><size>1400 1400</size></plane></geometry>
          <material><ambient>0.42 0.44 0.42 1</ambient><diffuse>0.48 0.50 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

                <!-- ==================== Phase 2: 全域路網精確鋪設與路邊智慧停車柱系統 ==================== -->
    <!-- 涵蓋 58 公頃: 關新路(18m)、真實多段彎道關新東路(14m)、光復路(24m)、關新一街(12m)、關新二街(14m)、關新北路(14m)、社區聯絡道 -->
    <model name="road_network">
      <static>true</static>
      <link name="road_link">
        <!-- 1a. 關新路主幹道直道段柏油路面 (長 488.0m, 寬 18m, 雙向四線道, 方位角 12.93°) -->
        <collision name="gx_road_str_col"><pose>54.599 237.813 0.01 0 0 1.34512</pose><geometry><box><size>488.0 18.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_road_str_vis"><pose>54.599 237.813 0.01 0 0 1.34512</pose><geometry><box><size>488.0 18.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- 1b. 關新路北側向東轉彎彎道 (依真實GIS與地圖曲線鋪設, 連通新莊車站前與關東路) -->
        <!-- 關新路彎道: 關新路北彎道段1: 日光公園北端起始微彎 (長 55.7m, 寬 18m) -->
        <collision name="gx_curve1_col"><pose>124.763 498.729 0.01 0 0 0.97794</pose><geometry><box><size>55.71 18.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_curve1_vis"><pose>124.763 498.729 0.01 0 0 0.97794</pose><geometry><box><size>55.71 18.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gx_curve1_line"><pose>124.763 498.729 0.022 0 0 0.97794</pose><geometry><box><size>55.71 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新路彎道: 關新路北彎道段2: 日光公園東北轉折段 (長 75.0m, 寬 18m) -->
        <collision name="gx_curve2_col"><pose>168.970 546.036 0.01 0 0 0.70162</pose><geometry><box><size>75.00 18.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_curve2_vis"><pose>168.970 546.036 0.01 0 0 0.70162</pose><geometry><box><size>75.00 18.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gx_curve2_line"><pose>168.970 546.036 0.022 0 0 0.70162</pose><geometry><box><size>75.00 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新路彎道: 關新路北彎道段3: 朝新莊車站方向偏東 (長 82.0m, 寬 18m) -->
        <collision name="gx_curve3_col"><pose>234.883 587.334 0.01 0 0 0.43002</pose><geometry><box><size>82.01 18.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_curve3_vis"><pose>234.883 587.334 0.01 0 0 0.43002</pose><geometry><box><size>82.01 18.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gx_curve3_line"><pose>234.883 587.334 0.022 0 0 0.43002</pose><geometry><box><size>82.01 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新路彎道: 關新路北彎道段4: 新莊車站迎賓廣場前直通段 (長 69.5m, 寬 18m) -->
        <collision name="gx_curve4_col"><pose>305.308 614.771 0.01 0 0 0.30240</pose><geometry><box><size>69.46 18.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_curve4_vis"><pose>305.308 614.771 0.01 0 0 0.30240</pose><geometry><box><size>69.46 18.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gx_curve4_line"><pose>305.308 614.771 0.022 0 0 0.30240</pose><geometry><box><size>69.46 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新路彎道: 關新路北彎道段5: 車站前延伸通過鐵路高架下方銜接關東路 (長 68.0m, 寬 18m) -->
        <collision name="gx_curve5_col"><pose>369.741 638.453 0.01 0 0 0.40312</pose><geometry><box><size>68.01 18.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_curve5_vis"><pose>369.741 638.453 0.01 0 0 0.40312</pose><geometry><box><size>68.01 18.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gx_curve5_line"><pose>369.741 638.453 0.022 0 0 0.40312</pose><geometry><box><size>68.01 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>

        <!-- ===== 2. 正確的關新東路多段彎道主幹道 (Guanxin East Road: 依真實GIS與OSM曲線鋪設) ===== -->
        <!-- 關新東路: 南段: 光復路至關新一街, 順正北走向 (長 95.0m, 寬 14m) -->
        <collision name="gxe_seg1_south_col"><pose>163.693 7.563 0.01 0 0 1.73051</pose><geometry><box><size>94.97 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxe_seg1_south_vis"><pose>163.693 7.563 0.01 0 0 1.73051</pose><geometry><box><size>94.97 14.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gxe_seg1_south_line"><pose>163.693 7.563 0.022 0 0 1.73051</pose><geometry><box><size>94.97 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新東路: 中南段: 關埔國小西側, 關新一街至關新二街 (長 257.4m, 寬 14m) -->
        <collision name="gxe_seg2_school_col"><pose>174.119 181.900 0.01 0 0 1.43068</pose><geometry><box><size>257.44 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxe_seg2_school_vis"><pose>174.119 181.900 0.01 0 0 1.43068</pose><geometry><box><size>257.44 14.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gxe_seg2_school_line"><pose>174.119 181.900 0.022 0 0 1.43068</pose><geometry><box><size>257.44 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新東路: 中北段: 日光公園東側直道, 關新二街至關新北路, 寬14m (長 143.5m, 寬 14m) -->
        <collision name="gxe_seg3_park_col"><pose>208.151 379.290 0.01 0 0 1.34512</pose><geometry><box><size>143.50 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxe_seg3_park_vis"><pose>208.151 379.290 0.01 0 0 1.34512</pose><geometry><box><size>143.50 14.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gxe_seg3_park_line"><pose>208.151 379.290 0.022 0 0 1.34512</pose><geometry><box><size>143.50 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新東路: 北段彎道1: 日光公園東北轉角微彎 (長 95.9m, 寬 14m) -->
        <collision name="gxe_seg4a_north_col"><pose>247.658 491.034 0.01 0 0 1.05965</pose><geometry><box><size>95.88 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxe_seg4a_north_vis"><pose>247.658 491.034 0.01 0 0 1.05965</pose><geometry><box><size>95.88 14.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gxe_seg4a_north_line"><pose>247.658 491.034 0.022 0 0 1.05965</pose><geometry><box><size>95.88 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新東路: 北段彎道2: 新莊車站東側聯絡段 (長 109.7m, 寬 14m) -->
        <collision name="gxe_seg4b_north_col"><pose>304.226 576.544 0.01 0 0 0.92226</pose><geometry><box><size>109.66 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxe_seg4b_north_vis"><pose>304.226 576.544 0.01 0 0 0.92226</pose><geometry><box><size>109.66 14.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gxe_seg4b_north_line"><pose>304.226 576.544 0.022 0 0 0.92226</pose><geometry><box><size>109.66 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新東路: 北段彎道3: 往東北接埔頂路口 (長 116.6m, 寬 14m) -->
        <collision name="gxe_seg4c_north_col"><pose>377.772 662.260 0.01 0 0 0.80470</pose><geometry><box><size>116.62 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxe_seg4c_north_vis"><pose>377.772 662.260 0.01 0 0 0.80470</pose><geometry><box><size>116.62 14.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gxe_seg4c_north_line"><pose>377.772 662.260 0.022 0 0 0.80470</pose><geometry><box><size>116.62 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>

        <!-- 3. 光復路一段主幹道 (南界門戶橫向幹道, 長 450m, 寬 24m, 雙向六線道, 角度精準對齊北歐三小國南棟與關新一街) -->
        <collision name="guangfu_road_col"><pose>24.366 -5.594 0.01 0 0 -0.22568</pose><geometry><box><size>450.0 24.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="guangfu_road_vis"><pose>24.366 -5.594 0.01 0 0 -0.22568</pose><geometry><box><size>450.0 24.0 0.02</size></box></geometry><material><ambient>0.20 0.20 0.21 1</ambient><diffuse>0.22 0.22 0.23 1</diffuse></material></visual>

        <!-- 4. 關新一街東段 (自關新路連通至關新東路, 長 131m, 寬 12m) -->
        <collision name="gx1_east_col"><pose>92.302 69.098 0.01 0 0 -0.22568</pose><geometry><box><size>131.0 12.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx1_east_vis"><pose>92.302 69.098 0.01 0 0 -0.22568</pose><geometry><box><size>131.0 12.0 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>
        <!-- 關新一街西段 (自關新路延伸至北歐三小國社區南側開放道路, 長 60m, 寬 12m) -->
        <collision name="gx1_west_col"><pose>-19.294 94.719 0.01 0 0 -0.22568</pose><geometry><box><size>60.0 12.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx1_west_vis"><pose>-19.294 94.719 0.01 0 0 -0.22568</pose><geometry><box><size>60.0 12.0 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>

        <!-- 5. 關新二街東段 (自星巴克路口連通至關新東路/日光公園東南角, 長 109m, 寬 14m) -->
        <collision name="gx2_east_col"><pose>138.978 321.555 0.01 0 0 -0.22568</pose><geometry><box><size>109.0 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
