            <diffuse>0.2 0.25 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 載入 Tesla Model Y 載具 ==================== -->
    <include>
      <name>model_y</name>
      <uri>model://model_y</uri>
      <!-- 起始位置位於光復路與關新路口中央，車頭朝向新莊車站 (+X 方向) -->
      <pose>5 0 0.38 0 0 0</pose>
    </include>

  </world>
</sdf>
