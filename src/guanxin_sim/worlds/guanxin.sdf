<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="guanxin_world">
    <!-- ==================== 物理引擎設定 (ODE 物理引擎，高頻步長 0.002s / 500Hz) ==================== -->
    <physics name="default_physics" type="ode" default="true">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- ==================== Gazebo Harmonic 核心系統外掛 ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ==================== 環境光照與太陽光源 ==================== -->
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.72 0.82 0.92 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>100 -50 200 0.6 0.4 -0.8</pose>
      <diffuse>0.92 0.90 0.86 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- ==================== 地面大底 (Ground Plane) ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kd>100000</kd><kp>10000000</kp></ode></contact>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <material><ambient>0.42 0.44 0.42 1</ambient><diffuse>0.48 0.50 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 關新路道路、巷弄與人行道系統 (Roadway, Lanes, Alleys, Median, Sidewalks, Markings) ==================== -->
    <!-- 依據 docs/ref_map_material/mission_09110609.png 範圍全數重建所有可以看到的幹道與巷弄 -->
    <model name="road_network">
      <static>true</static>
      <link name="road_link">
        <!-- 1. 關新路主幹道柏油路面 (X: 0 ~ 410, Y: -9 ~ +9, 寬 18m, 雙向四線道) -->
        <collision name="guanxin_asphalt_col">
          <pose>205 0 0.01 0 0 0</pose>
          <geometry><box><size>410 18 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="guanxin_asphalt_vis">
          <pose>205 0 0.01 0 0 0</pose>
          <geometry><box><size>410 18 0.02</size></box></geometry>
          <material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material>
        </visual>

        <!-- ===== 中央綠化分隔島 (Green Median Strip with Curb) ===== -->
        <!-- 南段1分隔島 (光復路口至關新一街口 X: 10 ~ 18, Y: -0.9 ~ +0.9) -->
        <collision name="median_s1_col"><pose>14 0 0.10 0 0 0</pose><geometry><box><size>8 1.8 0.20</size></box></geometry></collision>
        <visual name="median_s1_curb"><pose>14 0 0.10 0 0 0</pose><geometry><box><size>8 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_s1_lawn"><pose>14 0 0.205 0 0 0</pose><geometry><box><size>6 1.4 0.01</size></box></geometry><material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <visual name="median_s1_tip_s"><pose>10.2 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="median_s1_tip_n"><pose>17.8 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>

        <!-- 南段2分隔島 (關新一街口至關新二街口 X: 30 ~ 195, Y: -0.9 ~ +0.9, 長 165m) -->
        <collision name="median_south_col"><pose>112.5 0 0.10 0 0 0</pose><geometry><box><size>165 1.8 0.20</size></box></geometry></collision>
        <visual name="median_south_curb"><pose>112.5 0 0.10 0 0 0</pose><geometry><box><size>165 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_south_lawn"><pose>112.5 0 0.205 0 0 0</pose><geometry><box><size>163 1.4 0.01</size></box></geometry><material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <visual name="median_south_tip_vis"><pose>30.2 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="median_s_north_tip_vis"><pose>194.8 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <!-- 藍底白色箭頭指示牌桿 (關新二街路口 Street_photo3 & 5 實景) -->
        <visual name="median_s_sign_pole"><pose>194 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="median_s_sign_board"><pose>194 0 2.2 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>0.04</length></cylinder></geometry><material><ambient>0.0 0.3 0.8 1</ambient><diffuse>0.0 0.4 0.9 1</diffuse><emissive>0.0 0.2 0.5 1</emissive></material></visual>

        <!-- 北段分隔島 (關新二街口至關新北路口 X: 216 ~ 340, Y: -0.9 ~ +0.9, 長 124m) -->
        <collision name="median_north_col"><pose>278 0 0.10 0 0 0</pose><geometry><box><size>124 1.8 0.20</size></box></geometry></collision>
        <visual name="median_north_curb"><pose>278 0 0.10 0 0 0</pose><geometry><box><size>124 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_north_lawn"><pose>278 0 0.205 0 0 0</pose><geometry><box><size>122 1.4 0.01</size></box></geometry><material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <visual name="median_n_south_tip_vis"><pose>216.2 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="median_n_north_tip_vis"><pose>339.8 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>

        <!-- ===== 2. 關新一街 (Guanxin 1st St. - X: 19 ~ 29, 路寬 10m) ===== -->
        <!-- 東段：自關新路延伸至關新東路 (Y: -112 ~ -9, 長 103m) -->
        <collision name="gx1st_east_col"><pose>24 -60.5 0.01 0 0 0</pose><geometry><box><size>10 103 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx1st_east_vis"><pose>24 -60.5 0.01 0 0 0</pose><geometry><box><size>10 103 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <!-- 西段：自關新路延伸至西側社區 (Y: 9 ~ 55, 長 46m) -->
        <collision name="gx1st_west_col"><pose>24 32 0.01 0 0 0</pose><geometry><box><size>10 46 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx1st_west_vis"><pose>24 32 0.01 0 0 0</pose><geometry><box><size>10 46 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 3. 關新二街 (Guanxin 2nd St. - X: 197 ~ 211, 路寬 14m) ===== -->
        <collision name="gx2nd_east_col"><pose>204 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx2nd_east_vis"><pose>204 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <collision name="gx2nd_west_col"><pose>204 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry></collision>
        <visual name="gx2nd_west_vis"><pose>204 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 4. 關新北路 (Guanxin North Rd. - X: 344 ~ 358, 路寬 14m) ===== -->
        <collision name="gxnorth_east_col"><pose>351 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry></collision>
        <visual name="gxnorth_east_vis"><pose>351 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <collision name="gxnorth_west_col"><pose>351 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry></collision>
        <visual name="gxnorth_west_vis"><pose>351 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 5. 關新東路全線貫通 (Guanxin East Rd. - Y: -119 ~ -105, 寬 14m, 全長 X: 10 ~ 390) ===== -->
        <collision name="gxeast_col"><pose>200 -112 0.01 0 0 0</pose><geometry><box><size>380 14 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxeast_vis"><pose>200 -112 0.01 0 0 0</pose><geometry><box><size>380 14 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 6. 商圈後方南北向服務巷弄 (Mid-Block North-South Service Alley) ===== -->
        <!-- 位於麥當勞得來速/充電停車場後方 (Y: -66 ~ -60, 寬 6m, 長度 X: 29 ~ 197 貫穿關新一街至關新二街) -->
        <collision name="gx_midblock_alley_col"><pose>113 -63 0.01 0 0 0</pose><geometry><box><size>168 6 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_midblock_alley_vis"><pose>113 -63 0.01 0 0 0</pose><geometry><box><size>168 6 0.02</size></box></geometry><material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material></visual>

        <!-- ===== 7. 住宅街區橫向社區聯絡弄 (East-West Community Connecting Alleys) ===== -->
        <!-- 中段聯絡弄 (連接中街巷弄與關新東路 X: 107.25 ~ 112.75, 寬 5.5m, Y: -105 ~ -66) -->
        <collision name="gx_midblock_east_alley_col"><pose>110 -85.5 0.01 0 0 0</pose><geometry><box><size>5.5 39 0.02</size></box></geometry></collision>
        <visual name="gx_midblock_east_alley_vis"><pose>110 -85.5 0.01 0 0 0</pose><geometry><box><size>5.5 39 0.02</size></box></geometry><material><ambient>0.25 0.25 0.26 1</ambient><diffuse>0.27 0.27 0.28 1</diffuse></material></visual>

        <!-- 南段社區弄 (X: 52.5 ~ 57.5, 寬 5.0m, Y: -105 ~ -66) -->
        <collision name="gx_south_east_alley_col"><pose>55 -85.5 0.01 0 0 0</pose><geometry><box><size>5.0 39 0.02</size></box></geometry></collision>
        <visual name="gx_south_east_alley_vis"><pose>55 -85.5 0.01 0 0 0</pose><geometry><box><size>5.0 39 0.02</size></box></geometry><material><ambient>0.25 0.25 0.26 1</ambient><diffuse>0.27 0.27 0.28 1</diffuse></material></visual>

        <!-- ===== 8. 東南向巷弄：光復路一段268巷41弄 (Guangfu Rd. Sec. 1 Ln. 268 Aly. 41) ===== -->
        <!-- 自關新東路/關新一街口往東延伸 (X: 21 ~ 27, 寬 6m, Y: -145 ~ -119) -->
        <collision name="guangfu_268_41_col"><pose>24 -132 0.01 0 0 0</pose><geometry><box><size>6 26 0.02</size></box></geometry></collision>
        <visual name="guangfu_268_41_vis"><pose>24 -132 0.01 0 0 0</pose><geometry><box><size>6 26 0.02</size></box></geometry><material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material></visual>

        <!-- ===== 9. 關新路西側巷弄系統 (West Side Lanes & Alleys) ===== -->
        <!-- A. 關新路19巷 (Guanxin Rd. Lane 19 - X: 11 ~ 17, 寬 6m, Y: 9 ~ 48) -->
        <collision name="gx_lane19_col"><pose>14 28.5 0.01 0 0 0</pose><geometry><box><size>6 39 0.02</size></box></geometry></collision>
        <visual name="gx_lane19_vis"><pose>14 28.5 0.01 0 0 0</pose><geometry><box><size>6 39 0.02</size></box></geometry><material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material></visual>
        <!-- 19巷向北繞行連通至關新一街西段 (X: 17 ~ 24, Y: 45 ~ 51) -->
        <collision name="gx_lane19_curve_col"><pose>20.5 48 0.01 0 0 0</pose><geometry><box><size>7 6 0.02</size></box></geometry></collision>
        <visual name="gx_lane19_curve_vis"><pose>20.5 48 0.01 0 0 0</pose><geometry><box><size>7 6 0.02</size></box></geometry><material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material></visual>

        <!-- B. 新莊街166巷 / 關新路63巷 (荒節小料理/美食商圈西向巷弄 X: 282.5 ~ 289.5, 寬 7m, Y: 9 ~ 52) -->
        <collision name="gx_lane63_col"><pose>286 30.5 0.01 0 0 0</pose><geometry><box><size>7 43 0.02</size></box></geometry></collision>
        <visual name="gx_lane63_vis"><pose>286 30.5 0.01 0 0 0</pose><geometry><box><size>7 43 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>

        <!-- C. 極智光電建築棟距穿堂服務通道 (X: 319.75 ~ 324.25, 寬 4.5m, Y: 9 ~ 32) -->
        <collision name="gx_epileds_pass_col"><pose>322 20.5 0.01 0 0 0</pose><geometry><box><size>4.5 23 0.02</size></box></geometry></collision>
        <visual name="gx_epileds_pass_vis"><pose>322 20.5 0.01 0 0 0</pose><geometry><box><size>4.5 23 0.02</size></box></geometry><material><ambient>0.28 0.28 0.29 1</ambient><diffuse>0.3 0.3 0.31 1</diffuse></material></visual>

        <!-- ===== 台灣標準道路標線 (Road Decals & Markings) ===== -->
        <!-- 車道分向線 (White Lane Dividers) -->
        <!-- 關新路 (Y = -5.0 & Y = +5.0) -->
        <visual name="lane_div_r_south"><pose>112.5 -5.0 0.022 0 0 0</pose><geometry><box><size>160 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="lane_div_r_north"><pose>278 -5.0 0.022 0 0 0</pose><geometry><box><size>120 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="lane_div_l_south"><pose>112.5 5.0 0.022 0 0 0</pose><geometry><box><size>160 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="lane_div_l_north"><pose>278 5.0 0.022 0 0 0</pose><geometry><box><size>120 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 關新東路黃色中央分向線 (Y = -112.0) -->
        <visual name="gxeast_center_line"><pose>200 -112.0 0.022 0 0 0</pose><geometry><box><size>370 0.15 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關新一街中央分向線 (X = 24.0) -->
        <visual name="gx1st_east_line"><pose>24.0 -60.5 0.022 0 0 0</pose><geometry><box><size>0.15 95 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>

        <!-- 行人穿越斑馬線 (Zebra Crossings) -->
        <!-- 1. 關新二街口 (X: 196, 212 & Y: -11, +11) -->
        <visual name="zebra_gx2_south"><pose>196 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx2_north"><pose>212 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx2_east"><pose>204 -11 0.025 0 0 0</pose><geometry><box><size>12 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx2_west"><pose>204 11 0.025 0 0 0</pose><geometry><box><size>12 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 2. 關新一街口 (X: 18, 30 & Y: -11, +11) -->
        <visual name="zebra_gx1_south"><pose>18 0 0.025 0 0 0</pose><geometry><box><size>2.8 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx1_north"><pose>30 0 0.025 0 0 0</pose><geometry><box><size>2.8 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx1_east"><pose>24 -11 0.025 0 0 0</pose><geometry><box><size>8 2.6 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="zebra_gx1_west"><pose>24 11 0.025 0 0 0</pose><geometry><box><size>8 2.6 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 3. 關新北路口 (X: 343) -->
        <visual name="zebra_gxnorth_south"><pose>343 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 4. 關新東路 / 關新一街口斑馬線 (麵屋吉光門前) -->
        <visual name="zebra_gxeast_gx1"><pose>24 -112 0.025 0 0 0</pose><geometry><box><size>8 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 5. 荒節小料理 / 新莊街166巷口斑馬線 (X: 286, Y: 10.5) -->
        <visual name="zebra_lane63"><pose>286 10.5 0.025 0 0 0</pose><geometry><box><size>6 2.5 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

