        <!-- 關新路63巷與新莊街聯絡弄 (長 94m, 寬 7.0m) -->
        <collision name="w_alley2_col"><pose>-50.498 316.321 0.01 0 0 1.34512</pose><geometry><box><size>94.0 7.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
