        <!-- 東側北段建築群 (公園後至新莊車站 X: 265 ~ 400) -->
        <collision name="bldg_east_north_col">
          <pose>332.5 32 10 0 0 0</pose>
          <geometry>
            <box><size>135 36 20</size></box>
