        <visual name="cafe_umbrella_1"><pose>194 -14.2 2.2 0 0 0</pose><geometry><cone><radius>1.2</radius><length>0.6</length></cone></geometry><material><ambient>0.0 0.35 0.18 1</ambient><diffuse>0.0 0.4 0.2 1</diffuse></material></visual>

        <visual name="cafe_table_2"><pose>206 -14.2 0.75 0 0 0</pose><geometry><cylinder><radius>0.5</radius><length>0.05</length></cylinder></geometry><material><ambient>0.2 0.15 0.1 1</ambient><diffuse>0.2 0.15 0.1 1</diffuse></material></visual>
        <visual name="cafe_umbrella_2"><pose>206 -14.2 2.2 0 0 0</pose><geometry><cone><radius>1.2</radius><length>0.6</length></cone></geometry><material><ambient>0.0 0.35 0.18 1</ambient><diffuse>0.0 0.4 0.2 1</diffuse></material></visual>

        <!-- ==================== 【知名店面 4：洋朵義式 / 樂子 The Diner 餐廳街】(X: 215 ~ 260) ==================== -->
        <!-- 木質格柵現代餐廳門面 -->
        <visual name="diner_glass_wall">
          <pose>237 -18 3.2 0 0 0</pose>
          <geometry><box><size>42 0.2 6.0</size></box></geometry>
