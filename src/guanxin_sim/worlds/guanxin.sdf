    <!-- 4. 標誌性地景：磨石子大溜滑梯 (Terrazzo Giant Slide - 依實測座標錨定於日光公園遊戲區) -->
    <include>
      <name>terrazzo_slide</name>
      <uri>model://terrazzo_slide</uri>
      <pose>120.089 388.992 0.10 0 0 2.91591</pose>
    </include>

    <!-- ==================== 載入 Tesla Model Y 載具 (自駕與鍵盤操控車輛) ==================== -->
