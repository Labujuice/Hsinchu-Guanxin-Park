<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="guanxin_world">
    <!-- ==================== 物理引擎設定 ==================== -->
    <physics name="ode_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ==================== Gazebo 系統外掛 ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== 天空與日照光影 ==================== -->
    <scene>
      <ambient>0.6 0.65 0.7 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>100 -50 150 0 0 0</pose>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.8</direction>
    </light>

    <!-- ==================== 關新路主幹道與人行道路網 ==================== -->
    <model name="guanxin_road_network">
      <static>true</static>
      <link name="road_link">
        <!-- 關新路主幹道瀝青路面 (長 410m, 寬 20m, 摩擦係數 mu=0.9) -->
        <collision name="road_collision">
          <pose>200 0 0.025 0 0 0</pose>
          <geometry>
            <box><size>410 20 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="road_visual">
          <pose>200 0 0.025 0 0 0</pose>
          <geometry>
            <box><size>410 20 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- 中央分向雙黃線 (Yellow Center Line) -->
        <visual name="center_line_visual">
          <pose>200 0 0.052 0 0 0</pose>
          <geometry>
            <box><size>400 0.3 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.75 0.1 1</ambient>
            <diffuse>0.9 0.75 0.1 1</diffuse>
          </material>
        </visual>

        <!-- 西側快慢車道白虛線 -->
        <visual name="lane_divider_west">
          <pose>200 -5 0.052 0 0 0</pose>
          <geometry>
            <box><size>400 0.15 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>

        <!-- 東側快慢車道白虛線 -->
        <visual name="lane_divider_east">
          <pose>200 5 0.052 0 0 0</pose>
          <geometry>
            <box><size>400 0.15 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>

        <!-- 光復路口斑馬線 -->
        <visual name="crosswalk_guangfu">
          <pose>10 0 0.052 0 0 0</pose>
          <geometry>
            <box><size>4 18 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>

        <!-- 西側人行道 (Sidewalk West - 高出路面 15cm，剛體碰撞路緣石) -->
        <collision name="sidewalk_w_col">
          <pose>200 -12 0.10 0 0 0</pose>
          <geometry>
            <box><size>410 4 0.20</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="sidewalk_w_vis">
          <pose>200 -12 0.10 0 0 0</pose>
          <geometry>
            <box><size>410 4 0.20</size></box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>

        <!-- 東側人行道 (Sidewalk East - 靠近關新公園側，高出路面 15cm) -->
        <collision name="sidewalk_e_col">
          <pose>200 12 0.10 0 0 0</pose>
          <geometry>
            <box><size>410 4 0.20</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="sidewalk_e_vis">
          <pose>200 12 0.10 0 0 0</pose>
          <geometry>
            <box><size>410 4 0.20</size></box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 關新公園 (Guanxin Park) ==================== -->
    <model name="guanxin_park">
      <static>true</static>
      <!-- 公園位於 X: 120m ~ 260m, Y: 14m ~ 64m (長 140m, 寬 50m) -->
      <pose>190 39 0.12 0 0 0</pose>
      <link name="park_link">
        <!-- 綠地草坪碰撞剛體與草地外觀 -->
        <collision name="park_lawn_col">
          <geometry>
            <box><size>140 50 0.24</size></box>
          </geometry>
        </collision>
        <visual name="park_lawn_vis">
          <geometry>
            <box><size>140 50 0.24</size></box>
          </geometry>
          <material>
            <ambient>0.18 0.48 0.18 1</ambient>
            <diffuse>0.22 0.55 0.22 1</diffuse>
          </material>
        </visual>

        <!-- 公園外圍景觀矮牆/花台 (與人行道接壤處) -->
        <collision name="park_curb_border">
          <pose>0 -24.5 0.25 0 0 0</pose>
          <geometry>
            <box><size>140 1.0 0.5</size></box>
          </geometry>
        </collision>
        <visual name="park_curb_border_vis">
          <pose>0 -24.5 0.25 0 0 0</pose>
          <geometry>
            <box><size>140 1.0 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>

        <!-- 公園內部中央步道 -->
        <visual name="park_path_vis">
          <pose>0 0 0.125 0 0 0</pose>
          <geometry>
            <box><size>130 6 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.75 0.65 1</ambient>
            <diffuse>0.8 0.75 0.65 1</diffuse>
          </material>
        </visual>

        <!-- 公園綠化林蔭樹木群 (樹幹為實體碰撞剛體) -->
        <!-- 樹木 1 -->
        <collision name="tree_trunk_1"><pose>-50 -15 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="tree_trunk_vis_1"><pose>-50 -15 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material></visual>
        <visual name="tree_foliage_vis_1"><pose>-50 -15 4.0 0 0 0</pose><geometry><sphere><radius>2.2</radius></sphere></geometry><material><ambient>0.1 0.45 0.1 1</ambient><diffuse>0.1 0.45 0.1 1</diffuse></material></visual>

        <!-- 樹木 2 -->
        <collision name="tree_trunk_2"><pose>-20 -18 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="tree_trunk_vis_2"><pose>-20 -18 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material></visual>
        <visual name="tree_foliage_vis_2"><pose>-20 -18 4.0 0 0 0</pose><geometry><sphere><radius>2.4</radius></sphere></geometry><material><ambient>0.12 0.5 0.12 1</ambient><diffuse>0.12 0.5 0.12 1</diffuse></material></visual>

        <!-- 樹木 3 -->
        <collision name="tree_trunk_3"><pose>15 -16 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="tree_trunk_vis_3"><pose>15 -16 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material></visual>
        <visual name="tree_foliage_vis_3"><pose>15 -16 4.0 0 0 0</pose><geometry><sphere><radius>2.2</radius></sphere></geometry><material><ambient>0.1 0.45 0.1 1</ambient><diffuse>0.1 0.45 0.1 1</diffuse></material></visual>

        <!-- 樹木 4 -->
        <collision name="tree_trunk_4"><pose>45 -18 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="tree_trunk_vis_4"><pose>45 -18 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material></visual>
        <visual name="tree_foliage_vis_4"><pose>45 -18 4.0 0 0 0</pose><geometry><sphere><radius>2.5</radius></sphere></geometry><material><ambient>0.12 0.5 0.12 1</ambient><diffuse>0.12 0.5 0.12 1</diffuse></material></visual>

        <!-- 樹木 5 (公園內部深處) -->
        <collision name="tree_trunk_5"><pose>0 15 1.5 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="tree_foliage_vis_5"><pose>0 15 4.5 0 0 0</pose><geometry><sphere><radius>3.0</radius></sphere></geometry><material><ambient>0.1 0.45 0.1 1</ambient><diffuse>0.1 0.45 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ==================== 沿街商住大樓建築立面與邊界限制 ==================== -->
    <model name="street_corridor_buildings">
      <static>true</static>
      <link name="building_link">
        <!-- ==================== 西側南段建築群 (光復路至公園前 X: 0 ~ 115) ==================== -->
        <collision name="bldg_west_south_col">
          <pose>57.5 -32 10 0 0 0</pose>
          <geometry><box><size>115 36 20</size></box></geometry>
        </collision>
        <visual name="bldg_west_south_vis">
          <pose>57.5 -32 10 0 0 0</pose>
          <geometry><box><size>115 36 20</size></box></geometry>
          <material>
            <ambient>0.72 0.70 0.68 1</ambient>
            <diffuse>0.75 0.72 0.70 1</diffuse>
          </material>
        </visual>

        <!-- ==================== 西側北段建築群 (公園後至新莊車站 X: 265 ~ 410) ==================== -->
        <collision name="bldg_west_north_col">
          <pose>337.5 -32 10 0 0 0</pose>
          <geometry><box><size>145 36 20</size></box></geometry>
        </collision>
        <visual name="bldg_west_north_vis">
          <pose>337.5 -32 10 0 0 0</pose>
          <geometry><box><size>145 36 20</size></box></geometry>
          <material>
            <ambient>0.72 0.70 0.68 1</ambient>
            <diffuse>0.75 0.72 0.70 1</diffuse>
          </material>
        </visual>

        <!-- ==================== 西側正對關新公園指標商住街區 (X: 115 ~ 265) ==================== -->
        <!-- 包含：星巴克日光門市、麥當勞關新店、康是美/富邦銀行、精緻餐飲街與昌益/豐邑高層現代大樓 -->
        
        <!-- 1. 建築背部本體剛體碰撞牆 -->
        <collision name="park_opp_main_col">
          <pose>190 -34 16 0 0 0</pose>
          <geometry><box><size>150 32 32</size></box></geometry>
        </collision>
        <visual name="park_opp_podium_vis">
          <pose>190 -34 16 0 0 0</pose>
          <geometry><box><size>150 32 32</size></box></geometry>
          <material>
            <ambient>0.78 0.76 0.73 1</ambient>
            <diffuse>0.82 0.80 0.77 1</diffuse>
          </material>
        </visual>

        <!-- 2. 一樓挑高 6.5 米騎樓立柱群 (沿人行道邊界配置剛體立柱，具實體碰撞) -->
        <collision name="pillar_col_1"><pose>125 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry></collision>
        <visual name="pillar_vis_1"><pose>125 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>

        <collision name="pillar_col_2"><pose>145 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry></collision>
        <visual name="pillar_vis_2"><pose>145 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>

        <collision name="pillar_col_3"><pose>165 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry></collision>
        <visual name="pillar_vis_3"><pose>165 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>

        <collision name="pillar_col_4"><pose>185 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry></collision>
        <visual name="pillar_vis_4"><pose>185 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>

        <collision name="pillar_col_5"><pose>205 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry></collision>
        <visual name="pillar_vis_5"><pose>205 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>

        <collision name="pillar_col_6"><pose>225 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry></collision>
        <visual name="pillar_vis_6"><pose>225 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>

        <collision name="pillar_col_7"><pose>245 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry></collision>
        <visual name="pillar_vis_7"><pose>245 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>

        <collision name="pillar_col_8"><pose>260 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry></collision>
        <visual name="pillar_vis_8"><pose>260 -15.2 3.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>6.4</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>

        <!-- 3. 騎樓走廊頂部吊頂石材橫樑 (Arcade Ceiling) -->
        <visual name="arcade_ceiling_vis">
          <pose>190 -16.5 6.4 0 0 0</pose>
          <geometry><box><size>150 4.5 0.4</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>

        <!-- ==================== 【知名店面 1：康是美 & 台北富邦銀行】(X: 115 ~ 155) ==================== -->
        <!-- 門面落地玻璃窗 -->
        <visual name="store_fubon_glass">
          <pose>135 -18 3.2 0 0 0</pose>
          <geometry><box><size>38 0.2 6.0</size></box></geometry>
          <material><ambient>0.1 0.2 0.3 0.9</ambient><diffuse>0.15 0.25 0.35 0.9</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <!-- 富邦銀行藍色品牌飾條 -->
        <visual name="fubon_banner">
          <pose>128 -17.8 5.8 0 0 0</pose>
          <geometry><box><size>22 0.25 1.0</size></box></geometry>
          <material><ambient>0.05 0.35 0.75 1</ambient><diffuse>0.08 0.45 0.85 1</diffuse><emissive>0.05 0.25 0.5 1</emissive></material>
        </visual>
        <!-- 康是美亮橘色招牌板 -->
        <visual name="cosmed_banner">
          <pose>147 -17.8 5.8 0 0 0</pose>
          <geometry><box><size>14 0.25 1.0</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.5 0.05 1</diffuse><emissive>0.6 0.25 0.0 1</emissive></material>
        </visual>

        <!-- ==================== 【知名店面 2：麥當勞 新竹關新店】(X: 155 ~ 185) ==================== -->
        <!-- 麥當勞落地窗與深灰現代外觀 -->
        <visual name="mcd_glass">
          <pose>170 -18 3.2 0 0 0</pose>
          <geometry><box><size>30 0.2 6.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 0.9</ambient><diffuse>0.2 0.2 0.2 0.9</diffuse></material>
        </visual>
        <!-- 麥當勞紅色招牌背板 -->
        <visual name="mcd_red_banner">
          <pose>170 -17.8 5.8 0 0 0</pose>
          <geometry><box><size>26 0.25 1.1</size></box></geometry>
          <material><ambient>0.85 0.08 0.08 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
        <!-- 麥當勞經典金色「M」雙拱門立體發光標誌 -->
        <visual name="mcd_golden_arch_left">
          <pose>169.3 -17.6 5.8 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse><emissive>1.0 0.85 0.0 1</emissive></material>
        </visual>
        <visual name="mcd_golden_arch_right">
          <pose>170.7 -17.6 5.8 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse><emissive>1.0 0.85 0.0 1</emissive></material>
        </visual>
        <!-- 麥當勞門口得來速/點餐窗口裝飾 -->
        <visual name="mcd_order_window">
          <pose>179 -17.9 2.5 0 0 0</pose>
          <geometry><box><size>3.5 0.15 2.2</size></box></geometry>
          <material><ambient>0.9 0.8 0.4 1</ambient><diffuse>0.9 0.8 0.4 1</diffuse><emissive>0.5 0.4 0.1 1</emissive></material>
        </visual>

        <!-- ==================== 【知名店面 3：星巴克 新竹日光門市 (38號)】(X: 185 ~ 215) ==================== -->
        <!-- 黑色金屬框挑高大面積落地玻璃帷幕 (標誌性雙面大採光設計) -->
        <visual name="starbucks_glass_wall">
          <pose>200 -18 3.2 0 0 0</pose>
          <geometry><box><size>30 0.2 6.0</size></box></geometry>
          <material><ambient>0.08 0.1 0.12 0.9</ambient><diffuse>0.1 0.12 0.15 0.9</diffuse><specular>0.9 0.9 0.9 1</specular></material>
        </visual>
        <!-- 室內咖啡廳溫馨暖黃照明 (落地窗透光) -->
        <visual name="starbucks_interior_light">
          <pose>200 -18.2 3.2 0 0 0</pose>
          <geometry><box><size>28 0.1 5.6</size></box></geometry>
          <material><ambient>0.95 0.85 0.5 1</ambient><diffuse>0.95 0.85 0.5 1</diffuse><emissive>0.7 0.55 0.3 1</emissive></material>
        </visual>
        <!-- 星巴克標誌性雙尾美人魚圓形綠色 Logo 招牌 -->
        <visual name="starbucks_green_disc">
          <pose>200 -17.6 5.8 -1.5707963 0 0</pose>
