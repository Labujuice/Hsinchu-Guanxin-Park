        <!-- ==================== 新莊火車站 (Xinzhuang Station) ==================== -->
        <!-- 終點新莊車站站體主結構與終點死胡同擋牆 (X: 405) -->
        <collision name="xinzhuang_station_col">
          <pose>408 0 8 0 0 0</pose>
