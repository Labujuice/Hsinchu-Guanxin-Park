<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="guanxin_world">
    <!-- ==================== 物理引擎設定 ==================== -->
    <physics name="ode_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ==================== Gazebo 系統外掛 ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== 天空與日照光影 ==================== -->
    <scene>
      <ambient>0.65 0.68 0.72 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>100 50 150 0 0 0</pose>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 -0.2 -0.8</direction>
    </light>

    <!-- ==================== 道路路網 (關新路、關新二街、關新北路、關新東路) ==================== -->
    <!-- 朝向說明：車輛自光復路向新莊車站行駛 (+X 方向)。依台灣右側通行，右側車道為 -Y，公園位於右邊 (-Y 側) -->
    <model name="guanxin_road_network">
      <static>true</static>
      <link name="road_link">
        <!-- 1. 關新路主幹道 (南北長 410m, 寬 20m, Y: -10 ~ +10) -->
        <collision name="road_main_col">
          <pose>205 0 0.025 0 0 0</pose>
          <geometry><box><size>410 20 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="road_main_vis">
          <pose>205 0 0.025 0 0 0</pose>
          <geometry><box><size>410 20 0.05</size></box></geometry>
          <material><ambient>0.22 0.22 0.22 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>

        <!-- 關新路雙黃分向線 (Y = 0) -->
        <visual name="center_double_yellow">
          <pose>205 0 0.052 0 0 0</pose>
          <geometry><box><size>400 0.3 0.002</size></box></geometry>
          <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material>
        </visual>
        <!-- 右側車道分隔線 (Y = -5，往新莊車站方向) -->
        <visual name="lane_divider_right">
          <pose>205 -5 0.052 0 0 0</pose>
          <geometry><box><size>400 0.15 0.002</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <!-- 左側車道分隔線 (Y = +5，往光復路方向) -->
        <visual name="lane_divider_left">
          <pose>205 5 0.052 0 0 0</pose>
          <geometry><box><size>400 0.15 0.002</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>

        <!-- 2. 關新二街 (公園南側路段，向右分支通往公園南緣，X: 172 ~ 186，Y: -10 ~ -115) -->
        <collision name="road_sec2_col">
          <pose>179 -62.5 0.025 0 0 0</pose>
          <geometry><box><size>14 105 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="road_sec2_vis">
          <pose>179 -62.5 0.025 0 0 0</pose>
          <geometry><box><size>14 105 0.05</size></box></geometry>
          <material><ambient>0.24 0.24 0.24 1</ambient><diffuse>0.26 0.26 0.26 1</diffuse></material>
        </visual>
        <visual name="road_sec2_yellow_line">
          <pose>179 -62.5 0.052 0 0 0</pose>
          <geometry><box><size>0.2 100 0.002</size></box></geometry>
          <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material>
        </visual>

        <!-- 3. 關新北路 (公園北側路段，向右分支通往公園北緣，X: 316 ~ 330，Y: -10 ~ -115) -->
        <collision name="road_north_col">
          <pose>323 -62.5 0.025 0 0 0</pose>
          <geometry><box><size>14 105 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="road_north_vis">
          <pose>323 -62.5 0.025 0 0 0</pose>
          <geometry><box><size>14 105 0.05</size></box></geometry>
          <material><ambient>0.24 0.24 0.24 1</ambient><diffuse>0.26 0.26 0.26 1</diffuse></material>
        </visual>
        <visual name="road_north_yellow_line">
          <pose>323 -62.5 0.052 0 0 0</pose>
          <geometry><box><size>0.2 100 0.002</size></box></geometry>
          <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material>
        </visual>

        <!-- 4. 關新東路 (公園東側路段，南北向連通關新二街與關新北路，Y = -112，寬 14m，長 158m) -->
        <collision name="road_east_col">
          <pose>251 -112 0.025 0 0 0</pose>
          <geometry><box><size>158 14 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="road_east_vis">
          <pose>251 -112 0.025 0 0 0</pose>
          <geometry><box><size>158 14 0.05</size></box></geometry>
          <material><ambient>0.23 0.23 0.23 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="road_east_yellow_line">
          <pose>251 -112 0.052 0 0 0</pose>
          <geometry><box><size>150 0.2 0.002</size></box></geometry>
          <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material>
        </visual>

        <!-- 路口斑馬線 -->
        <visual name="crosswalk_guangfu">
          <pose>10 0 0.052 0 0 0</pose>
          <geometry><box><size>4 18 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="crosswalk_sec2">
          <pose>179 -11 0.052 0 0 0</pose>
          <geometry><box><size>12 2.5 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="crosswalk_north">
          <pose>323 -11 0.052 0 0 0</pose>
          <geometry><box><size>12 2.5 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>

        <!-- ==================== 人行道 (Sidewalks - 15cm 高度剛體碰撞路緣) ==================== -->
        <!-- 左側人行道 (商圈側 Y = +12，全線貫穿 410m) -->
        <collision name="sidewalk_left_col">
          <pose>205 12 0.10 0 0 0</pose>
          <geometry><box><size>410 4 0.20</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="sidewalk_left_vis">
          <pose>205 12 0.10 0 0 0</pose>
          <geometry><box><size>410 4 0.20</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>

        <!-- 右側人行道 (公園側 Y = -12，在關新二街口與關新北路口挖開空隙，分為三段) -->
        <!-- 右側南段 (光復路至關新二街前 X: 0 ~ 172) -->
        <collision name="sidewalk_r_south_col">
          <pose>86 -12 0.10 0 0 0</pose>
          <geometry><box><size>172 4 0.20</size></box></geometry>
        </collision>
        <visual name="sidewalk_r_south_vis">
          <pose>86 -12 0.10 0 0 0</pose>
          <geometry><box><size>172 4 0.20</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>

        <!-- 右側中段 (關新公園正門側人行道 X: 186 ~ 316, 長 130m) -->
        <collision name="sidewalk_r_mid_col">
          <pose>251 -12 0.10 0 0 0</pose>
          <geometry><box><size>130 4 0.20</size></box></geometry>
        </collision>
        <visual name="sidewalk_r_mid_vis">
          <pose>251 -12 0.10 0 0 0</pose>
          <geometry><box><size>130 4 0.20</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>

        <!-- 右側北段 (關新北路至新莊車站 X: 330 ~ 410) -->
        <collision name="sidewalk_r_north_col">
          <pose>370 -12 0.10 0 0 0</pose>
          <geometry><box><size>80 4 0.20</size></box></geometry>
        </collision>
        <visual name="sidewalk_r_north_vis">
          <pose>370 -12 0.10 0 0 0</pose>
          <geometry><box><size>80 4 0.20</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 關新公園 (Guanxin Park / 日光公園 - 位於車輛行駛右手邊 Y = -59.5) ==================== -->
    <!-- 範圍：南北長 130m (X: 186 ~ 316), 東西寬 91m (Y: -105 ~ -14), 實地登記面積 3,500 坪 (約 11,830 m^2) -->
    <model name="guanxin_park">
      <static>true</static>
      <pose>251 -59.5 0.12 0 0 0</pose>
      <link name="park_link">
        <!-- 綠地大草坪主剛體 -->
        <collision name="park_lawn_col">
          <geometry><box><size>130 91 0.24</size></box></geometry>
        </collision>
        <visual name="park_lawn_vis">
          <geometry><box><size>130 91 0.24</size></box></geometry>
          <material><ambient>0.18 0.52 0.18 1</ambient><diffuse>0.22 0.58 0.22 1</diffuse></material>
        </visual>

        <!-- 四周邊緣花台/景觀路緣剛體 (西側臨關新路 Y = +45.5 相對座標) -->
        <collision name="curb_west"><pose>0 45 0.25 0 0 0</pose><geometry><box><size>130 1.0 0.5</size></box></geometry></collision>
        <visual name="curb_west_vis"><pose>0 45 0.25 0 0 0</pose><geometry><box><size>130 1.0 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>

        <!-- 南側臨關新二街邊界 (X = -64.5 相對座標) -->
        <collision name="curb_south"><pose>-64.5 0 0.25 0 0 0</pose><geometry><box><size>1.0 91 0.5</size></box></geometry></collision>
        <visual name="curb_south_vis"><pose>-64.5 0 0.25 0 0 0</pose><geometry><box><size>1.0 91 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>

        <!-- 北側臨關新北路邊界 (X = +64.5 相對座標) -->
        <collision name="curb_north"><pose>64.5 0 0.25 0 0 0</pose><geometry><box><size>1.0 91 0.5</size></box></geometry></collision>
        <visual name="curb_north_vis"><pose>64.5 0 0.25 0 0 0</pose><geometry><box><size>1.0 91 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>

        <!-- 東側臨關新東路邊界 (Y = -45 相對座標) -->
        <collision name="curb_east"><pose>0 -45 0.25 0 0 0</pose><geometry><box><size>130 1.0 0.5</size></box></geometry></collision>
        <visual name="curb_east_vis"><pose>0 -45 0.25 0 0 0</pose><geometry><box><size>130 1.0 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>

        <!-- 公園內部主步道 (十字形與環型步道) -->
        <visual name="path_horizontal"><pose>0 0 0.125 0 0 0</pose><geometry><box><size>124 5 0.01</size></box></geometry><material><ambient>0.82 0.78 0.7 1</ambient><diffuse>0.82 0.78 0.7 1</diffuse></material></visual>
        <visual name="path_vertical"><pose>0 0 0.125 0 0 0</pose><geometry><box><size>5 85 0.01</size></box></geometry><material><ambient>0.82 0.78 0.7 1</ambient><diffuse>0.82 0.78 0.7 1</diffuse></material></visual>

        <!-- ==================== 核心設施 1：休閒景觀涼亭 (Rest Pavilion / Gazebo) ==================== -->
        <!-- 位於公園中心廣場 (相對公園局部座標: X=0, Y=10) -->
        <collision name="gazebo_col"><pose>0 10 1.8 0 0 0</pose><geometry><box><size>7 7 3.6</size></box></geometry></collision>
        <!-- 4 根大理石支柱 -->
        <visual name="p_post_1"><pose>-2.8 7.2 1.6 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>3.2</length></cylinder></geometry><material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.35 0.3 1</diffuse></material></visual>
        <visual name="p_post_2"><pose>2.8 7.2 1.6 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>3.2</length></cylinder></geometry><material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.35 0.3 1</diffuse></material></visual>
        <visual name="p_post_3"><pose>-2.8 12.8 1.6 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>3.2</length></cylinder></geometry><material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.35 0.3 1</diffuse></material></visual>
        <visual name="p_post_4"><pose>2.8 12.8 1.6 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>3.2</length></cylinder></geometry><material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.35 0.3 1</diffuse></material></visual>
        <!-- 涼亭四角斜坡頂棚 (Hipped Roof) -->
        <visual name="gazebo_roof"><pose>0 10 3.6 0 0 0</pose><geometry><box><size>7.5 7.5 0.6</size></box></geometry><material><ambient>0.2 0.15 0.1 1</ambient><diffuse>0.3 0.2 0.15 1</diffuse></material></visual>
        <visual name="gazebo_top_cap"><pose>0 10 4.1 0 0 0</pose><geometry><box><size>4.5 4.5 0.5</size></box></geometry><material><ambient>0.25 0.18 0.12 1</ambient><diffuse>0.35 0.25 0.18 1</diffuse></material></visual>
        <!-- 涼亭內部木質休閒長椅 -->
        <visual name="gazebo_bench_1"><pose>0 7.8 0.45 0 0 0</pose><geometry><box><size>4.0 0.5 0.4</size></box></geometry><material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material></visual>
        <visual name="gazebo_bench_2"><pose>0 12.2 0.45 0 0 0</pose><geometry><box><size>4.0 0.5 0.4</size></box></geometry><material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material></visual>

        <!-- ==================== 核心設施 2：地景磨石子大溜滑梯 (Hill Stone Slide) ==================== -->
        <!-- 位於公園中心偏北山丘區 (相對座標: X=24, Y=-8) -->
        <!-- 遊戲小山丘斜坡剛體 -->
        <collision name="slide_hill_col"><pose>24 -8 1.2 0 0 0</pose><geometry><box><size>14 12 2.4</size></box></geometry></collision>
        <visual name="slide_hill_mound"><pose>24 -8 1.2 0 0 0</pose><geometry><box><size>14 12 2.4</size></box></geometry><material><ambient>0.2 0.48 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <!-- 磨石子寬面溜滑梯滑道 (灰色平滑傾斜石面) -->
        <visual name="stone_slide_wide"><pose>24 -1.5 1.2 -0.45 0 0</pose><geometry><box><size>4.2 8.0 0.2</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <!-- 滑梯兩側黃色安全防護護欄 -->
        <visual name="slide_rail_l"><pose>21.8 -1.5 1.5 -0.45 0 0</pose><geometry><box><size>0.2 8.0 0.5</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <visual name="slide_rail_r"><pose>26.2 -1.5 1.5 -0.45 0 0</pose><geometry><box><size>0.2 8.0 0.5</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <!-- 山丘後方攀岩登頂階梯 -->
        <visual name="slide_stairs"><pose>24 -14.5 1.2 0.45 0 0</pose><geometry><box><size>3.5 6.0 0.25</size></box></geometry><material><ambient>0.4 0.35 0.3 1</ambient><diffuse>0.5 0.45 0.4 1</diffuse></material></visual>

        <!-- ==================== 核心設施 3：盪鞦韆組 (Playground Swings) ==================== -->
        <!-- 位於公園西側靠入口共融遊樂場 (相對座標: X=-24, Y=18) -->
        <!-- 防護安全軟地墊 (紅色橡膠地墊) -->
        <visual name="swing_rubber_mat"><pose>-24 18 0.13 0 0 0</pose><geometry><box><size>10 7 0.02</size></box></geometry><material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.65 0.25 0.25 1</diffuse></material></visual>
        <!-- 鞦韆 A 字鋼構支架 (藍/黃色雙三角架) -->
        <collision name="swing_frame_col"><pose>-24 18 1.7 0 0 0</pose><geometry><box><size>8 0.8 3.4</size></box></geometry></collision>
        <visual name="swing_frame_left"><pose>-27.8 18 1.7 0 0.18 0</pose><geometry><cylinder><radius>0.08</radius><length>3.5</length></cylinder></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.45 0.85 1</diffuse></material></visual>
        <visual name="swing_frame_right"><pose>-20.2 18 1.7 0 -0.18 0</pose><geometry><cylinder><radius>0.08</radius><length>3.5</length></cylinder></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.45 0.85 1</diffuse></material></visual>
        <!-- 頂部水平橫樑 -->
        <visual name="swing_top_beam"><pose>-24 18 3.3 0 1.5707963 0</pose><geometry><cylinder><radius>0.09</radius><length>8.2</length></cylinder></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <!-- 鞦韆 1 (雙吊繩與座椅) -->
        <visual name="swing_rope_1a"><pose>-25.5 18 2.0 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>2.2</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="swing_rope_1b"><pose>-24.7 18 2.0 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>2.2</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="swing_seat_1"><pose>-25.1 18 0.85 0 0 0</pose><geometry><box><size>0.9 0.35 0.08</size></box></geometry><material><ambient>0.1 0.7 0.3 1</ambient><diffuse>0.1 0.8 0.35 1</diffuse></material></visual>
        <!-- 鞦韆 2 -->
        <visual name="swing_rope_2a"><pose>-23.3 18 2.0 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>2.2</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="swing_rope_2b"><pose>-22.5 18 2.0 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>2.2</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="swing_seat_2"><pose>-22.9 18 0.85 0 0 0</pose><geometry><box><size>0.9 0.35 0.08</size></box></geometry><material><ambient>0.1 0.7 0.3 1</ambient><diffuse>0.1 0.8 0.35 1</diffuse></material></visual>

        <!-- ==================== 公園代表性林蔭大樹 (實體剛體樹幹) ==================== -->
        <collision name="tree_trunk_1"><pose>-45 20 1.5 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="tree_trunk_vis_1"><pose>-45 20 1.5 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material></visual>
