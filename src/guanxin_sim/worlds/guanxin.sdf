        <!-- 分隔島: 北段1 (關新二街口至關新北路口) -->
        <collision name="median_n1_col"><pose>93.087 405.451 0.10 0 0 1.34512</pose><geometry><box><size>120.00 1.8 0.20</size></box></geometry></collision>
        <visual name="median_n1_curb"><pose>93.087 405.451 0.10 0 0 1.34512</pose><geometry><box><size>120.00 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
