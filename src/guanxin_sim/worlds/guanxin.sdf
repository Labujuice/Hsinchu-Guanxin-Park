        <!-- 關新二街西段 (自橘時咖啡/星巴克路口向西通往新莊街, 長 120m, 寬 14m) -->
        <collision name="gx2_west_col"><pose>8.863 351.428 0.01 0 0 -0.22568</pose><geometry><box><size>120.0 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
