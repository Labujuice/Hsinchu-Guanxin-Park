<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="guanxin_world">
    <!-- ==================== 物理引擎設定 (ODE 物理引擎，高頻步長 0.002s / 500Hz) ==================== -->
    <physics name="default_physics" type="ode" default="true">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- ==================== WGS84 地理基準原點 (Geospatial Datum) ==================== -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>24.7818444</latitude_deg>
      <longitude_deg>121.0209750</longitude_deg>
      <elevation>35.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- ==================== Gazebo Harmonic 核心系統外掛 ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ==================== 環境光照與太陽光源 ==================== -->
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.72 0.82 0.92 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>150 -60 200 0.6 0.4 -0.8</pose>
      <diffuse>0.92 0.90 0.86 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

        <!-- ==================== 地面大底 (Ground Plane 1400m x 1400m 覆蓋全域 58 公頃) ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <pose>-100 480 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry><plane><normal>0 0 1</normal><size>1400 1400</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kd>100000</kd><kp>10000000</kp></ode></contact>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry><plane><normal>0 0 1</normal><size>1400 1400</size></plane></geometry>
          <material><ambient>0.42 0.44 0.42 1</ambient><diffuse>0.48 0.50 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== Phase 2: 全域路網精確鋪設與路邊智慧停車柱系統 ==================== -->
    <!-- 涵蓋 58 公頃: 關新路(18m)、關新東路(14m)、光復路(24m)、關新一街(12m)、關新二街(14m)、關新北路(14m)、西側社區巷弄 -->
    <model name="road_network">
      <static>true</static>
      <link name="road_link">
        <!-- 1. 關新路主幹道柏油路面 (長 860.0m, 寬 18m, 雙向四線道, 方位角 12.93° / yaw=1.3451) -->
        <collision name="gx_road_col"><pose>96.220 419.096 0.01 0 0 1.34512</pose><geometry><box><size>860.0 18.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx_road_vis"><pose>96.220 419.096 0.01 0 0 1.34512</pose><geometry><box><size>860.0 18.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <!-- 2. 關新東路主幹道柏油路面 (長 820.0m, 寬 14m, 雙向二線道, 平行於關新路東側 153.3m) -->
        <collision name="gxe_road_col"><pose>245.633 384.793 0.01 0 0 1.34512</pose><geometry><box><size>820.0 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxe_road_vis"><pose>245.633 384.793 0.01 0 0 1.34512</pose><geometry><box><size>820.0 14.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <!-- 3. 光復路一段主幹道 (南界門戶橫向幹道, 長 450m, 寬 24m, 雙向六線道) -->
        <collision name="guangfu_road_col"><pose>10.0 -12.0 0.01 0 0 0</pose><geometry><box><size>450.0 24.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="guangfu_road_vis"><pose>10.0 -12.0 0.01 0 0 0</pose><geometry><box><size>450.0 24.0 0.02</size></box></geometry><material><ambient>0.20 0.20 0.21 1</ambient><diffuse>0.22 0.22 0.23 1</diffuse></material></visual>
        <!-- 4. 關新一街東段 (自關新路連通至關新東路, 長 135m, 寬 12m) -->
        <collision name="gx1_east_col"><pose>95.226 68.427 0.01 0 0 -0.22568</pose><geometry><box><size>135.0 12.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx1_east_vis"><pose>95.226 68.427 0.01 0 0 -0.22568</pose><geometry><box><size>135.0 12.0 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>
        <!-- 關新一街西段 (自關新路延伸至西側社區, 長 60m, 寬 12m) -->
        <collision name="gx1_west_col"><pose>-19.294 94.719 0.01 0 0 -0.22568</pose><geometry><box><size>60.0 12.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx1_west_vis"><pose>-19.294 94.719 0.01 0 0 -0.22568</pose><geometry><box><size>60.0 12.0 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>
        <!-- 5. 關新二街東段 (自星巴克路口連通至關新東路, 長 135m, 寬 14m) -->
        <collision name="gx2_east_col"><pose>152.623 318.422 0.01 0 0 -0.22568</pose><geometry><box><size>135.0 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx2_east_vis"><pose>152.623 318.422 0.01 0 0 -0.22568</pose><geometry><box><size>135.0 14.0 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>
        <!-- 關新二街西段 (自星巴克路口向西通往新莊街, 長 120m, 寬 14m) -->
        <collision name="gx2_west_col"><pose>8.863 351.428 0.01 0 0 -0.22568</pose><geometry><box><size>120.0 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx2_west_vis"><pose>8.863 351.428 0.01 0 0 -0.22568</pose><geometry><box><size>120.0 14.0 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>
        <!-- 6. 關新北路東段 (日光公園北側橫向幹道, 長 135m, 寬 14m) -->
        <collision name="gxn_east_col"><pose>184.734 458.284 0.01 0 0 -0.22568</pose><geometry><box><size>135.0 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gxn_east_vis"><pose>184.734 458.284 0.01 0 0 -0.22568</pose><geometry><box><size>135.0 14.0 0.02</size></box></geometry><material><ambient>0.23 0.23 0.24 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material></visual>
        <!-- 關新北路西段 (新莊車站前西側聯絡道, 長 100m, 寬 14m) -->
        <collision name="gxn_west_col"><pose>50.720 489.052 0.01 0 0 -0.22568</pose><geometry><box><size>100.0 14.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
