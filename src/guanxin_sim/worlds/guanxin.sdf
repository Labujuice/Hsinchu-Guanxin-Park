        <!-- 光復路口邊界擋牆 (防止車輛向後衝出光復路交會處) -->
        <collision name="south_boundary_wall">
          <pose>-6 0 5 0 0 0</pose>
          <geometry>
            <box><size>4 50 10</size></box>
          </geometry>
        </collision>
