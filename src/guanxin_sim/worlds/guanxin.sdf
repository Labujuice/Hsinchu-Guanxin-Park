        <!-- ===== 8. 關東路主幹道 (Guandong Road: 依真實GIS連通光復路、新莊車站東側與埔頂路) ===== -->
        <!-- 關東路: 關東路南段: 自光復路向北 (長 353.6m, 寬 12.0m) -->
        <collision name="gd_seg1_south_col"><pose>297.440 111.264 0.01 0 0 1.48701</pose><geometry><box><size>353.55 12.0 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gd_seg1_south_vis"><pose>297.440 111.264 0.01 0 0 1.48701</pose><geometry><box><size>353.55 12.0 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <visual name="gd_seg1_south_line"><pose>297.440 111.264 0.022 0 0 1.48701</pose><geometry><box><size>353.55 0.25 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <!-- 關東路: 關東路中段: 通往新莊車站商圈 (長 201.6m, 寬 12.0m) -->
