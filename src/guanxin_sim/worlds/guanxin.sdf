        <visual name="guandong_road_line"><pose>151.068 568.614 0.022 0 0 -0.22568</pose><geometry><box><size>300.0 0.30 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>

        <!-- ===== 9. 關新路中央綠化分隔島 (Central Median Islands) ===== -->
        <!-- 分隔島: 南段1 (光復路口至關新一街口) -->
        <collision name="median_s1_col"><pose>10.293 44.834 0.10 0 0 1.34512</pose><geometry><box><size>60.00 1.8 0.20</size></box></geometry></collision>
        <visual name="median_s1_curb"><pose>10.293 44.834 0.10 0 0 1.34512</pose><geometry><box><size>60.00 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_s1_lawn"><pose>10.293 44.834 0.205 0 0 1.34512</pose><geometry><box><size>58.80 1.4 0.01</size></box></geometry><material><ambient>0.20 0.52 0.20 1</ambient><diffuse>0.25 0.58 0.25 1</diffuse></material></visual>
        <!-- 分隔島: 中段 (關新一街口至關新二街口) -->
        <collision name="median_mid_col"><pose>48.334 210.523 0.10 0 0 1.34512</pose><geometry><box><size>232.00 1.8 0.20</size></box></geometry></collision>
