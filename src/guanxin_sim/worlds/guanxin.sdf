        <visual name="dash_l_356"><pose>88.702 406.458 0.022 0 0 1.34512</pose><geometry><box><size>120.00 0.15 0.002</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
