    <!-- ==================== 星巴克新竹日光門市 (38 號) 高真實度實景模型 ==================== -->
    <!-- 特色：45度導角入口、實景PBR立面貼圖、2F Bagel 24H網球工作室遮陽棚、木柵欄露天木棧咖啡座、屋頂鋼桁架高聳美人魚徽標 -->
    <include>
      <name>starbucks_building</name>
      <uri>model://starbucks_building</uri>
      <pose>185.5 -23.25 0 0 0 0</pose>
    </include>

    <!-- ==================== 左側建築群 (West Side: 騎樓走廊, 7-Eleven, 摩斯漢堡, 現代豪宅) ==================== -->
    <!-- 特色：完整 2.5m 內縮騎樓 (Arcade)、支撐立柱群、騎樓吊頂燈、7-Eleven便利商店、側懸招牌 -->
    <model name="west_side_blocks">
      <static>true</static>
      <link name="west_link">
        <!-- 1. 南段高層住宅社區 (昌益丹麥/芬蘭 - X: 0 ~ 150, Y: 14.5 ~ 45, 高 45m) -->
