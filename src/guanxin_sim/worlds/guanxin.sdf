<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="guanxin_world">
    <!-- ==================== 物理引擎設定 (ODE 物理引擎，高頻步長 0.002s / 500Hz) ==================== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- ==================== Gazebo Harmonic 核心系統外掛 ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== 環境光照與太陽光源 ==================== -->
    <scene>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <background>0.82 0.88 0.95 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>150 -50 180 0 0.45 0.8</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1500</range>
        <constant>0.9</constant>
        <linear>0.001</linear>
        <quadratic>0.0001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- ==================== 地面大底 (Ground Plane) ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_vis">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <material><ambient>0.4 0.42 0.4 1</ambient><diffuse>0.45 0.48 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 關新路道路系統 (Roadway, Median, Sidewalks, Markings) ==================== -->
    <model name="road_network">
      <static>true</static>
      <link name="road_link">
        <!-- 關新路主幹道柏油路面 (X: 0 ~ 410, Y: -9 ~ +9, 寬 18m, 雙向四線道) -->
        <collision name="guanxin_asphalt_col">
          <pose>205 0 0.01 0 0 0</pose>
          <geometry><box><size>410 18 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="guanxin_asphalt_vis">
          <pose>205 0 0.01 0 0 0</pose>
          <geometry><box><size>410 18 0.02</size></box></geometry>
          <material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material>
        </visual>

        <!-- ===== 中央綠化分隔島 (Green Median Strip with Curb) ===== -->
        <!-- 南段分隔島 (X: 15 ~ 195, Y: -0.9 ~ +0.9, 寬 1.8m, 高 0.2m) -->
        <collision name="median_south_col"><pose>105 0 0.10 0 0 0</pose><geometry><box><size>180 1.8 0.20</size></box></geometry></collision>
        <visual name="median_south_curb"><pose>105 0 0.10 0 0 0</pose><geometry><box><size>180 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_south_lawn"><pose>105 0 0.205 0 0 0</pose><geometry><box><size>178 1.4 0.01</size></box></geometry><material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <!-- 分隔島南端防撞標線 (X: 15) -->
        <visual name="median_south_tip_vis"><pose>15.2 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <!-- 分隔島北端防撞標線與轉向警示標誌 (X: 195, 關新二街口) -->
        <visual name="median_s_north_tip_vis"><pose>194.8 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <!-- 藍底白色箭頭指示牌桿 (如 Street_photo3.png & Street_photo5.png 所示) -->
        <visual name="median_s_sign_pole"><pose>194 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="median_s_sign_board"><pose>194 0 2.2 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>0.04</length></cylinder></geometry><material><ambient>0.0 0.3 0.8 1</ambient><diffuse>0.0 0.4 0.9 1</diffuse><emissive>0.0 0.2 0.5 1</emissive></material></visual>

        <!-- 北段分隔島 (X: 216 ~ 340, Y: -0.9 ~ +0.9, 長 124m) -->
        <collision name="median_north_col"><pose>278 0 0.10 0 0 0</pose><geometry><box><size>124 1.8 0.20</size></box></geometry></collision>
        <visual name="median_north_curb"><pose>278 0 0.10 0 0 0</pose><geometry><box><size>124 1.8 0.20</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <visual name="median_north_lawn"><pose>278 0 0.205 0 0 0</pose><geometry><box><size>122 1.4 0.01</size></box></geometry><material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.25 0.55 0.25 1</diffuse></material></visual>
        <visual name="median_n_south_tip_vis"><pose>216.2 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="median_n_north_tip_vis"><pose>339.8 0 0.11 0 0 0</pose><geometry><box><size>0.6 1.8 0.21</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>

        <!-- ===== 關新二街 (Guanxin 2nd St. - X: 197 ~ 211, 路寬 14m) ===== -->
        <!-- 東段 (往公園與關新東路 Y: -9 ~ -112, 長 103m) -->
        <collision name="gx2nd_east_col"><pose>204 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="gx2nd_east_vis"><pose>204 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <!-- 西段 (往關新西側街區 Y: 9 ~ 55, 長 46m) -->
        <collision name="gx2nd_west_col"><pose>204 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry></collision>
        <visual name="gx2nd_west_vis"><pose>204 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 關新北路 (Guanxin North Rd. - X: 344 ~ 358, 路寬 14m) ===== -->
        <!-- 東段 (往關新東路 Y: -9 ~ -112, 長 103m) -->
        <collision name="gxnorth_east_col"><pose>351 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry></collision>
        <visual name="gxnorth_east_vis"><pose>351 -60.5 0.01 0 0 0</pose><geometry><box><size>14 103 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>
        <!-- 西段 (往關新西街 Y: 9 ~ 55, 長 46m) -->
        <collision name="gxnorth_west_col"><pose>351 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry></collision>
        <visual name="gxnorth_west_vis"><pose>351 32 0.01 0 0 0</pose><geometry><box><size>14 46 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 關新東路 (Guanxin East Rd. - Y: -119 ~ -105, 寬 14m, 南北向貫穿 X: 190 ~ 365) ===== -->
        <collision name="gxeast_col"><pose>277.5 -112 0.01 0 0 0</pose><geometry><box><size>175 14 0.02</size></box></geometry></collision>
        <visual name="gxeast_vis"><pose>277.5 -112 0.01 0 0 0</pose><geometry><box><size>175 14 0.02</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material></visual>

        <!-- ===== 道路路面標線 (Road Markings) ===== -->
        <!-- 關新路雙向車道虛線 (Lane Dividers) -->
        <!-- 右側南段車道分向線 (Y = -5.0) -->
        <visual name="lane_div_r_south"><pose>105 -5.0 0.022 0 0 0</pose><geometry><box><size>175 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 右側北段車道分向線 (Y = -5.0) -->
        <visual name="lane_div_r_north"><pose>278 -5.0 0.022 0 0 0</pose><geometry><box><size>120 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 左側南段車道分向線 (Y = +5.0) -->
        <visual name="lane_div_l_south"><pose>105 5.0 0.022 0 0 0</pose><geometry><box><size>175 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 左側北段車道分向線 (Y = +5.0) -->
        <visual name="lane_div_l_north"><pose>278 5.0 0.022 0 0 0</pose><geometry><box><size>120 0.15 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 關新路速限 30 地面標線 (Speed Limit "30", 如 Street_photo3 & 5 所示) -->
        <visual name="speed_limit_30_r1"><pose>70 -5.0 0.023 0 0 0</pose><geometry><box><size>3.5 2.0 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="speed_limit_30_r2"><pose>240 -5.0 0.023 0 0 0</pose><geometry><box><size>3.5 2.0 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- 機車停等區 (Scooter Stop Box - 黃/白方框，位於路口停止線前) -->
        <visual name="scooter_box_south"><pose>192 -5.0 0.024 0 0 0</pose><geometry><box><size>3.5 6.5 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>
        <visual name="scooter_box_north"><pose>341 -5.0 0.024 0 0 0</pose><geometry><box><size>3.5 6.5 0.002</size></box></geometry><material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material></visual>

        <!-- 行人穿越斑馬線 (Zebra Crossings) -->
        <!-- 1. 關新二街路口南側斑馬線 (X = 196) -->
        <visual name="zebra_gx2_south"><pose>196 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 2. 關新二街路口北側斑馬線 (X = 212) -->
        <visual name="zebra_gx2_north"><pose>212 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 3. 關新二街東側斑馬線 (跨關新二街, Y = -11) -->
        <visual name="zebra_gx2_east"><pose>204 -11 0.025 0 0 0</pose><geometry><box><size>12 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 4. 關新二街西側斑馬線 (跨關新二街, Y = +11) -->
        <visual name="zebra_gx2_west"><pose>204 11 0.025 0 0 0</pose><geometry><box><size>12 2.8 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- 5. 關新北路路口斑馬線 (X = 343) -->
        <visual name="zebra_gxnorth_south"><pose>343 0 0.025 0 0 0</pose><geometry><box><size>3.0 17 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- ===== 人行道系統 (Sidewalks - 15cm 高度剛體碰撞路緣) ===== -->
        <!-- 【左側人行道 (商圈側 Y: +9 ~ +13.5, 寬 4.5m, 高 0.15m)】 -->
        <!-- 左側南段 (X: 0 ~ 197, 長 197m) -->
        <collision name="sidewalk_l_south_col"><pose>98.5 11.25 0.08 0 0 0</pose><geometry><box><size>197 4.5 0.16</size></box></geometry></collision>
        <visual name="sidewalk_l_south_vis"><pose>98.5 11.25 0.08 0 0 0</pose><geometry><box><size>197 4.5 0.16</size></box></geometry><material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>
        <!-- 左側中段 (X: 211 ~ 344, 長 133m, 正對關新公園) -->
        <collision name="sidewalk_l_mid_col"><pose>277.5 11.25 0.08 0 0 0</pose><geometry><box><size>133 4.5 0.16</size></box></geometry></collision>
        <visual name="sidewalk_l_mid_vis"><pose>277.5 11.25 0.08 0 0 0</pose><geometry><box><size>133 4.5 0.16</size></box></geometry><material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>
        <!-- 左側北段 (X: 358 ~ 410, 長 52m) -->
        <collision name="sidewalk_l_north_col"><pose>384 11.25 0.08 0 0 0</pose><geometry><box><size>52 4.5 0.16</size></box></geometry></collision>
        <visual name="sidewalk_l_north_vis"><pose>384 11.25 0.08 0 0 0</pose><geometry><box><size>52 4.5 0.16</size></box></geometry><material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>

        <!-- 【右側人行道 (商圈與公園側 Y: -13.5 ~ -9.0, 寬 4.5m, 高 0.15m)】 -->
        <!-- 右側南段 1 (POYA 門前 X: 0 ~ 80, 長 80m) -->
        <collision name="sidewalk_r_poya_col"><pose>40 -11.25 0.08 0 0 0</pose><geometry><box><size>80 4.5 0.16</size></box></geometry></collision>
        <visual name="sidewalk_r_poya_vis"><pose>40 -11.25 0.08 0 0 0</pose><geometry><box><size>80 4.5 0.16</size></box></geometry><material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>
        <!-- 麥當勞得來速入口斜坡斜降斷口 (X: 80 ~ 86，平坦以供進車) -->
        <!-- 右側南段 2 (麥當勞正門前 X: 86 ~ 122, 長 36m) -->
        <collision name="sidewalk_r_mcd_col"><pose>104 -11.25 0.08 0 0 0</pose><geometry><box><size>36 4.5 0.16</size></box></geometry></collision>
        <visual name="sidewalk_r_mcd_vis"><pose>104 -11.25 0.08 0 0 0</pose><geometry><box><size>36 4.5 0.16</size></box></geometry><material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>
        <!-- 麥當勞得來速出口斜坡斜降斷口 (X: 122 ~ 128) -->
        <!-- 右側南段 3 (國泰銀行/康是美/星巴克門前 X: 128 ~ 197, 長 69m) -->
        <collision name="sidewalk_r_sbux_col"><pose>162.5 -11.25 0.08 0 0 0</pose><geometry><box><size>69 4.5 0.16</size></box></geometry></collision>
        <visual name="sidewalk_r_sbux_vis"><pose>162.5 -11.25 0.08 0 0 0</pose><geometry><box><size>69 4.5 0.16</size></box></geometry><material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>
        <!-- 紅色鋪磚裝飾飾帶 (Red Pavers, 如 Street_photo2 & 7 所示) -->
        <visual name="sidewalk_red_pavers"><pose>162.5 -12.8 0.162 0 0 0</pose><geometry><box><size>69 1.4 0.002</size></box></geometry><material><ambient>0.6 0.28 0.22 1</ambient><diffuse>0.65 0.3 0.25 1</diffuse></material></visual>

        <!-- 右側中段 (關新公園人行道 X: 211 ~ 344, 長 133m) -->
        <collision name="sidewalk_r_park_col"><pose>277.5 -11.25 0.08 0 0 0</pose><geometry><box><size>133 4.5 0.16</size></box></geometry></collision>
        <visual name="sidewalk_r_park_vis"><pose>277.5 -11.25 0.08 0 0 0</pose><geometry><box><size>133 4.5 0.16</size></box></geometry><material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>

        <!-- 右側北段 (關新北路以北 X: 358 ~ 410, 長 52m) -->
        <collision name="sidewalk_r_north_col"><pose>384 -11.25 0.08 0 0 0</pose><geometry><box><size>52 4.5 0.16</size></box></geometry></collision>
        <visual name="sidewalk_r_north_vis"><pose>384 -11.25 0.08 0 0 0</pose><geometry><box><size>52 4.5 0.16</size></box></geometry><material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>

        <!-- 機車路邊停車格 (Scooter Parking Bays, 藍底白框, 如 Street_photo2 & 6 所示) -->
        <visual name="scooter_bays_sbux"><pose>182 -8.3 0.024 0 0 0</pose><geometry><box><size>18 1.4 0.002</size></box></geometry><material><ambient>0.15 0.35 0.7 1</ambient><diffuse>0.2 0.45 0.8 1</diffuse></material></visual>
        <visual name="scooter_bays_park"><pose>230 -8.3 0.024 0 0 0</pose><geometry><box><size>22 1.4 0.002</size></box></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse></material></visual>

        <!-- 沿街行道樹 (Street Trees - 小葉欖仁/樟樹) -->
        <!-- 樹木 X=30 右側 -->
        <visual name="tree_r_30_trunk"><pose>30 -12.5 2.0 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.15 1</ambient><diffuse>0.35 0.25 0.18 1</diffuse></material></visual>
        <visual name="tree_r_30_leaves"><pose>30 -12.5 4.8 0 0 0</pose><geometry><sphere><radius>2.2</radius></sphere></geometry><material><ambient>0.15 0.45 0.15 1</ambient><diffuse>0.2 0.55 0.2 1</diffuse></material></visual>
        <!-- 樹木 X=30 左側 -->
        <visual name="tree_l_30_trunk"><pose>30 12.5 2.0 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.15 1</ambient><diffuse>0.35 0.25 0.18 1</diffuse></material></visual>
        <visual name="tree_l_30_leaves"><pose>30 12.5 4.8 0 0 0</pose><geometry><sphere><radius>2.2</radius></sphere></geometry><material><ambient>0.15 0.45 0.15 1</ambient><diffuse>0.2 0.55 0.2 1</diffuse></material></visual>
        <!-- 樹木 X=60 右側 -->
        <visual name="tree_r_60_trunk"><pose>60 -12.5 2.0 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.15 1</ambient><diffuse>0.35 0.25 0.18 1</diffuse></material></visual>
        <visual name="tree_r_60_leaves"><pose>60 -12.5 4.8 0 0 0</pose><geometry><sphere><radius>2.2</radius></sphere></geometry><material><ambient>0.15 0.45 0.15 1</ambient><diffuse>0.2 0.55 0.2 1</diffuse></material></visual>
        <!-- 樹木 X=60 左側 -->
        <visual name="tree_l_60_trunk"><pose>60 12.5 2.0 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.15 1</ambient><diffuse>0.35 0.25 0.18 1</diffuse></material></visual>
        <visual name="tree_l_60_leaves"><pose>60 12.5 4.8 0 0 0</pose><geometry><sphere><radius>2.2</radius></sphere></geometry><material><ambient>0.15 0.45 0.15 1</ambient><diffuse>0.2 0.55 0.2 1</diffuse></material></visual>
        <!-- 樹木 X=100 右側 -->
