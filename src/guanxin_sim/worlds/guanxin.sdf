          <pose>-6 0 5 0 0 0</pose>
          <geometry><box><size>4 50 10</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>

        <!-- ==================== 新莊火車站 (Xinzhuang Station) ==================== -->
        <collision name="xinzhuang_station_col">
          <pose>408 0 8 0 0 0</pose>
          <geometry><box><size>10 70 16</size></box></geometry>
        </collision>
        <visual name="xinzhuang_station_vis">
          <pose>408 0 8 0 0 0</pose>
          <geometry><box><size>10 70 16</size></box></geometry>
          <material><ambient>0.28 0.35 0.45 1</ambient><diffuse>0.32 0.40 0.52 1</diffuse></material>
        </visual>
        <visual name="station_canopy">
          <pose>402 0 6 0 0 0</pose>
          <geometry><box><size>4 30 0.5</size></box></geometry>
          <material><ambient>0.15 0.2 0.3 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 載入 Tesla Model Y 載具 ==================== -->
    <include>
      <name>model_y</name>
      <uri>model://model_y</uri>
      <!-- 起始位置位於光復路與關新路口中央，車頭朝向新莊車站 (+X 方向) -->
      <pose>5 0 0.38 0 0 0</pose>
    </include>

  </world>
</sdf>
