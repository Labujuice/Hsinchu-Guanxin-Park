        <!-- ==================== 上方 4 棟 20 層豪華現代住宅塔樓 (昌益丹麥/芬蘭/豐邑一極風格) ==================== -->
        <!-- 住宅大樓 1 (Tower 1 - 康是美上方) -->
        <collision name="tower_col_1"><pose>133 -34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry></collision>
        <visual name="tower_vis_1"><pose>133 -34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry><material><ambient>0.82 0.80 0.77 1</ambient><diffuse>0.85 0.83 0.80 1</diffuse></material></visual>
        <!-- 陽台層次凹槽與深色玻璃 (Balconies) -->
        <visual name="tower_balconies_1"><pose>133 -20.8 32 0 0 0</pose><geometry><box><size>24 0.5 28</size></box></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse></material></visual>
        <!-- 頂部現代景觀屋突天際線冠頂 (Rooftop Crown Pergola) -->
        <visual name="tower_crown_1"><pose>133 -34 49 0 0 0</pose><geometry><box><size>24 22 2.5</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>

        <!-- 住宅大樓 2 (Tower 2 - 麥當勞上方) -->
        <collision name="tower_col_2"><pose>170 -34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry></collision>
        <visual name="tower_vis_2"><pose>170 -34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry><material><ambient>0.82 0.80 0.77 1</ambient><diffuse>0.85 0.83 0.80 1</diffuse></material></visual>
        <visual name="tower_balconies_2"><pose>170 -20.8 32 0 0 0</pose><geometry><box><size>24 0.5 28</size></box></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse></material></visual>
        <visual name="tower_crown_2"><pose>170 -34 49 0 0 0</pose><geometry><box><size>24 22 2.5</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>

        <!-- 住宅大樓 3 (Tower 3 - 星巴克日光門市上方) -->
        <collision name="tower_col_3"><pose>203 -34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry></collision>
        <visual name="tower_vis_3"><pose>203 -34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry><material><ambient>0.82 0.80 0.77 1</ambient><diffuse>0.85 0.83 0.80 1</diffuse></material></visual>
        <visual name="tower_balconies_3"><pose>203 -20.8 32 0 0 0</pose><geometry><box><size>24 0.5 28</size></box></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse></material></visual>
        <visual name="tower_crown_3"><pose>203 -34 49 0 0 0</pose><geometry><box><size>24 22 2.5</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>

        <!-- 住宅大樓 4 (Tower 4 - 美食餐廳街上方) -->
        <collision name="tower_col_4"><pose>240 -34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry></collision>
        <visual name="tower_vis_4"><pose>240 -34 32 0 0 0</pose><geometry><box><size>28 26 32</size></box></geometry><material><ambient>0.82 0.80 0.77 1</ambient><diffuse>0.85 0.83 0.80 1</diffuse></material></visual>
        <visual name="tower_balconies_4"><pose>240 -20.8 32 0 0 0</pose><geometry><box><size>24 0.5 28</size></box></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse></material></visual>
        <visual name="tower_crown_4"><pose>240 -34 49 0 0 0</pose><geometry><box><size>24 22 2.5</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>

        <!-- 東側南段建築群 (光復路至公園前 X: 0 ~ 115) -->
        <collision name="bldg_east_south_col">
