<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="monument_lcd_microled">
    <static>true</static>
    <link name="monument_link">
      <collision name="col">
        <pose>0 0 3.0 0 0 0</pose>
        <geometry><box><size>7.6 4.6 6.0</size></box></geometry>
      </collision>

      <!-- 1. 鈦合金金屬拉絲科技基座 (Titanium Brushed Base) -->
      <visual name="plinth_base">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry><box><size>7.6 4.6 1.0</size></box></geometry>
        <material>
          <ambient>0.24 0.26 0.28 1</ambient>
          <diffuse>0.32 0.35 0.38 1</diffuse>
          <specular>0.85 0.85 0.9 1</specular>
        </material>
      </visual>
      <visual name="plinth_rgb_ring">
        <pose>0 0 1.01 0 0 0</pose>
        <geometry><box><size>7.2 4.2 0.04</size></box></geometry>
        <material>
          <ambient>0.9 0.2 0.6 1</ambient>
          <diffuse>1.0 0.3 0.8 1</diffuse>
          <emissive>0.8 0.2 0.6 1</emissive>
        </material>
      </visual>

      <!-- 2. 曲面超薄高畫質 Micro-LED 顯示主牆 (Curved Micro-LED Screen) -->
      <visual name="screen_main">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><box><size>6.0 0.5 4.5</size></box></geometry>
        <material>
          <ambient>0.08 0.12 0.18 1</ambient>
          <diffuse>0.12 0.18 0.26 1</diffuse>
          <specular>0.98 0.98 1.0 1</specular>
        </material>
      </visual>

      <!-- 3. RGB 光電三原色與微型像素陣列光雕 (Micro-LED Subpixel Ribbons) -->
      <!-- 紅色次像素帶 (Red Subpixels) -->
      <visual name="rgb_strip_r">
        <pose>-1.8 0.26 3.5 0 0 0</pose>
        <geometry><box><size>1.6 0.04 4.1</size></box></geometry>
        <material>
          <ambient>0.9 0.1 0.1 1</ambient>
          <diffuse>1.0 0.15 0.15 1</diffuse>
          <emissive>0.8 0.1 0.1 1</emissive>
        </material>
      </visual>
      <!-- 綠色次像素帶 (Green Subpixels) -->
      <visual name="rgb_strip_g">
        <pose>0 0.26 3.5 0 0 0</pose>
        <geometry><box><size>1.6 0.04 4.1</size></box></geometry>
        <material>
          <ambient>0.1 0.9 0.2 1</ambient>
          <diffuse>0.15 1.0 0.3 1</diffuse>
          <emissive>0.1 0.8 0.2 1</emissive>
        </material>
      </visual>
      <!-- 藍色次像素帶 (Blue Subpixels) -->
      <visual name="rgb_strip_b">
        <pose>1.8 0.26 3.5 0 0 0</pose>
        <geometry><box><size>1.6 0.04 4.1</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.95 1</ambient>
          <diffuse>0.15 0.4 1.0 1</diffuse>
          <emissive>0.1 0.3 0.9 1</emissive>
        </material>
      </visual>

      <!-- 4. 側翼半透明 OLED 展翼面板 (Transparent OLED Wings) -->
      <visual name="wing_left">
        <pose>-3.4 -0.3 3.5 0 0 0.35</pose>
        <geometry><box><size>1.6 0.15 4.2</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.45 0.75</ambient>
          <diffuse>0.20 0.45 0.60 0.75</diffuse>
          <specular>1 1 1 1</specular>
        </material>
      </visual>
      <visual name="wing_right">
        <pose>3.4 -0.3 3.5 0 0 -0.35</pose>
        <geometry><box><size>1.6 0.15 4.2</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.45 0.75</ambient>
          <diffuse>0.20 0.45 0.60 0.75</diffuse>
          <specular>1 1 1 1</specular>
        </material>
      </visual>

      <!-- 5. 金屬銘牌銘文 (友達・群創・晶電・光電科技之窗) -->
      <visual name="lcd_plaque">
        <pose>0 2.32 0.5 0 0 0</pose>
        <geometry><box><size>4.8 0.05 0.5</size></box></geometry>
        <material>
          <ambient>0.75 0.55 0.15 1</ambient>
          <diffuse>0.90 0.70 0.20 1</diffuse>
          <specular>0.9 0.8 0.4 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
