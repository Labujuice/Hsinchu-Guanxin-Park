<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="telecom_box">
    <static>true</static>
    <link name="box_link">

      <!-- 物理碰撞剛體 (單一 Box 幾何) -->
      <collision name="box_col">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><box><size>0.8 0.5 1.1</size></box></geometry>
      </collision>

      <!-- 視覺：混凝土基座 (Concrete Base) -->
      <visual name="base">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry><box><size>0.85 0.55 0.16</size></box></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.68 0.68 0.70 1</diffuse></material>
      </visual>

      <!-- 視覺：中信灰烤漆金屬箱體 (Light Industrial Grey Metal) -->
      <visual name="cabinet">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry><box><size>0.78 0.48 0.95</size></box></geometry>
        <material><ambient>0.70 0.72 0.74 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material>
      </visual>

      <!-- 視覺：頂蓋微斜防雨頂板 (Weatherproof Slanted Roof) -->
      <visual name="roof">
        <pose>0 0 1.10 0 0.05 0</pose>
        <geometry><box><size>0.82 0.52 0.06</size></box></geometry>
        <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.62 0.64 0.68 1</diffuse></material>
      </visual>

      <!-- 視覺：中華電信企業藍標牌 (Chunghwa Telecom Blue Emblem) -->
      <visual name="emblem">
        <pose>0 0.245 0.85 0 0 0</pose>
        <geometry><box><size>0.22 0.01 0.14</size></box></geometry>
        <material><ambient>0.05 0.35 0.75 1</ambient><diffuse>0.08 0.45 0.85 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
