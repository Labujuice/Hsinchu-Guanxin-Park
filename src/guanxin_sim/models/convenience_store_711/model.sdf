        <geometry><box><size>0.6 0.05 0.45</size></box></geometry>
        <material>
          <ambient>0.2 0.8 0.9 1</ambient>
          <diffuse>0.3 0.9 1.0 1</diffuse>
          <emissive>0.6 0.9 1.0 1</emissive>
        </material>
      </visual>

      <!-- ==================== 經典雙面立式高空發光招牌立柱 (Pylon Sign Tower) ==================== -->
      <visual name="pylon_pole">
        <pose>8.5 7.2 3.5 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>7.0</length></cylinder></geometry>
        <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.48 0.50 0.52 1</diffuse></material>
      </visual>
      <!-- 高空發光大燈箱 (High-mast Lightbox) -->
      <visual name="pylon_lightbox">
