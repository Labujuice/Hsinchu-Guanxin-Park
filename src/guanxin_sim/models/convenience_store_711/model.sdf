      <visual name="pylon_orange_stripe">
        <pose>8.5 7.2 7.15 0 0 0</pose>
        <geometry><box><size>1.62 0.36 0.4</size></box></geometry>
        <material><ambient>0.95 0.44 0.13 1</ambient><diffuse>0.98 0.48 0.15 1</diffuse><emissive>0.7 0.3 0.08 1</emissive></material>
      </visual>
      <visual name="pylon_green_stripe">
        <pose>8.5 7.2 6.55 0 0 0</pose>
        <geometry><box><size>1.62 0.36 0.4</size></box></geometry>
        <material><ambient>0.0 0.52 0.24 1</ambient><diffuse>0.0 0.58 0.28 1</diffuse><emissive>0.0 0.4 0.18 1</emissive></material>
      </visual>
      <visual name="pylon_red_stripe">
        <pose>8.5 7.2 5.95 0 0 0</pose>
        <geometry><box><size>1.62 0.36 0.4</size></box></geometry>
        <material><ambient>0.90 0.11 0.14 1</ambient><diffuse>0.95 0.14 0.16 1</diffuse><emissive>0.7 0.1 0.12 1</emissive></material>
      </visual>
    </link>
  </model>
</sdf>
