<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="convenience_store_711">
    <static>true</static>
    <link name="store_link">

      <!-- ==================== 物理碰撞剛體 (Decoupled Primitives) ==================== -->
      <!-- 主量體剛體 (16m x 12m x 4.8m) -->
      <collision name="store_col">
        <pose>0 0 2.4 0 0 0</pose>
        <geometry><box><size>16.0 12.0 4.8</size></box></geometry>
      </collision>
      <!-- 立式獨立高空招牌立柱剛體 -->
      <collision name="pylon_pole_col">
        <pose>8.5 7.2 3.5 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>7.0</length></cylinder></geometry>
      </collision>

      <!-- ==================== 視覺主體：7-ELEVEN 建築本體 ==================== -->
      <visual name="store_walls">
        <pose>0 0 2.4 0 0 0</pose>
        <geometry><box><size>16.0 12.0 4.8</size></box></geometry>
        <material>
          <ambient>0.88 0.88 0.88 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
        </material>
      </visual>

      <!-- 頂部女兒牆收邊 (Parapet Cap) -->
      <visual name="roof_trim">
        <pose>0 0 4.85 0 0 0</pose>
        <geometry><box><size>16.3 12.3 0.15</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>

      <!-- ==================== 7-ELEVEN 台灣特色高清擬真店招與門面 (Photo-Real PBR Signboards) ==================== -->
      <!-- 1. 正面橫式發光主招牌 (Fascia Signboard: 15.0m x 1.4m, 比例 10.71:1 完全吻合 1500x140 貼圖) -->
      <visual name="seven_fascia_vis">
        <pose>0 6.08 4.0 0 0 0</pose>
        <geometry><box><size>15.0 0.12 1.4</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.45 0.45 0.45 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://convenience_store_711/materials/textures/seven_eleven_fascia_sign.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 2. 店面落地大片採光玻璃與自動門 (Storefront Glass Curtain & Automatic Doors) -->
      <visual name="storefront_glass">
        <pose>0 6.04 1.6 0 0 0</pose>
        <geometry><box><size>15.0 0.08 3.2</size></box></geometry>
        <material>
          <ambient>0.2 0.35 0.4 0.85</ambient>
          <diffuse>0.3 0.45 0.5 0.85</diffuse>
          <specular>0.9 0.95 1.0 1</specular>
        </material>
      </visual>
      <!-- 自動門深灰色金屬門框 (Door Frame) -->
      <visual name="storefront_doorframe">
        <pose>0 6.07 1.6 0 0 0</pose>
        <geometry><box><size>3.6 0.1 3.2</size></box></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>

      <!-- 3. 建築側懸直立雙面發光店招 (Protruding Blade Signboard: 0.8m x 1.6m, 比例 1:2 吻合 512x1024 貼圖) -->
      <visual name="seven_blade_vis">
        <pose>7.9 6.2 3.6 0 0 1.5708</pose>
        <geometry><box><size>0.8 0.12 1.6</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.5 0.5 0.5 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://convenience_store_711/materials/textures/seven_eleven_blade_sign.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- ==================== 經典雙面立式高空發光招牌立柱 (Pylon Sign Tower) ==================== -->
      <visual name="pylon_pole">
        <pose>8.5 7.2 3.5 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>7.0</length></cylinder></geometry>
        <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.48 0.50 0.52 1</diffuse></material>
      </visual>

      <!-- 高空發光大燈箱 (High-mast Lightbox: 1.0m x 2.0m, 比例 1:2 完全吻合 512x1024 貼圖) -->
      <visual name="pylon_lightbox">
        <pose>8.5 7.2 6.5 0 0 1.5708</pose>
        <geometry><box><size>1.0 0.25 2.0</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.55 0.55 0.55 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://convenience_store_711/materials/textures/seven_eleven_blade_sign.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- ==================== 台灣特色：頂樓不鏽鋼白鐵水塔 (Stainless Steel Water Tank) ==================== -->
      <!-- 水塔角鋼腳架 -->
      <visual name="water_tank_stand">
        <pose>-5.0 -3.0 5.1 0 0 0</pose>
        <geometry><box><size>1.8 1.8 0.4</size></box></geometry>
        <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material>
      </visual>
      <!-- 白鐵水塔桶身 (直徑 1.6m, 高 1.8m) -->
      <visual name="water_tank_body">
        <pose>-5.0 -3.0 6.2 0 0 0</pose>
        <geometry><cylinder><radius>0.80</radius><length>1.80</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr>
            <metal>
              <roughness>0.15</roughness>
              <metalness>0.88</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- 白鐵水塔圓拱頂蓋 -->
      <visual name="water_tank_dome">
        <pose>-5.0 -3.0 7.15 0 0 0</pose>
        <geometry><sphere><radius>0.82</radius></sphere></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr>
            <metal>
              <roughness>0.15</roughness>
              <metalness>0.88</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
