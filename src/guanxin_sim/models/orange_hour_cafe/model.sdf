<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="orange_hour_cafe">
    <static>true</static>
    <link name="cafe_link">

      <!-- Collision -->
      <collision name="cafe_col">
        <pose>0 0 4.0 0 0 0</pose>
        <geometry><box><size>20.0 14.0 8.0</size></box></geometry>
      </collision>

      <!-- 2F 現代暖木與清水模主建物 (Cafe Building) -->
      <visual name="cafe_body">
        <pose>0 0 4.0 0 0 0</pose>
        <geometry><box><size>19.8 13.8 8.0</size></box></geometry>
        <material>
          <ambient>0.82 0.80 0.76 1</ambient>
          <diffuse>0.88 0.86 0.82 1</diffuse>
        </material>
      </visual>

      <!-- 轉角全景落地大玻璃窗 (東向臨關新路 Y=+7m, 北向臨關新二街 X=+10m) -->
      <visual name="glass_front">
        <pose>0 7.02 3.8 0 0 0</pose>
        <geometry><box><size>18.0 0.1 7.2</size></box></geometry>
        <material><ambient>0.15 0.3 0.4 0.85</ambient><diffuse>0.2 0.38 0.5 0.85</diffuse><specular>0.9 0.95 1 1</specular></material>
      </visual>
      <visual name="glass_side">
        <pose>9.92 0 3.8 0 0 0</pose>
        <geometry><box><size>0.1 12.0 7.2</size></box></geometry>
        <material><ambient>0.15 0.3 0.4 0.85</ambient><diffuse>0.2 0.38 0.5 0.85</diffuse><specular>0.9 0.95 1 1</specular></material>
      </visual>

      <!-- 橘時咖啡暖橘色招牌橫幅 (Orange Canopy & Sign) -->
      <visual name="orange_canopy_front">
        <pose>0 7.3 4.2 0 0 0</pose>
        <geometry><box><size>18.5 0.6 0.4</size></box></geometry>
        <material><ambient>0.92 0.45 0.05 1</ambient><diffuse>0.98 0.52 0.08 1</diffuse></material>
      </visual>
      <visual name="orange_canopy_side">
        <pose>10.2 0 4.2 0 0 0</pose>
        <geometry><box><size>0.6 12.5 0.4</size></box></geometry>
        <material><ambient>0.92 0.45 0.05 1</ambient><diffuse>0.98 0.52 0.08 1</diffuse></material>
      </visual>
      <visual name="cafe_sign_front">
        <pose>0 7.62 4.2 0 0 0</pose>
        <geometry><box><size>12.0 0.05 0.35</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material>
      </visual>

      <!-- 戶外露天木質休閒平台 (Outdoor Deck on Corner) -->
      <visual name="deck_floor">
        <pose>3.0 9.5 0.1 0 0 0</pose>
        <geometry><box><size>12.0 4.5 0.2</size></box></geometry>
        <material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material>
      </visual>

      <!-- 戶外經典橘色遮陽傘與咖啡圓桌 1 (Umbrella Set 1) -->
      <visual name="cafe_table1"><pose>0.0 9.5 0.42 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>0.75</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual>
      <visual name="umbrella_pole1"><pose>0.0 9.5 1.25 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>2.5</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      <visual name="umbrella_top1"><pose>0.0 9.5 2.35 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>0.35</length></cylinder></geometry><material><ambient>0.95 0.48 0.08 1</ambient><diffuse>0.98 0.55 0.1 1</diffuse></material></visual>

      <!-- 戶外遮陽傘與咖啡圓桌 2 (Umbrella Set 2) -->
      <visual name="cafe_table2"><pose>5.0 9.5 0.42 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>0.75</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual>
      <visual name="umbrella_pole2"><pose>5.0 9.5 1.25 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>2.5</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      <visual name="umbrella_top2"><pose>5.0 9.5 2.35 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>0.35</length></cylinder></geometry><material><ambient>0.95 0.48 0.08 1</ambient><diffuse>0.98 0.55 0.1 1</diffuse></material></visual>

      <!-- 景觀常綠灌木花槽 (Planters) -->
      <visual name="planter_box"><pose>3.0 11.6 0.35 0 0 0</pose><geometry><box><size>12.0 0.35 0.6</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.35 1</diffuse></material></visual>
      <visual name="planter_hedges"><pose>3.0 11.6 0.7 0 0 0</pose><geometry><box><size>11.8 0.4 0.25</size></box></geometry><material><ambient>0.15 0.48 0.18 1</ambient><diffuse>0.2 0.58 0.22 1</diffuse></material></visual>

    </link>
  </model>
</sdf>
