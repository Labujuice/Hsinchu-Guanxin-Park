<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="fire_hydrant">
    <static>true</static>
    <link name="hydrant_link">

      <!-- 物理碰撞剛體 (圓柱體) -->
      <collision name="hydrant_col">
        <pose>0 0 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.84</length></cylinder></geometry>
      </collision>

      <!-- 視覺：消防栓主柱體 (Taiwan Safety Red High-gloss Enamel) -->
      <visual name="body">
        <pose>0 0 0.4 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.92 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <!-- 視覺：頂部圓頂蓋 (Dome Cap) -->
      <visual name="cap">
        <pose>0 0 0.82 0 0 0</pose>
        <geometry><sphere><radius>0.16</radius></sphere></geometry>
        <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.92 0.08 0.08 1</diffuse></material>
      </visual>

      <!-- 視覺：頂部五角開關操作螺母 (Pentagonal Operating Nut) -->
      <visual name="operating_nut">
        <pose>0 0 0.94 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.75 0.65 0.1 1</ambient><diffuse>0.85 0.75 0.15 1</diffuse></material>
      </visual>

      <!-- 視覺：雙向出水噴嘴 (Dual Brass Discharge Nozzles with Chains) -->
      <visual name="nozzle_l">
        <pose>-0.12 0 0.52 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.75 0.65 0.1 1</ambient><diffuse>0.85 0.75 0.15 1</diffuse></material>
      </visual>
      <visual name="nozzle_r">
        <pose>0.12 0 0.52 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.75 0.65 0.1 1</ambient><diffuse>0.85 0.75 0.15 1</diffuse></material>
      </visual>

      <!-- 視覺：地面法蘭底盤 (Flange Ring) -->
      <visual name="flange">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.22</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.38 0.38 0.4 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
