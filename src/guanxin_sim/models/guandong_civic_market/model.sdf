<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="guandong_civic_market">
    <static>true</static>
    <link name="market_link">
      <collision name="podium_col">
        <pose>0 0 10.0 0 0 0</pose>
        <geometry><box><size>48.0 36.0 20.0</size></box></geometry>
      </collision>

      <!-- 關東市場主體結構 (4F 複合式公有市場與客家文化會館) -->
      <visual name="market_main">
        <pose>0 0 10.0 0 0 0</pose>
        <geometry><box><size>48.0 36.0 20.0</size></box></geometry>
        <material>
          <ambient>0.68 0.66 0.62 1</ambient>
          <diffuse>0.76 0.74 0.70 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- ==================== 關東公有零售市場 台灣特色高清擬真主體與店招 (Photo-Real PBR) ==================== -->
      <!-- 正門上方超大型發光主招牌 (Civic Market Marquee Sign: 24.0m x 3.0m, 比例 8:1 完全吻合 1600x200 貼圖) -->
      <visual name="market_sign_vis">
        <pose>0 18.20 7.2 0 0 0</pose>
        <geometry><box><size>24.0 0.18 3.0</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.45 0.45 0.45 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://guandong_civic_market/materials/textures/guandong_market_sign.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 傳統早市 1F 延伸遮雨遮陽棚 (Market Stall Extended Canopy: 延伸 2.5m) -->
      <visual name="market_morning_canopy">
        <pose>0 19.3 4.2 0.15 0 0</pose>
        <geometry><box><size>46.0 2.8 0.15</size></box></geometry>
        <material>
          <ambient>0.8 0.2 0.15 1</ambient>
          <diffuse>0.9 0.25 0.18 1</diffuse>
        </material>
      </visual>

      <!-- ==================== 台灣特色天際線：公有建築頂樓大型白鐵水塔雙組 ==================== -->
      <!-- 水塔 1 -->
      <visual name="water_tank_1_stand">
        <pose>-12.0 -6.0 20.4 0 0 0</pose>
        <geometry><box><size>2.4 2.4 0.5</size></box></geometry>
        <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material>
      </visual>
      <visual name="water_tank_1_body">
        <pose>-12.0 -6.0 21.6 0 0 0</pose>
        <geometry><cylinder><radius>1.1</radius><length>2.2</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr>
        </material>
      </visual>
      <visual name="water_tank_1_dome">
        <pose>-12.0 -6.0 22.75 0 0 0</pose>
        <geometry><sphere><radius>1.12</radius></sphere></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr>
        </material>
      </visual>

      <!-- 水塔 2 -->
      <visual name="water_tank_2_stand">
        <pose>12.0 -6.0 20.4 0 0 0</pose>
        <geometry><box><size>2.4 2.4 0.5</size></box></geometry>
        <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material>
      </visual>
      <visual name="water_tank_2_body">
        <pose>12.0 -6.0 21.6 0 0 0</pose>
        <geometry><cylinder><radius>1.1</radius><length>2.2</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr>
        </material>
      </visual>
      <visual name="water_tank_2_dome">
        <pose>12.0 -6.0 22.75 0 0 0</pose>
        <geometry><sphere><radius>1.12</radius></sphere></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr>
        </material>
      </visual>

      <!-- 屋頂中央空調冰水主機 (Rooftop HVAC Chiller) -->
      <visual name="rooftop_chiller">
        <pose>0 0 21.2 0 0 0</pose>
        <geometry><box><size>8.0 4.5 2.0</size></box></geometry>
        <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.48 0.50 0.52 1</diffuse></material>
      </visual>

    </link>
  </model>
</sdf>
