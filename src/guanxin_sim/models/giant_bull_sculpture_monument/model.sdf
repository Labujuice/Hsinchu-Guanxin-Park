      <!-- 4. 四隅科技多角股價圖騰紀念柱 (Obelisks) -->
      <visual name="obelisk_fl"><pose>8.5 4.5 2.2 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>2.4</length></cylinder></geometry><material><ambient>0.65 0.48 0.18 1</ambient><diffuse>0.82 0.62 0.22 1</diffuse></material></visual>
      <visual name="obelisk_fl_cap"><pose>8.5 4.5 3.6 0 0 0</pose><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.9 0.8 0.2 1</ambient><diffuse>0.95 0.85 0.3 1</diffuse><specular>1 1 0.6 1</specular></material></visual>

