      <visual name="obelisk_rl_cap"><pose>-8.5 4.5 3.6 0 0 0</pose><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.9 0.8 0.2 1</ambient><diffuse>0.95 0.85 0.3 1</diffuse><specular>1 1 0.6 1</specular></material></visual>

