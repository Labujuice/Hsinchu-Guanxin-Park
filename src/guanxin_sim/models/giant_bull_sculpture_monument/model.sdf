      <!-- ==================== 華爾街・竹科神牛青銅雕塑本體 (Monumental Bull Anatomy) ==================== -->
      <!-- 材質：金光璀璨、氣勢如虹的鍛面金銅 (Burnished Golden-Bronze Patina) -->

      <!-- [A] 軀幹 (Torso & Withers): 寬闊結實的牛背、充滿爆發力的胸腔與肩峰 -->
      <!-- 1. 前胸核心胸腔 (Chest Core) -->
      <visual name="bull_chest_main">
        <pose>0.8 0 4.7 0 0.12 0</pose>
        <geometry><box><size>5.8 4.2 3.6</size></box></geometry>
        <material>
          <ambient>0.68 0.48 0.16 1</ambient>
          <diffuse>0.86 0.64 0.22 1</diffuse>
          <specular>0.95 0.85 0.40 1</specular>
        </material>
      </visual>
      <!-- 2. 隆起的強健肩峰 (Muscular Shoulder Hump / Withers - 象徵高昂動能) -->
      <visual name="bull_withers_hump">
        <pose>2.1 0 5.8 0 -0.15 0</pose>
        <geometry><box><size>3.8 3.8 2.2</size></box></geometry>
        <material>
          <ambient>0.70 0.50 0.18 1</ambient>
          <diffuse>0.88 0.66 0.24 1</diffuse>
          <specular>0.95 0.85 0.40 1</specular>
        </material>
      </visual>
      <!-- 3. 後背脊柱延伸段與強韌側腹 (Rear Torso & Flank) -->
      <visual name="bull_torso_rear">
        <pose>-2.2 0 4.8 0 -0.08 0</pose>
        <geometry><box><size>4.5 3.6 3.2</size></box></geometry>
        <material>
          <ambient>0.68 0.48 0.16 1</ambient>
          <diffuse>0.86 0.64 0.22 1</diffuse>
          <specular>0.95 0.85 0.40 1</specular>
        </material>
      </visual>
      <!-- 4. 健碩發達的牛臀部 (Muscular Rump / Quarters) -->
      <visual name="bull_rump">
        <pose>-4.0 0 4.9 0 -0.18 0</pose>
        <geometry><box><size>3.5 3.9 3.3</size></box></geometry>
        <material>
          <ambient>0.68 0.48 0.16 1</ambient>
          <diffuse>0.86 0.64 0.22 1</diffuse>
          <specular>0.95 0.85 0.40 1</specular>
        </material>
