<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="giant_bull_sculpture_monument">
    <static>true</static>
    <link name="monument_link">
      <!-- ==================== 物理碰撞體 (Collision: 2 Boxes, Zero Overhead) ==================== -->
      <collision name="pedestal_col">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry><box><size>18.0 10.0 2.0</size></box></geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
        </surface>
      </collision>
      <collision name="bull_body_col">
        <pose>0 0 4.8 0 0 0</pose>
        <geometry><box><size>12.0 5.2 4.8</size></box></geometry>
      </collision>

      <!-- ==================== 基座與景觀鋪面 (Pedestal & Civic Plaza) ==================== -->
      <!-- 1. 底層八角形花崗岩景觀基底 (22m x 14m x 0.3m) -->
      <visual name="plaza_base">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>22.0 14.0 0.3</size></box></geometry>
        <material>
          <ambient>0.28 0.28 0.30 1</ambient>
          <diffuse>0.34 0.34 0.36 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <!-- 景觀地坪金色環形鑲邊飾帶 -->
      <visual name="plaza_gold_border">
        <pose>0 0 0.31 0 0 0</pose>
        <geometry><box><size>20.8 12.8 0.02</size></box></geometry>
        <material>
          <ambient>0.70 0.50 0.15 1</ambient>
          <diffuse>0.85 0.65 0.20 1</diffuse>
          <specular>0.9 0.8 0.3 1</specular>
        </material>
      </visual>

      <!-- 2. 主基座 (18m x 10m x 1.4m 頂級黑金石基座) -->
      <visual name="pedestal_main">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry><box><size>18.0 10.0 1.4</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.16 0.16 0.18 1</diffuse>
          <specular>0.8 0.8 0.85 1</specular>
        </material>
      </visual>
      <!-- 基座頂部黃金收邊飾條 -->
      <visual name="pedestal_gold_cornice">
        <pose>0 0 1.72 0 0 0</pose>
        <geometry><box><size>18.4 10.4 0.08</size></box></geometry>
        <material>
          <ambient>0.75 0.55 0.18 1</ambient>
          <diffuse>0.90 0.70 0.22 1</diffuse>
          <specular>0.95 0.85 0.4 1</specular>
        </material>
      </visual>
      <!-- 基座台頂踏面 (16m x 8m x 0.3m 鞍座) -->
      <visual name="pedestal_top_deck">
        <pose>0 0 1.88 0 0 0</pose>
