      <!-- 3. 基座紀念銘牌 (銘刻：新竹科學園區・科技神牛・牛市萬馬奔騰・千金科技・股價狂飆) -->
      <visual name="plaque_front">
        <pose>9.05 0 1.0 0 0 0</pose>
        <geometry><box><size>0.1 6.5 0.8</size></box></geometry>
        <material>
          <ambient>0.65 0.15 0.12 1</ambient>
          <diffuse>0.82 0.18 0.15 1</diffuse>
          <specular>0.9 0.7 0.3 1</specular>
