      </visual>
      <!-- 左右鼻孔細節 -->
      <visual name="bull_nostril_l"><pose>7.4 0.45 2.6 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="bull_nostril_r"><pose>7.4 -0.45 2.6 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>

