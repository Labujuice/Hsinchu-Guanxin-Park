        <material>
          <ambient>0.85 0.68 0.22 1</ambient>
          <diffuse>0.95 0.80 0.28 1</diffuse>
          <specular>0.98 0.90 0.50 1</specular>
        </material>
      </visual>
      <visual name="plaque_back">
