      <!-- ==================== 3. 臨關新路側懸星巴克雙尾美人魚圓形標誌 (Mounted Siren Medallion) ==================== -->
      <visual name="siren_sign_arm">
        <pose>-7.5 8.9 4.8 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.35 0.08</size>
          </box>
        </geometry>
