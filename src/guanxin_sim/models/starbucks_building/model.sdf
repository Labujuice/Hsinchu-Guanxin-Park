              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- (D) 門口上方輕型金屬雨遮 (Entrance Canopy) -->
      <visual name="entrance_canopy">
        <pose>6.8 8.95 3.45 0.1 0 0</pose>
