        <pose>-7.5 9.0 4.8 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.65</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
