<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="starbucks_building">
    <static>true</static>
    <link name="building_link">

      <!-- ==================== 1. 簡化剛體碰撞 (High-Performance Collisions) ==================== -->
      <!-- 主建物主體碰撞體 -->
      <collision name="main_bldg_col">
        <pose>-1.5 -1.5 4.25 0 0 0</pose>
        <geometry>
          <box>
            <size>20.0 14.5 8.5</size>
          </box>
        </geometry>
      </collision>

      <!-- 戶外露天木棧平台碰撞體 (可供行人與機器人行走) -->
      <collision name="terrace_deck_col">
        <pose>13.0 -2.0 0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>3.0 12.0 0.2</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- ==================== 2. 主建物外牆與高解析實景貼圖 (Real Photo Facades) ==================== -->
      <!-- (A) 臨關新路立面 (West Facade: 雙扇推門、陳列大櫥窗、STARBUCKS黑橫幅、黑木護牆板、2F Bagel網球遮陽棚) -->
      <visual name="west_facade_vis">
        <pose>-1.75 8.75 4.25 0 0 0</pose>
        <geometry>
          <box>
            <size>19.5 0.15 8.5</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://starbucks_building/materials/textures/sbux_west_facade.png</albedo_map>
              <roughness>0.4</roughness>
              <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- (B) 臨關新二街立面 (North Facade: 連續落地大玻璃窗、STARBUCKS黑條紋看板、2F Bagel網球工作室遮陽棚) -->
      <visual name="north_facade_vis">
        <pose>11.5 -1.75 4.25 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 14.0 8.5</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://starbucks_building/materials/textures/sbux_north_facade.png</albedo_map>
              <roughness>0.4</roughness>
              <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- (C) 45度導角轉角立面 (45-degree Chamfered Corner: 抿石子轉角立柱與黑底銅邊飾條) -->
      <visual name="corner_chamfer_vis">
        <pose>9.75 7.0 4.25 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>4.95 0.15 8.5</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.85 0.85 0.85 1</diffuse>
