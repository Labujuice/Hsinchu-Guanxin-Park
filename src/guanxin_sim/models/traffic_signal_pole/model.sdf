<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="traffic_signal_pole">
    <static>true</static>
    <link name="pole_link">
      <!-- 物理碰撞剛體 (僅垂直立桿圓柱) -->
      <collision name="pole_base_col">
        <pose>0 0 3.1 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.15</radius><length>6.2</length></cylinder>
        </geometry>
      </collision>

      <!-- 視覺呈現：鍍鋅金屬主立桿 (Galvanized Steel Vertical Pole) -->
      <visual name="vertical_pole_vis">
        <pose>0 0 3.1 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.14</radius><length>6.2</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.58 0.60 1</ambient>
          <diffuse>0.62 0.65 0.68 1</diffuse>
        </material>
      </visual>

      <!-- 視覺呈現：立桿底部黃黑斑馬警戒紋 (Yellow/Black Hazard Striping) -->
      <visual name="hazard_base_vis">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.15</radius><length>1.6</length></cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.8 0.1 1</ambient>
          <diffuse>0.95 0.85 0.1 1</diffuse>
        </material>
      </visual>

      <!-- 視覺呈現：水平懸臂橫桿 (Cantilever Arm Extending 4.5m) -->
      <visual name="cantilever_arm_vis">
        <pose>2.2 0 5.6 0 1.5707963 0</pose>
        <geometry>
          <cylinder><radius>0.10</radius><length>4.5</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.58 0.60 1</ambient>
          <diffuse>0.62 0.65 0.68 1</diffuse>
        </material>
      </visual>

      <!-- 視覺呈現：車道三色號誌箱背板 (3-Aspect Traffic Signal Visor Box) -->
      <visual name="signal_housing_vis">
        <pose>3.5 0 5.6 0 0 0</pose>
        <geometry>
          <box><size>1.3 0.35 0.45</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- 號誌三燈：紅燈 (Red Lens) -->
      <visual name="light_red">
        <pose>3.1 -0.18 5.6 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.14</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.05 0.05 1</ambient>
          <diffuse>1.0 0.1 0.1 1</diffuse>
          <emissive>0.9 0.1 0.1 1</emissive>
        </material>
      </visual>

      <!-- 號誌三燈：黃燈 (Yellow Lens) -->
      <visual name="light_yellow">
        <pose>3.5 -0.18 5.6 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.14</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.35 0.05 1</ambient>
          <diffuse>0.5 0.45 0.1 1</diffuse>
        </material>
      </visual>

      <!-- 號誌三燈：綠燈 (Green Lens) -->
      <visual name="light_green">
        <pose>3.9 -0.18 5.6 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.14</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.4 0.2 1</ambient>
          <diffuse>0.1 0.5 0.25 1</diffuse>
        </material>
      </visual>

      <!-- 視覺呈現：行人專用號誌燈 (小綠人/小紅人 Pedestrian Countdown Signal) -->
      <visual name="ped_signal_vis">
        <pose>0 -0.22 2.5 0 0 0</pose>
        <geometry>
          <box><size>0.25 0.18 0.55</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="ped_light_top">
        <pose>0 -0.32 2.65 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.1 0.1 1</ambient>
          <diffuse>0.95 0.1 0.1 1</diffuse>
          <emissive>0.8 0.1 0.1 1</emissive>
        </material>
      </visual>
      <visual name="ped_light_bot">
        <pose>0 -0.32 2.38 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.75 0.3 1</ambient>
          <diffuse>0.1 0.85 0.35 1</diffuse>
          <emissive>0.1 0.7 0.3 1</emissive>
        </material>
      </visual>

      <!-- 視覺呈現：台灣綠底白字路名牌 (Street Name Signs) -->
      <!-- 關新路路名牌 -->
      <visual name="street_name_gx">
        <pose>0.8 -0.05 4.8 0 0 0</pose>
        <geometry>
          <box><size>1.2 0.04 0.35</size></box>
        </geometry>
        <material>
          <ambient>0.05 0.45 0.22 1</ambient>
          <diffuse>0.08 0.55 0.26 1</diffuse>
          <emissive>0.05 0.25 0.12 1</emissive>
        </material>
      </visual>
      <!-- 關新二街路名牌 (側面垂直) -->
      <visual name="street_name_gx2nd">
        <pose>-0.05 0.8 4.6 0 0 1.5707963</pose>
        <geometry>
          <box><size>1.1 0.04 0.32</size></box>
        </geometry>
        <material>
          <ambient>0.05 0.45 0.22 1</ambient>
          <diffuse>0.08 0.55 0.26 1</diffuse>
          <emissive>0.05 0.25 0.12 1</emissive>
        </material>
      </visual>

      <!-- 視覺呈現：頂部 LED 路燈向下傾角燈具 (Overhead Streetlight Luminaire) -->
      <visual name="street_light_arm">
        <pose>1.0 0 6.6 0 0.35 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>1.8</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.58 0.60 1</ambient>
          <diffuse>0.62 0.65 0.68 1</diffuse>
        </material>
      </visual>
      <visual name="street_light_head">
        <pose>1.8 0 6.8 0 0.15 0</pose>
        <geometry>
          <box><size>0.6 0.25 0.12</size></box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
