<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="under_viaduct_linear_park">
    <static>true</static>
    <link name="park_link">


      <!-- 1. 橋下紅磚休閒漫步道地坪 (Interlocking Paver Promenade) -->
      <visual name="promenade_pave">
        <pose>0 0 0.075 0 0 0</pose>
        <geometry><box><size>100.0 8.5 0.15</size></box></geometry>
        <material>
          <ambient>0.56 0.38 0.30 1</ambient>
          <diffuse>0.64 0.44 0.35 1</diffuse>
        </material>
      </visual>

      <!-- 2. 中央休閒健身與兒童彈性安全地墊 (Rubber Safety Turf) -->
      <visual name="rubber_turf">
        <pose>0 0 0.085 0 0 0</pose>
        <geometry><box><size>40.0 6.5 0.02</size></box></geometry>
        <material>
          <ambient>0.20 0.45 0.65 1</ambient>
          <diffuse>0.25 0.55 0.78 1</diffuse>
        </material>
      </visual>

      <!-- 3. 雙人漫步機與健騎機 (Outdoor Fitness Walkers) -->
      <visual name="walker_1"><pose>-12.0 1.5 0.75 0 0 0</pose><geometry><box><size>1.6 1.1 1.3</size></box></geometry><material><ambient>0.85 0.65 0.05 1</ambient><diffuse>0.92 0.72 0.08 1</diffuse></material></visual>
      <visual name="walker_2"><pose>-8.0 1.5 0.75 0 0 0</pose><geometry><box><size>1.6 1.1 1.3</size></box></geometry><material><ambient>0.85 0.65 0.05 1</ambient><diffuse>0.92 0.72 0.08 1</diffuse></material></visual>
      <visual name="twister_1"><pose>-4.0 1.5 0.65 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry><material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.25 0.7 0.35 1</diffuse></material></visual>

      <!-- 4. 兒童搖搖樂與攀爬架 (Playground Spring Riders & Dome) -->
      <visual name="spring_rider_1"><pose>6.0 1.5 0.55 0 0 0</pose><geometry><box><size>0.9 0.45 0.75</size></box></geometry><material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.95 0.25 0.25 1</diffuse></material></visual>
      <visual name="spring_rider_2"><pose>10.0 1.5 0.55 0 0 0</pose><geometry><box><size>0.9 0.45 0.75</size></box></geometry><material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.95 0.8 0.15 1</diffuse></material></visual>
      <visual name="climb_arch"><pose>15.0 0 1.2 0 0 0</pose><geometry><cylinder><radius>1.8</radius><length>1.8</length></cylinder></geometry><material><ambient>0.8 0.3 0.6 1</ambient><diffuse>0.9 0.35 0.7 1</diffuse></material></visual>

      <!-- 5. 實木金屬休閒長椅 (Park Benches x 6) -->
      <visual name="bench_1"><pose>-35.0 -2.8 0.45 0 0 0</pose><geometry><box><size>2.2 0.65 0.45</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.52 0.34 0.18 1</diffuse></material></visual>
      <visual name="bench_2"><pose>-20.0 -2.8 0.45 0 0 0</pose><geometry><box><size>2.2 0.65 0.45</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.52 0.34 0.18 1</diffuse></material></visual>
      <visual name="bench_3"><pose>-5.0 -2.8 0.45 0 0 0</pose><geometry><box><size>2.2 0.65 0.45</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.52 0.34 0.18 1</diffuse></material></visual>
      <visual name="bench_4"><pose>10.0 -2.8 0.45 0 0 0</pose><geometry><box><size>2.2 0.65 0.45</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.52 0.34 0.18 1</diffuse></material></visual>
      <visual name="bench_5"><pose>25.0 -2.8 0.45 0 0 0</pose><geometry><box><size>2.2 0.65 0.45</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.52 0.34 0.18 1</diffuse></material></visual>
      <visual name="bench_6"><pose>40.0 -2.8 0.45 0 0 0</pose><geometry><box><size>2.2 0.65 0.45</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.52 0.34 0.18 1</diffuse></material></visual>

      <!-- 6. 灌木植栽花槽 (Green Planter Boxes) -->
      <visual name="planter_1"><pose>-40.0 3.2 0.4 0 0 0</pose><geometry><box><size>12.0 1.2 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      <visual name="shrub_1"><pose>-40.0 3.2 0.8 0 0 0</pose><geometry><box><size>11.6 0.9 0.5</size></box></geometry><material><ambient>0.15 0.5 0.18 1</ambient><diffuse>0.2 0.6 0.22 1</diffuse></material></visual>
      <visual name="planter_2"><pose>30.0 3.2 0.4 0 0 0</pose><geometry><box><size>12.0 1.2 0.5</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      <visual name="shrub_2"><pose>30.0 3.2 0.8 0 0 0</pose><geometry><box><size>11.6 0.9 0.5</size></box></geometry><material><ambient>0.15 0.5 0.18 1</ambient><diffuse>0.2 0.6 0.22 1</diffuse></material></visual>

      <!-- 7. 橋下景觀暖光矮柱燈 (Park Bollards x 6) -->
      <visual name="bollard_1"><pose>-30.0 3.6 0.45 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.9</length></cylinder></geometry><material><ambient>0.9 0.85 0.5 1</ambient><diffuse>1 0.95 0.6 1</diffuse><emissive>0.3 0.25 0.1 1</emissive></material></visual>
      <visual name="bollard_2"><pose>-15.0 3.6 0.45 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.9</length></cylinder></geometry><material><ambient>0.9 0.85 0.5 1</ambient><diffuse>1 0.95 0.6 1</diffuse><emissive>0.3 0.25 0.1 1</emissive></material></visual>
      <visual name="bollard_3"><pose>0.0 3.6 0.45 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.9</length></cylinder></geometry><material><ambient>0.9 0.85 0.5 1</ambient><diffuse>1 0.95 0.6 1</diffuse><emissive>0.3 0.25 0.1 1</emissive></material></visual>
      <visual name="bollard_4"><pose>15.0 3.6 0.45 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.9</length></cylinder></geometry><material><ambient>0.9 0.85 0.5 1</ambient><diffuse>1 0.95 0.6 1</diffuse><emissive>0.3 0.25 0.1 1</emissive></material></visual>
      <visual name="bollard_5"><pose>30.0 3.6 0.45 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.9</length></cylinder></geometry><material><ambient>0.9 0.85 0.5 1</ambient><diffuse>1 0.95 0.6 1</diffuse><emissive>0.3 0.25 0.1 1</emissive></material></visual>
      <visual name="bollard_6"><pose>45.0 3.6 0.45 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.9</length></cylinder></geometry><material><ambient>0.9 0.85 0.5 1</ambient><diffuse>1 0.95 0.6 1</diffuse><emissive>0.3 0.25 0.1 1</emissive></material></visual>
