        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr>
        </material>
