              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- ==================== 沿街側懸直立雙面發光店招 (Protruding Blade Signs) ==================== -->
      <!-- 店招 1：林記小籠包早餐店 (黃底紅字) -->
      <visual name="blade_sign_breakfast">
        <pose>-24.0 12.8 4.8 0 0 1.5708</pose>
        <geometry><box><size>1.4 0.12 2.0</size></box></geometry>
        <material>
          <ambient>0.95 0.85 0.1 1</ambient>
          <diffuse>1.0 0.9 0.1 1</diffuse>
          <emissive>0.7 0.6 0.05 1</emissive>
        </material>
      </visual>
      <!-- 店招 2：KYMCO 光陽機車行 (紅藍底白字) -->
      <visual name="blade_sign_kymco">
        <pose>-12.0 12.8 4.8 0 0 1.5708</pose>
        <geometry><box><size>1.4 0.12 2.0</size></box></geometry>
        <material>
          <ambient>0.9 0.1 0.15 1</ambient>
          <diffuse>0.95 0.15 0.18 1</diffuse>
          <emissive>0.7 0.1 0.1 1</emissive>
        </material>
      </visual>
      <!-- 店招 3：清心福全手搖飲 (經典翡翠綠) -->
      <visual name="blade_sign_tea">
        <pose>0.0 12.8 4.8 0 0 1.5708</pose>
        <geometry><box><size>1.4 0.12 2.0</size></box></geometry>
        <material>
          <ambient>0.0 0.55 0.35 1</ambient>
          <diffuse>0.0 0.65 0.4 1</diffuse>
          <emissive>0.0 0.6 0.35 1</emissive>
        </material>
      </visual>
      <!-- 店招 4：碳烤鹽酥雞 (大紅夜市招牌) -->
      <visual name="blade_sign_chicken">
        <pose>12.0 12.8 4.8 0 0 1.5708</pose>
        <geometry><box><size>1.4 0.12 2.0</size></box></geometry>
        <material>
          <ambient>0.88 0.15 0.1 1</ambient>
          <diffuse>0.95 0.2 0.12 1</diffuse>
          <emissive>0.7 0.15 0.08 1</emissive>
        </material>
      </visual>

      <!-- ==================== 台灣特色天際線：頂樓綠色鐵皮屋加蓋 (Turquoise Sheet Metal Penthouse) ==================== -->
      <visual name="rooftop_iron_house">
        <pose>0 0 24.5 0 0 0</pose>
        <geometry><box><size>38.0 14.0 3.0</size></box></geometry>
        <material>
          <ambient>0.12 0.48 0.36 1</ambient>
          <diffuse>0.18 0.58 0.44 1</diffuse>
          <pbr>
            <metal>
              <roughness>0.35</roughness>
              <metalness>0.7</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- 鐵皮屋斜坡浪板屋頂 (Sloped Metal Roof) -->
      <visual name="rooftop_iron_roof">
        <pose>0 0 26.15 0 0 0</pose>
        <geometry><box><size>39.0 14.8 0.3</size></box></geometry>
        <material>
          <ambient>0.10 0.42 0.32 1</ambient>
          <diffuse>0.15 0.52 0.38 1</diffuse>
          <pbr><metal><roughness>0.3</roughness><metalness>0.75</metalness></metal></pbr>
        </material>
