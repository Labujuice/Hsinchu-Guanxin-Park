<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="xinzhuang_street_block">
    <static>true</static>
    <link name="bldg_link">
      <collision name="podium_col">
        <pose>0 0 3.0 0 0 0</pose>
        <geometry><box><size>60.0 24.0 6.0</size></box></geometry>
      </collision>
      <collision name="tower_col">
        <pose>0 0 14.5 0 0 0</pose>
        <geometry><box><size>56.0 20.0 17.0</size></box></geometry>
      </collision>

      <!-- 1F 沿街騎樓基座 (Taiwanese Arcade Structure) -->
      <visual name="podium_base">
        <pose>0 0 3.0 0 0 0</pose>
        <geometry><box><size>60.0 24.0 6.0</size></box></geometry>
        <material>
          <ambient>0.42 0.40 0.38 1</ambient>
          <diffuse>0.50 0.48 0.45 1</diffuse>
        </material>
      </visual>

      <!-- 建築主體結構 (Building Main Structure) -->
      <visual name="tower_main">
        <pose>0 0 14.5 0 0 0</pose>
        <geometry><box><size>56.0 20.0 17.0</size></box></geometry>
        <material>
          <ambient>0.70 0.68 0.65 1</ambient>
          <diffuse>0.78 0.76 0.72 1</diffuse>
        </material>
      </visual>

      <!-- ==================== 新莊街老街 台灣特色連棟街屋高清擬真立面表皮 ==================== -->
      <!-- 包含：小籠包早餐店、光陽機車行、清心福全手搖飲、碳烤鹽酥雞、中醫診所、鐵窗、雨遮與冷氣室外機 -->
      <visual name="xinzhuang_old_street_facade_vis">
        <pose>0 10.06 11.5 0 0 0</pose>
        <geometry><box><size>56.0 0.10 23.0</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://xinzhuang_street_block/materials/textures/xinzhuang_old_street_facade.png</albedo_map>
              <roughness>0.42</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- ==================== 新莊街老街 4 大特色名店發光橫式店招 (Exact 8:1 Ratio PBR Shop Signs) ==================== -->
      <!-- 店招 1：林記老麵手工小籠包 (12.0m x 1.5m, 比例 8:1 完全吻合 1200x150 貼圖) -->
      <visual name="shop1_fascia_xiaolongbao">
        <pose>-18.0 12.08 4.8 0 0 0</pose>
        <geometry><box><size>12.0 0.14 1.5</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.45 0.45 0.45 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://xinzhuang_street_block/materials/textures/sign_xiaolongbao.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 店招 2：KYMCO 光陽機車行 (12.0m x 1.5m, 比例 8:1 完全吻合 1200x150 貼圖) -->
      <visual name="shop2_fascia_kymco">
        <pose>-6.0 12.08 4.8 0 0 0</pose>
        <geometry><box><size>12.0 0.14 1.5</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.45 0.45 0.45 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://xinzhuang_street_block/materials/textures/sign_kymco.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 店招 3：清心福全手搖飲 (12.0m x 1.5m, 比例 8:1 完全吻合 1200x150 貼圖) -->
      <visual name="shop3_fascia_chingshin">
        <pose>6.0 12.08 4.8 0 0 0</pose>
        <geometry><box><size>12.0 0.14 1.5</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.45 0.45 0.45 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://xinzhuang_street_block/materials/textures/sign_chingshin.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
