      <!-- 東向面向關新路之大景觀陽台 (Balconies facing Guanxin Rd) -->
      <visual name="front_balconies_vis">
        <pose>0 14.1 33.0 0 0 0</pose>
        <geometry><box><size>66.0 0.6 48.0</size></box></geometry>
        <material><ambient>0.26 0.28 0.30 1</ambient><diffuse>0.30 0.32 0.35 1</diffuse></material>
      </visual>

      <!-- 頂部造型冠頂女兒牆 (Roof Crown) -->
      <visual name="roof_crown">
        <pose>0 0 58.6 0 0 0</pose>
        <geometry><box><size>71.0 29.0 1.2</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
