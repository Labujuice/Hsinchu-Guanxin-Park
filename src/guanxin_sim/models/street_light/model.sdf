<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="street_light">
    <static>true</static>
    <link name="light_pole_link">

      <!-- 物理碰撞剛體 (僅垂直立桿圓柱) -->
      <collision name="pole_col">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>7.0</length></cylinder></geometry>
      </collision>

      <!-- 視覺：圓形地腳法蘭盤與螺栓基座 (Flanged Base Plinth) -->
      <visual name="base_plinth">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.24</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material>
      </visual>

      <!-- 視覺：熱浸鍍鋅錐形主鋼管立桿 (Tapered Galvanized Pole: 6.5m) -->
      <visual name="pole_shaft">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>6.8</length></cylinder></geometry>
        <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.72 0.74 0.76 1</diffuse></material>
      </visual>

      <!-- 視覺：立桿底部台電/市府維修孔蓋 (Handhole Cover) -->
      <visual name="handhole">
        <pose>0 0.11 0.75 0 0 0</pose>
        <geometry><box><size>0.12 0.02 0.35</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>

      <!-- 視覺：弧形延伸路燈懸臂 (Cantilever Outreach Arm: 延伸 2.0m 向 +Y 方向) -->
      <visual name="arm_curve">
        <pose>0 0.9 6.8 0.45 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>2.1</length></cylinder></geometry>
        <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.72 0.74 0.76 1</diffuse></material>
      </visual>

      <!-- 視覺：現代流線型 LED 路燈燈具本體 (Aerodynamic LED Luminaire) -->
      <visual name="luminaire_housing">
        <pose>0 1.8 7.3 0 0 0</pose>
        <geometry><box><size>0.28 0.75 0.12</size></box></geometry>
        <material><ambient>0.25 0.26 0.28 1</ambient><diffuse>0.30 0.32 0.35 1</diffuse></material>
      </visual>

      <!-- 視覺：高亮度 LED 透鏡自發光發光面 (Emissive LED Light Panel: 5000K Daylight) -->
      <visual name="led_lens_emissive">
        <pose>0 1.8 7.23 0 0 0</pose>
        <geometry><box><size>0.24 0.65 0.02</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.9 1</ambient>
          <diffuse>1.0 1.0 0.95 1</diffuse>
          <emissive>0.85 0.85 0.8 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
