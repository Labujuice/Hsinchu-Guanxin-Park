<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="street_light">
    <static>true</static>
    <link name="light_pole_link">

      <!-- 物理碰撞剛體 (僅垂直立桿圓柱) -->
      <collision name="pole_col">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>7.0</length></cylinder></geometry>
      </collision>

      <!-- 視覺：圓形地腳法蘭盤基座 (Flanged Base Plinth: R=0.24m) -->
