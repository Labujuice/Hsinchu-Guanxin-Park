<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="changyi_danmark_residence">
    <static>true</static>
    <link name="bldg_link">
      <collision name="podium_col">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><box><size>56.0 28.0 7.0</size></box></geometry>
      </collision>
      <collision name="tower_col">
        <pose>0 0 24.5 0 0 0</pose>
        <geometry><box><size>52.0 24.0 42.0</size></box></geometry>
      </collision>

      <!-- 1F 歐洲村石材基座與精品騎樓 -->
      <visual name="podium_base">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><box><size>56.0 28.0 7.0</size></box></geometry>
        <material>
          <ambient>0.62 0.58 0.52 1</ambient>
          <diffuse>0.70 0.65 0.58 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <visual name="shop_arcades">
        <pose>0 14.1 3.2 0 0 0</pose>
        <geometry><box><size>52.0 0.2 5.8</size></box></geometry>
        <material>
          <ambient>0.20 0.25 0.32 0.9</ambient>
          <diffuse>0.25 0.32 0.42 0.9</diffuse>
          <specular>0.9 0.95 1 1</specular>
        </material>
      </visual>

      <!-- 塔樓主體 (14F, 經典暖橘棕色二丁掛磚與米白框架) -->
      <visual name="tower_main">
        <pose>0 0 24.5 0 0 0</pose>
        <geometry><box><size>52.0 24.0 42.0</size></box></geometry>
        <material>
          <ambient>0.65 0.50 0.42 1</ambient>
          <diffuse>0.74 0.58 0.48 1</diffuse>
        </material>
      </visual>
      <!-- 景觀陽台外露立面 -->
      <visual name="balconies">
        <pose>0 12.3 26.0 0 0 0</pose>
        <geometry><box><size>48.0 0.8 32.0</size></box></geometry>
        <material>
          <ambient>0.75 0.74 0.72 1</ambient>
          <diffuse>0.82 0.80 0.78 1</diffuse>
        </material>
      </visual>

      <!-- 歐式古典屋頂飛簷與頂部冠頂 (Crown Cornice) -->
      <visual name="roof_crown">
        <pose>0 0 46.5 0 0 0</pose>
        <geometry><box><size>54.0 26.0 2.2</size></box></geometry>
        <material>
          <ambient>0.32 0.30 0.28 1</ambient>
          <diffuse>0.38 0.35 0.32 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
