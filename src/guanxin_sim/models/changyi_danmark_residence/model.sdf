<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="changyi_danmark_residence">
    <static>true</static>
    <link name="bldg_link">
      <collision name="podium_col">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><box><size>56.0 28.0 7.0</size></box></geometry>
      </collision>
      <collision name="tower_col">
        <pose>0 0 24.5 0 0 0</pose>
        <geometry><box><size>52.0 24.0 42.0</size></box></geometry>
      </collision>

      <!-- 1F 歐洲村石材基座與精品騎樓結構 -->
      <visual name="podium_base">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><box><size>56.0 28.0 7.0</size></box></geometry>
        <material>
          <ambient>0.62 0.58 0.52 1</ambient>
          <diffuse>0.70 0.65 0.58 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>

      <!-- 塔樓主體結構 (14F) -->
      <visual name="tower_main">
        <pose>0 0 24.5 0 0 0</pose>
        <geometry><box><size>52.0 24.0 42.0</size></box></geometry>
        <material>
          <ambient>0.68 0.52 0.44 1</ambient>
          <diffuse>0.76 0.60 0.50 1</diffuse>
        </material>
      </visual>

      <!-- ==================== 昌益丹麥 台灣特色二丁掛陶質面磚與古典框架高清表皮 ==================== -->
      <!-- 正立面 (Front Facade Facing North / Street) -->
      <visual name="danmark_facade_front_vis">
        <pose>0 12.06 24.5 0 0 0</pose>
        <geometry><box><size>52.0 0.10 42.0</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://changyi_danmark_residence/materials/textures/changyi_danmark_tile_facade.png</albedo_map>
              <roughness>0.38</roughness>
              <metalness>0.08</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 背立面 (Rear Facade Facing South) -->
      <visual name="danmark_facade_back_vis">
        <pose>0 -12.06 24.5 0 0 3.14159</pose>
        <geometry><box><size>52.0 0.10 42.0</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://changyi_danmark_residence/materials/textures/changyi_danmark_tile_facade.png</albedo_map>
              <roughness>0.38</roughness>
              <metalness>0.08</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 歐式古典屋頂飛簷與頂部冠頂 (Crown Cornice) -->
      <visual name="roof_crown">
        <pose>0 0 46.5 0 0 0</pose>
        <geometry><box><size>54.0 26.0 2.2</size></box></geometry>
        <material>
          <ambient>0.35 0.32 0.30 1</ambient>
          <diffuse>0.42 0.38 0.35 1</diffuse>
        </material>
      </visual>

      <!-- ==================== 台灣特色天際線：頂樓高層不鏽鋼水塔四聯陣列 ==================== -->
      <!-- 水塔 1 -->
      <visual name="water_tank_1">
        <pose>-15.0 0 48.6 0 0 0</pose>
        <geometry><cylinder><radius>1.1</radius><length>2.2</length></cylinder></geometry>
        <material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.85 0.88 0.92 1</diffuse><pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr></material>
      </visual>
      <visual name="water_tank_1_dome">
        <pose>-15.0 0 49.75 0 0 0</pose>
        <geometry><sphere><radius>1.12</radius></sphere></geometry>
        <material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.85 0.88 0.92 1</diffuse><pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr></material>
      </visual>

      <!-- 水塔 2 -->
      <visual name="water_tank_2">
        <pose>-5.0 0 48.6 0 0 0</pose>
        <geometry><cylinder><radius>1.1</radius><length>2.2</length></cylinder></geometry>
        <material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.85 0.88 0.92 1</diffuse><pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr></material>
      </visual>
      <visual name="water_tank_2_dome">
        <pose>-5.0 0 49.75 0 0 0</pose>
        <geometry><sphere><radius>1.12</radius></sphere></geometry>
        <material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.85 0.88 0.92 1</diffuse><pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr></material>
      </visual>

      <!-- 水塔 3 -->
      <visual name="water_tank_3">
        <pose>5.0 0 48.6 0 0 0</pose>
        <geometry><cylinder><radius>1.1</radius><length>2.2</length></cylinder></geometry>
        <material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.85 0.88 0.92 1</diffuse><pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr></material>
      </visual>
      <visual name="water_tank_3_dome">
        <pose>5.0 0 49.75 0 0 0</pose>
        <geometry><sphere><radius>1.12</radius></sphere></geometry>
        <material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.85 0.88 0.92 1</diffuse><pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr></material>
      </visual>

      <!-- 水塔 4 -->
      <visual name="water_tank_4">
        <pose>15.0 0 48.6 0 0 0</pose>
        <geometry><cylinder><radius>1.1</radius><length>2.2</length></cylinder></geometry>
        <material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.85 0.88 0.92 1</diffuse><pbr><metal><roughness>0.15</roughness><metalness>0.92</metalness></metal></pbr></material>
      </visual>
