<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="taipower_box">
    <static>true</static>
    <link name="box_link">
      <!-- 物理碰撞剛體 (簡化為單一 Box 幾何) -->
      <collision name="box_col">
        <pose>0 0 0.65 0 0 0</pose>
        <geometry>
          <box><size>1.2 0.7 1.3</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>

      <!-- 視覺呈現：混凝土基座 (Concrete Plinth) -->
      <visual name="plinth_vis">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <box><size>1.25 0.75 0.2</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.65 0.65 0.65 1</diffuse>
        </material>
      </visual>

      <!-- 視覺呈現：台電經典墨綠色雙門金屬箱體 (Taipower Green Cabinet) -->
      <visual name="cabinet_vis">
        <pose>0 0 0.7 0 0 0</pose>
        <geometry>
          <box><size>1.18 0.68 1.0</size></box>
        </geometry>
        <material>
          <ambient>0.12 0.32 0.16 1</ambient>
          <diffuse>0.15 0.38 0.20 1</diffuse>
        </material>
      </visual>

      <!-- 視覺呈現：箱頂斜頂遮雨蓋 (Top Cap) -->
      <visual name="top_cap_vis">
        <pose>0 0 1.22 0 0 0</pose>
        <geometry>
          <box><size>1.22 0.72 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.10 0.28 0.14 1</ambient>
          <diffuse>0.12 0.32 0.16 1</diffuse>
        </material>
      </visual>

      <!-- 視覺呈現：雙開門接縫飾條 -->
      <visual name="door_seam_vis">
        <pose>0 -0.345 0.7 0 0 0</pose>
        <geometry>
          <box><size>0.02 0.01 0.9</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.20 0.10 1</ambient>
          <diffuse>0.08 0.20 0.10 1</diffuse>
        </material>
      </visual>

      <!-- 視覺呈現：正面黃色高壓電警示標誌牌 (Taipower Warning Decal) -->
      <visual name="warning_sign_vis">
        <pose>0 -0.346 0.85 0 0 0</pose>
        <geometry>
          <box><size>0.24 0.005 0.24</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.85 0.1 1</ambient>
          <diffuse>1.0 0.9 0.1 1</diffuse>
          <emissive>0.3 0.25 0.0 1</emissive>
        </material>
      </visual>

      <!-- 視覺呈現：側面百葉散熱孔 (Side Louver Panels) -->
      <visual name="louver_l">
        <pose>-0.595 0 0.75 0 0 0</pose>
        <geometry>
          <box><size>0.01 0.35 0.45</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.22 0.12 1</ambient>
          <diffuse>0.1 0.25 0.14 1</diffuse>
        </material>
      </visual>
      <visual name="louver_r">
        <pose>0.595 0 0.75 0 0 0</pose>
        <geometry>
          <box><size>0.01 0.35 0.45</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.22 0.12 1</ambient>
          <diffuse>0.1 0.25 0.14 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
