<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="xinzhuang_station">
    <static>true</static>
    <link name="station_link">

      <!-- ==================== 物理碰撞幾何 (分層剛體 Box，確保車輛與行人零穿模) ==================== -->
      <!-- 1F 地面大廳主體碰撞剛體 -->
      <collision name="concourse_col">
        <pose>0 0 2.2 0 0 0</pose>
        <geometry><box><size>52.0 22.0 4.4</size></box></geometry>
      </collision>

      <!-- 2F 高架乘車月台層底板碰撞剛體 -->
      <collision name="platform_col">
        <pose>0 0 8.0 0 0 0</pose>
        <geometry><box><size>76.0 18.0 1.2</size></box></geometry>
      </collision>

      <!-- 西側與東側電梯與樓梯井核心筒碰撞剛體 -->
      <collision name="core_west_col">
        <pose>-18.0 0 7.0 0 0 0</pose>
        <geometry><box><size>6.0 8.0 14.0</size></box></geometry>
      </collision>
      <collision name="core_east_col">
        <pose>18.0 0 7.0 0 0 0</pose>
        <geometry><box><size>6.0 8.0 14.0</size></box></geometry>
      </collision>

      <!-- 頂部月台鋼構大跨度雨棚遮雨屋頂碰撞剛體 -->
      <collision name="roof_col">
        <pose>0 0 13.5 0 0 0</pose>
        <geometry><box><size>78.0 20.0 1.0</size></box></geometry>
      </collision>

      <!-- ==================== 1F 地面層售票大廳與迎賓入口 (Concourse & Entrance) ==================== -->
      <!-- 地面基礎大理石/清水模地坪基座 -->
      <visual name="plinth_vis">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>54.0 24.0 0.2</size></box></geometry>
        <material>
          <ambient>0.50 0.52 0.54 1</ambient>
          <diffuse>0.55 0.58 0.60 1</diffuse>
        </material>
      </visual>

      <!-- 大廳主結構混凝土柱 (Structural Concrete Columns) -->
      <visual name="col_sw_vis"><pose>-22.0 -9.0 2.2 0 0 0</pose><geometry><box><size>1.2 1.2 4.2</size></box></geometry><material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.65 0.68 0.70 1</diffuse></material></visual>
      <visual name="col_se_vis"><pose>22.0 -9.0 2.2 0 0 0</pose><geometry><box><size>1.2 1.2 4.2</size></box></geometry><material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.65 0.68 0.70 1</diffuse></material></visual>
      <visual name="col_nw_vis"><pose>-22.0 9.0 2.2 0 0 0</pose><geometry><box><size>1.2 1.2 4.2</size></box></geometry><material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.65 0.68 0.70 1</diffuse></material></visual>
      <visual name="col_ne_vis"><pose>22.0 9.0 2.2 0 0 0</pose><geometry><box><size>1.2 1.2 4.2</size></box></geometry><material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.65 0.68 0.70 1</diffuse></material></visual>

      <!-- 1F 大面積採光玻璃帷幕 (Glass Curtain Walls - 青透色帶深色鋁擠型窗框) -->
      <visual name="glass_front_vis">
        <pose>0 -10.9 2.2 0 0 0</pose>
        <geometry><box><size>48.0 0.1 3.8</size></box></geometry>
        <material>
          <ambient>0.15 0.25 0.35 0.85</ambient>
          <diffuse>0.20 0.35 0.45 0.85</diffuse>
          <specular>0.9 0.95 1.0 1</specular>
        </material>
      </visual>

      <visual name="glass_rear_vis">
        <pose>0 10.9 2.2 0 0 0</pose>
        <geometry><box><size>48.0 0.1 3.8</size></box></geometry>
        <material>
          <ambient>0.15 0.25 0.35 0.85</ambient>
          <diffuse>0.20 0.35 0.45 0.85</diffuse>
          <specular>0.9 0.95 1.0 1</specular>
        </material>
      </visual>

      <!-- 正門懸挑式鋼構防雨遮 (Main Entrance Cantilever Portico) -->
      <visual name="entrance_canopy_vis">
        <pose>0 -13.5 4.0 0 0 0</pose>
        <geometry><box><size>32.0 5.5 0.35</size></box></geometry>
        <material>
          <ambient>0.22 0.24 0.26 1</ambient>
          <diffuse>0.26 0.28 0.30 1</diffuse>
        </material>
      </visual>

      <!-- 遮雨棚支撐鋼柱 (Steel Support Struts) -->
      <visual name="canopy_strut_l"><pose>-14.0 -15.8 2.0 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.35 0.38 0.4 1</diffuse></material></visual>
      <visual name="canopy_strut_r"><pose>14.0 -15.8 2.0 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.35 0.38 0.4 1</diffuse></material></visual>

      <!-- 標誌性車站正門發光招牌 (Illuminated TRA Station Nameboard) -->
      <!-- 經典台鐵深藍色底板，白色「新莊車站 TRA Xin-Zhuang Station」標示 -->
      <visual name="station_signboard_bg">
        <pose>0 -13.6 4.6 0 0 0</pose>
        <geometry><box><size>16.0 0.15 1.1</size></box></geometry>
        <material>
          <ambient>0.05 0.20 0.50 1</ambient>
          <diffuse>0.08 0.28 0.65 1</diffuse>
        </material>
      </visual>

      <visual name="station_signboard_emblem">
        <pose>-6.0 -13.7 4.6 0 0 0</pose>
        <geometry><cylinder><radius>0.42</radius><length>0.1</length></cylinder></geometry>
        <material>
          <ambient>0.85 0.85 0.9 1</ambient>
          <diffuse>0.95 0.95 1.0 1</diffuse>
          <emissive>0.6 0.6 0.7 1</emissive>
        </material>
      </visual>

      <visual name="station_signboard_text">
        <pose>1.5 -13.7 4.6 0 0 0</pose>
        <geometry><box><size>11.0 0.08 0.6</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <emissive>0.8 0.8 0.8 1</emissive>
        </material>
      </visual>

      <!-- 1F 自動售票機與出入閘門景觀示意 (Ticket Gates Alcove) -->
      <visual name="fare_gates_vis">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><box><size>12.0 1.2 1.1</size></box></geometry>
        <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.35 0.4 0.45 1</diffuse></material>
      </visual>

      <!-- ==================== 垂直動線核心筒 (Stair & Elevator Towers) ==================== -->
      <visual name="tower_west_vis">
        <pose>-18.0 0 7.0 0 0 0</pose>
        <geometry><box><size>5.8 7.8 13.8</size></box></geometry>
        <material>
          <ambient>0.65 0.68 0.70 1</ambient>
          <diffuse>0.72 0.75 0.78 1</diffuse>
        </material>
      </visual>

      <visual name="tower_east_vis">
        <pose>18.0 0 7.0 0 0 0</pose>
        <geometry><box><size>5.8 7.8 13.8</size></box></geometry>
        <material>
          <ambient>0.65 0.68 0.70 1</ambient>
          <diffuse>0.72 0.75 0.78 1</diffuse>
        </material>
      </visual>

      <!-- ==================== 2F 高架月台層與軌道結構 (Elevated Platform & Tracks) ==================== -->
      <!-- 鋼筋混凝土厚重樑板結構 (Concrete Platform Deck) -->
      <visual name="platform_deck_vis">
        <pose>0 0 7.9 0 0 0</pose>
        <geometry><box><size>76.0 18.0 1.0</size></box></geometry>
        <material>
          <ambient>0.62 0.64 0.66 1</ambient>
          <diffuse>0.68 0.70 0.72 1</diffuse>
        </material>
      </visual>

      <!-- 月台防落軌玻璃防護安全欄杆 (Platform Safety Balustrades) -->
      <visual name="platform_rail_s">
        <pose>0 -8.9 8.9 0 0 0</pose>
        <geometry><box><size>74.0 0.1 1.1</size></box></geometry>
        <material><ambient>0.2 0.4 0.5 0.6</ambient><diffuse>0.3 0.5 0.6 0.6</diffuse></material>
      </visual>
      <visual name="platform_rail_n">
        <pose>0 8.9 8.9 0 0 0</pose>
        <geometry><box><size>74.0 0.1 1.1</size></box></geometry>
        <material><ambient>0.2 0.4 0.5 0.6</ambient><diffuse>0.3 0.5 0.6 0.6</diffuse></material>
      </visual>

      <!-- 月台候車黃色警戒等候線 (Yellow Platform Warning Edge Lines) -->
      <visual name="safety_line_s"><pose>0 -7.2 8.42 0 0 0</pose><geometry><box><size>74.0 0.25 0.005</size></box></geometry><material><ambient>0.9 0.85 0.05 1</ambient><diffuse>0.95 0.9 0.08 1</diffuse></material></visual>
      <visual name="safety_line_n"><pose>0 7.2 8.42 0 0 0</pose><geometry><box><size>74.0 0.25 0.005</size></box></geometry><material><ambient>0.9 0.85 0.05 1</ambient><diffuse>0.95 0.9 0.08 1</diffuse></material></visual>

      <!-- 月台雙軌鐵軌與道碴示意 (Steel Rails & Ballast: 南北雙線) -->
      <visual name="track_south_bed"><pose>0 -5.5 8.43 0 0 0</pose><geometry><box><size>76.0 2.2 0.06</size></box></geometry><material><ambient>0.3 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material></visual>
      <visual name="track_north_bed"><pose>0 5.5 8.43 0 0 0</pose><geometry><box><size>76.0 2.2 0.06</size></box></geometry><material><ambient>0.3 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material></visual>

      <!-- 鋼軌 (Rails) -->
      <visual name="rail_s1"><pose>0 -6.0 8.50 0 0 0</pose><geometry><box><size>76.0 0.07 0.10</size></box></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
      <visual name="rail_s2"><pose>0 -5.0 8.50 0 0 0</pose><geometry><box><size>76.0 0.07 0.10</size></box></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
      <visual name="rail_n1"><pose>0 5.0 8.50 0 0 0</pose><geometry><box><size>76.0 0.07 0.10</size></box></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
      <visual name="rail_n2"><pose>0 6.0 8.50 0 0 0</pose><geometry><box><size>76.0 0.07 0.10</size></box></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>

      <!-- ==================== 鋼結構拱形遮雨大棚 (Steel Truss Curved Canopy) ==================== -->
      <!-- 鋼構主拱桁架樑列 (Truss Arches) -->
      <visual name="roof_truss_main">
        <pose>0 0 13.6 0 0 0</pose>
        <geometry><box><size>78.0 20.0 0.4</size></box></geometry>
        <material>
          <ambient>0.28 0.30 0.32 1</ambient>
          <diffuse>0.32 0.35 0.38 1</diffuse>
        </material>
      </visual>

      <!-- 弧形金屬波浪烤漆屋面板 (Curved Corrugated Roof Surface - 銀灰/深灰) -->
      <visual name="roof_cladding_vis">
        <pose>0 0 14.1 0 0 0</pose>
        <geometry><box><size>78.5 20.5 0.2</size></box></geometry>
        <material>
          <ambient>0.48 0.52 0.55 1</ambient>
          <diffuse>0.55 0.60 0.64 1</diffuse>
          <specular>0.6 0.65 0.7 1</specular>
        </material>
      </visual>

      <!-- 鋼構支撐斜柱 (Y-Shaped Canopy Support Columns) -->
      <visual name="truss_col1"><pose>-25.0 0 10.8 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>4.8</length></cylinder></geometry><material><ambient>0.25 0.28 0.3 1</ambient><diffuse>0.3 0.33 0.36 1</diffuse></material></visual>
      <visual name="truss_col2"><pose>0.0 0 10.8 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>4.8</length></cylinder></geometry><material><ambient>0.25 0.28 0.3 1</ambient><diffuse>0.3 0.33 0.36 1</diffuse></material></visual>
      <visual name="truss_col3"><pose>25.0 0 10.8 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>4.8</length></cylinder></geometry><material><ambient>0.25 0.28 0.3 1</ambient><diffuse>0.3 0.33 0.36 1</diffuse></material></visual>

      <!-- 月台發光站名燈箱 (Platform Illuminated Station Signs) -->
      <visual name="plat_sign1"><pose>-10.0 0 10.2 0 0 0</pose><geometry><box><size>2.2 0.25 0.6</size></box></geometry><material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.15 0.4 0.85 1</diffuse><emissive>0.7 0.7 0.8 1</emissive></material></visual>
      <visual name="plat_sign2"><pose>10.0 0 10.2 0 0 0</pose><geometry><box><size>2.2 0.25 0.6</size></box></geometry><material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.15 0.4 0.85 1</diffuse><emissive>0.7 0.7 0.8 1</emissive></material></visual>

    </link>
  </model>
</sdf>
