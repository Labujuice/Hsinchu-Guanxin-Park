        <geometry><box><size>6.0 6.0 0.3</size></box></geometry>
        <material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.32 0.25 1</diffuse></material>
      </visual>
      <visual name="mid_pavilion_p1"><pose>-17.5 -2.5 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3.0</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
      <visual name="mid_pavilion_p2"><pose>-12.5 -2.5 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3.0</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
      <visual name="mid_pavilion_p3"><pose>-17.5 2.5 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3.0</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
      <visual name="mid_pavilion_p4"><pose>-12.5 2.5 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3.0</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>

      <!-- 中庭休閒長椅群 (Park Benches) -->
      <visual name="mid_bench1"><pose>5.0 -4.0 0.4 0 0 0</pose><geometry><box><size>2.0 0.6 0.45</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      <visual name="mid_bench2"><pose>5.0 4.0 0.4 0 0 0</pose><geometry><box><size>2.0 0.6 0.45</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>

      <!-- 中庭兒童遊樂遊戲區 (Children Playground in Central Park) -->
      <visual name="mid_play_mat"><pose>18.0 0 0.125 0 0 0</pose><geometry><box><size>12.0 10.0 0.015</size></box></geometry><material><ambient>0.15 0.45 0.7 1</ambient><diffuse>0.2 0.55 0.85 1</diffuse></material></visual>
      <visual name="mid_spring_rider"><pose>18.0 0 0.6 0 0 0</pose><geometry><box><size>0.9 0.4 0.8</size></box></geometry><material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.95 0.8 0.15 1</diffuse></material></visual>

      <!-- 中庭成蔭綠樹 (Courtyard Shade Trees) -->
      <visual name="tree_trunk_1"><pose>-5.0 -6.0 2.0 0 0 0</pose><geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry><material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.42 0.30 0.20 1</diffuse></material></visual>
      <visual name="tree_crown_1"><pose>-5.0 -6.0 4.5 0 0 0</pose><geometry><sphere><radius>2.4</radius></sphere></geometry><material><ambient>0.12 0.48 0.15 1</ambient><diffuse>0.16 0.58 0.20 1</diffuse></material></visual>
      <visual name="tree_trunk_2"><pose>-5.0 6.0 2.0 0 0 0</pose><geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry><material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.42 0.30 0.20 1</diffuse></material></visual>
      <visual name="tree_crown_2"><pose>-5.0 6.0 4.5 0 0 0</pose><geometry><sphere><radius>2.4</radius></sphere></geometry><material><ambient>0.12 0.48 0.15 1</ambient><diffuse>0.16 0.58 0.20 1</diffuse></material></visual>

      <!-- ==================== 4. 社區開放道路 (Open Community Road: 關新路19巷貫穿) ==================== -->
      <!-- 穿過社區側翼之開放柏油道路 (Asphalt Pavement: 寬 6.0m) -->
      <visual name="open_road_asphalt">
        <pose>28.5 0 0.10 0 0 0</pose>
        <geometry><box><size>5.5 58.0 0.02</size></box></geometry>
        <material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse></material>
      </visual>

      <!-- 道路分向黃實線 -->
      <visual name="open_road_line">
        <pose>28.5 0 0.115 0 0 0</pose>
        <geometry><box><size>0.15 56.0 0.002</size></box></geometry>
        <material><ambient>0.9 0.85 0.1 1</ambient><diffuse>0.95 0.9 0.1 1</diffuse></material>
