        <geometry><box><size>58.0 22.0 0.02</size></box></geometry>
        <material>
          <ambient>0.16 0.52 0.18 1</ambient>
          <diffuse>0.22 0.62 0.25 1</diffuse>
        </material>
      </visual>

      <!-- 中庭步道系統 (Central Walking Paths: 紅磚與花崗岩步道) -->
