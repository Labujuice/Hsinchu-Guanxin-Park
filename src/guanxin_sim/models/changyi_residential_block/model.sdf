<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="changyi_residential_block">
    <static>true</static>
    <link name="block_link">

      <!-- ==================== 物理碰撞剛體 ==================== -->
      <!-- 主體後方塔身碰撞體 (Main Tower Body) -->
      <collision name="tower_main_col">
        <pose>0 -2.0 24.0 0 0 0</pose>
        <geometry><box><size>64.0 31.0 48.0</size></box></geometry>
      </collision>

      <!-- 騎樓上方天花板與二樓懸挑樓板碰撞體 (Arcade Soffit) -->
      <collision name="arcade_roof_col">
        <pose>0 15.5 26.25 0 0 0</pose>
        <geometry><box><size>64.0 4.0 43.5</size></box></geometry>
      </collision>

      <!-- ==================== 視覺呈現：大樓主體與現代外觀 (Tower Facade) ==================== -->
      <visual name="tower_main_vis">
        <pose>0 -2.0 24.0 0 0 0</pose>
        <geometry><box><size>63.6 30.6 48.0</size></box></geometry>
        <material>
          <ambient>0.76 0.74 0.72 1</ambient>
          <diffuse>0.82 0.80 0.78 1</diffuse>
        </material>
      </visual>

      <visual name="tower_upper_vis">
        <pose>0 15.5 26.25 0 0 0</pose>
        <geometry><box><size>63.6 3.8 43.5</size></box></geometry>
        <material>
          <ambient>0.76 0.74 0.72 1</ambient>
          <diffuse>0.82 0.80 0.78 1</diffuse>
        </material>
      </visual>

      <!-- ==================== 1F 挑高深凹連續騎樓走廊 (Ground Floor Arcade) ==================== -->
      <!-- 騎樓地磚地面 (Arcade Paver Floor) -->
      <visual name="arcade_floor_vis">
        <pose>0 15.5 0.08 0 0 0</pose>
        <geometry><box><size>64.0 3.8 0.02</size></box></geometry>
        <material><ambient>0.65 0.62 0.60 1</ambient><diffuse>0.72 0.70 0.68 1</diffuse></material>
      </visual>

      <!-- 騎樓天花板 (Arcade Ceiling) -->
      <visual name="arcade_ceiling_vis">
        <pose>0 15.5 4.3 0 0 0</pose>
        <geometry><box><size>64.0 3.8 0.25</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>

      <!-- 騎樓外緣實體結構大圓柱列 (Arcade Concrete Columns) -->
      <visual name="col_1"><pose>-25.0 17.2 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>
      <visual name="col_2"><pose>-12.5 17.2 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>
      <visual name="col_3"><pose>0.0 17.2 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>
      <visual name="col_4"><pose>12.5 17.2 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>
      <visual name="col_5"><pose>25.0 17.2 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>

      <!-- 騎樓內側商鋪透明玻璃落地門面與招牌 (Storefronts) -->
      <visual name="shops_glass">
        <pose>0 13.55 2.1 0 0 0</pose>
        <geometry><box><size>62.0 0.1 3.8</size></box></geometry>
        <material>
          <ambient>0.15 0.25 0.35 0.85</ambient>
          <diffuse>0.20 0.35 0.45 0.85</diffuse>
          <specular>0.9 0.95 1.0 1</specular>
        </material>
      </visual>

      <!-- 商鋪門楣橫向燈箱招牌 -->
      <visual name="shops_fascia">
        <pose>0 13.6 3.8 0 0 0</pose>
        <geometry><box><size>62.0 0.2 0.8</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material>
      </visual>

      <!-- ==================== 2F~15F 幾何立體陽台與外飾板 (Layered Balconies) ==================== -->
      <visual name="balconies_facade">
        <pose>0 17.5 26.5 0 0 0</pose>
        <geometry><box><size>58.0 0.4 42.0</size></box></geometry>
        <material><ambient>0.28 0.30 0.32 1</ambient><diffuse>0.32 0.35 0.38 1</diffuse></material>
      </visual>

      <!-- 建築頂部天際線女兒牆 (Roof Parapet) -->
      <visual name="roof_parapet">
        <pose>0 0 48.5 0 0 0</pose>
        <geometry><box><size>64.5 35.5 1.0</size></box></geometry>
        <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.4 0.4 0.43 1</diffuse></material>
      </visual>

    </link>
  </model>
</sdf>
