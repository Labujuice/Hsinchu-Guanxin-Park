<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="changyi_residential_block">
    <static>true</static>
    <link name="nordic_block_link">

      <!-- ==================== 物理碰撞剛體 (東排大樓、西排大樓與騎樓) ==================== -->
      <!-- 東排大樓碰撞剛體 (East Row: 15層樓, 高48m, 臨關新路) -->
      <collision name="east_row_col">
        <pose>0 20.0 24.0 0 0 0</pose>
        <geometry><box><size>60.0 16.0 48.0</size></box></geometry>
      </collision>

      <!-- 西排大樓碰撞剛體 (West Row: 15層樓, 高48m, 內排) -->
      <collision name="west_row_col">
        <pose>0 -20.0 24.0 0 0 0</pose>
        <geometry><box><size>60.0 16.0 48.0</size></box></geometry>
      </collision>

      <!-- 中間中庭公園地基大底碰撞剛體 -->
      <collision name="park_ground_col">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><box><size>62.0 58.0 0.10</size></box></geometry>
      </collision>

      <!-- ==================== 1. 東排大樓 (East Row: 臨關新路 15F 豪宅, 挑高連續騎樓) ==================== -->
      <!-- 東排大樓主體 -->
      <visual name="east_row_main_vis">
        <pose>0 20.0 24.0 0 0 0</pose>
        <geometry><box><size>59.6 15.6 48.0</size></box></geometry>
        <material>
          <ambient>0.76 0.74 0.72 1</ambient>
          <diffuse>0.82 0.80 0.78 1</diffuse>
        </material>
      </visual>

      <!-- 1F 挑高深凹連續騎樓走廊 (Ground Arcade facing Guanxin Rd: Y = +27.0m) -->
      <visual name="east_arcade_floor">
        <pose>0 26.2 0.08 0 0 0</pose>
        <geometry><box><size>59.0 3.6 0.02</size></box></geometry>
        <material><ambient>0.65 0.62 0.60 1</ambient><diffuse>0.72 0.70 0.68 1</diffuse></material>
      </visual>

      <visual name="east_arcade_ceiling">
        <pose>0 26.2 4.2 0 0 0</pose>
        <geometry><box><size>59.0 3.6 0.25</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>

      <!-- 騎樓結構大圓柱列 (5 根大圓柱) -->
      <visual name="east_col_1"><pose>-24.0 27.8 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>
      <visual name="east_col_2"><pose>-12.0 27.8 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>
      <visual name="east_col_3"><pose>0.0 27.8 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>
      <visual name="east_col_4"><pose>12.0 27.8 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>
      <visual name="east_col_5"><pose>24.0 27.8 2.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.2</length></cylinder></geometry><material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual>

      <!-- 1F 店鋪落地玻璃櫥窗與招牌 (7-Eleven, 診所, 咖啡館) -->
      <visual name="east_shops_glass">
        <pose>0 24.3 2.1 0 0 0</pose>
        <geometry><box><size>58.0 0.1 3.8</size></box></geometry>
        <material><ambient>0.15 0.25 0.35 0.85</ambient><diffuse>0.20 0.35 0.45 0.85</diffuse><specular>0.9 0.95 1.0 1</specular></material>
      </visual>

      <!-- 2F~15F 臨關新路立體陽台 (Balconies facing Guanxin Rd) -->
      <visual name="east_balconies_vis">
        <pose>0 28.0 26.5 0 0 0</pose>
        <geometry><box><size>56.0 0.6 42.0</size></box></geometry>
        <material><ambient>0.28 0.30 0.32 1</ambient><diffuse>0.32 0.35 0.38 1</diffuse></material>
      </visual>

      <!-- ==================== 2. 西排大樓 (West Row: 15F 內排大樓, 面向中庭公園) ==================== -->
      <visual name="west_row_main_vis">
        <pose>0 -20.0 24.0 0 0 0</pose>
        <geometry><box><size>59.6 15.6 48.0</size></box></geometry>
        <material>
          <ambient>0.74 0.72 0.70 1</ambient>
          <diffuse>0.80 0.78 0.76 1</diffuse>
        </material>
      </visual>

      <!-- 西排大樓面向中庭公園之景觀陽台 (Balconies facing Central Park: Y = -11.8m) -->
      <visual name="west_balconies_vis">
        <pose>0 -11.8 24.0 0 0 0</pose>
        <geometry><box><size>56.0 0.6 44.0</size></box></geometry>
        <material><ambient>0.26 0.28 0.30 1</ambient><diffuse>0.30 0.32 0.35 1</diffuse></material>
      </visual>

      <!-- ==================== 3. 兩排中間的社區公園 (Central Community Park: 24m x 60m) ==================== -->
      <!-- 中庭公園綠茵大草坪 (Central Lawn in the middle between the two rows) -->
      <visual name="mid_park_lawn">
