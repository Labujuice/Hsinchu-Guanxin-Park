<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="parked_car_suv">
    <static>true</static>
    <link name="car_link">

      <!-- 物理碰撞剛體 (單一 Box 幾何) -->
      <collision name="suv_col">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry><box><size>4.7 1.88 1.6</size></box></geometry>
      </collision>

      <!-- 視覺：車身主體 (Alpine Pearl White Body) -->
      <visual name="body_main">
        <pose>0 0 0.65 0 0 0</pose>
        <geometry><box><size>4.7 1.88 0.8</size></box></geometry>
        <material><ambient>0.88 0.88 0.90 1</ambient><diffuse>0.94 0.94 0.96 1</diffuse></material>
      </visual>

      <!-- 視覺：高頂座艙 (SUV High Roof Cabin) -->
      <visual name="cabin">
        <pose>-0.1 0 1.3 0 0 0</pose>
        <geometry><box><size>2.9 1.62 0.75</size></box></geometry>
        <material><ambient>0.15 0.18 0.22 0.9</ambient><diffuse>0.20 0.25 0.30 0.9</diffuse></material>
      </visual>

      <!-- 視覺：車頂行李架導軌 (Roof Rails) -->
      <visual name="roof_rail_l"><pose>-0.1 0.72 1.72 0 0 0</pose><geometry><box><size>2.4 0.05 0.06</size></box></geometry><material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material></visual>
      <visual name="roof_rail_r"><pose>-0.1 -0.72 1.72 0 0 0</pose><geometry><box><size>2.4 0.05 0.06</size></box></geometry><material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material></visual>

      <!-- 視覺：大尺寸越野/休旅車輪 (4 SUV Wheels: 半徑 0.36m) -->
      <visual name="wheel_fl"><pose>1.45 0.88 0.36 1.5708 0 0</pose><geometry><cylinder><radius>0.36</radius><length>0.24</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="wheel_fr"><pose>1.45 -0.88 0.36 1.5708 0 0</pose><geometry><cylinder><radius>0.36</radius><length>0.24</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="wheel_rl"><pose>-1.45 0.88 0.36 1.5708 0 0</pose><geometry><cylinder><radius>0.36</radius><length>0.24</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="wheel_rr"><pose>-1.45 -0.88 0.36 1.5708 0 0</pose><geometry><cylinder><radius>0.36</radius><length>0.24</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>

      <!-- 視覺：頭燈與尾燈 -->
      <visual name="headlight_l"><pose>2.36 0.68 0.75 0 0 0</pose><geometry><box><size>0.05 0.32 0.14</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.98 0.98 0.95 1</diffuse><emissive>0.3 0.3 0.28 1</emissive></material></visual>
      <visual name="headlight_r"><pose>2.36 -0.68 0.75 0 0 0</pose><geometry><box><size>0.05 0.32 0.14</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.98 0.98 0.95 1</diffuse><emissive>0.3 0.3 0.28 1</emissive></material></visual>
      <visual name="taillight_l"><pose>-2.36 0.68 0.80 0 0 0</pose><geometry><box><size>0.05 0.32 0.14</size></box></geometry><material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.92 0.08 0.08 1</diffuse><emissive>0.25 0.02 0.02 1</emissive></material></visual>
      <visual name="taillight_r"><pose>-2.36 -0.68 0.80 0 0 0</pose><geometry><box><size>0.05 0.32 0.14</size></box></geometry><material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.92 0.08 0.08 1</diffuse><emissive>0.25 0.02 0.02 1</emissive></material></visual>
    </link>
  </model>
</sdf>
