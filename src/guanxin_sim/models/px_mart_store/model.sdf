<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="px_mart_store">
    <static>true</static>
    <link name="pxmart_link">

      <!-- ==================== 物理碰撞剛體 (Decoupled Primitives) ==================== -->
      <!-- 主建物量體剛體 (32m x 22m x 8.0m) -->
      <collision name="building_col">
        <pose>0 0 4.0 0 0 0</pose>
        <geometry><box><size>32.0 22.0 8.0</size></box></geometry>
      </collision>
      <!-- 門前雨遮剛體 -->
      <collision name="canopy_col">
        <pose>0 11.8 3.5 0 0 0</pose>
        <geometry><box><size>16.0 2.2 0.3</size></box></geometry>
      </collision>
      <!-- 後方貨物裝卸月台剛體 -->
      <collision name="dock_col">
        <pose>-6.0 -11.8 0.6 0 0 0</pose>
        <geometry><box><size>10.0 2.4 1.2</size></box></geometry>
      </collision>

      <!-- ==================== 視覺主體：全聯現代雙層商場建築 ==================== -->
      <!-- 主建築白色微紋理外牆 -->
      <visual name="building_walls">
        <pose>0 0 4.0 0 0 0</pose>
        <geometry><box><size>32.0 22.0 8.0</size></box></geometry>
        <material>
          <ambient>0.88 0.88 0.90 1</ambient>
          <diffuse>0.92 0.92 0.94 1</diffuse>
        </material>
      </visual>

      <!-- 頂樓微凸的女兒牆邊緣 (Roof Parapet Cap) -->
      <visual name="roof_parapet">
        <pose>0 0 8.1 0 0 0</pose>
        <geometry><box><size>32.4 22.4 0.25</size></box></geometry>
        <material>
          <ambient>0.3 0.32 0.35 1</ambient>
          <diffuse>0.38 0.40 0.44 1</diffuse>
        </material>
      </visual>

      <!-- ==================== 全聯福利中心 台灣特色高清擬真店招與門面 (Photo-Real PBR Signboards) ==================== -->
      <!-- 1. 正面橫式發光主招牌 (Fascia Signboard: 24.0m x 2.4m, 比例 10.0:1 完全吻合 1600x160 貼圖) -->
      <visual name="pxmart_fascia_vis">
        <pose>0 11.08 5.6 0 0 0</pose>
        <geometry><box><size>24.0 0.14 2.4</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.45 0.45 0.45 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://px_mart_store/materials/textures/pxmart_fascia_sign.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 2. 超市 1F 落地採光大櫥窗與自動感應玻璃門 (Supermarket Glass Curtain) -->
      <visual name="pxmart_entrance_glass">
        <pose>0 11.04 1.7 0 0 0</pose>
        <geometry><box><size>20.0 0.08 3.4</size></box></geometry>
        <material>
          <ambient>0.2 0.32 0.42 0.85</ambient>
          <diffuse>0.28 0.42 0.52 0.85</diffuse>
          <specular>0.9 0.95 1.0 1</specular>
        </material>
      </visual>

      <!-- 3. 側懸垂直雙面發光店招 (Protruding Blade Signboard: 1.0m x 2.0m, 比例 1:2 完全吻合 512x1024 貼圖) -->
      <visual name="pxmart_blade_sign">
        <pose>16.08 10.0 5.2 0 0 1.5708</pose>
        <geometry><box><size>1.0 0.16 2.0</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.50 0.50 0.50 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://px_mart_store/materials/textures/pxmart_blade_sign.png</albedo_map>
              <roughness>0.20</roughness>
              <metalness>0.05</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 挑出式深灰色進口懸挑雨遮 (Steel Entrance Canopy: 16m x 2.2m) -->
      <visual name="entrance_canopy">
        <pose>0 11.8 3.5 0 0 0</pose>
        <geometry><box><size>16.0 2.2 0.25</size></box></geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.30 0.32 0.34 1</diffuse>
        </material>
      </visual>

      <!-- 雨遮支撐不銹鋼拉桿 (Tension Rods) -->
      <visual name="canopy_rod_1"><pose>-6.5 11.4 4.3 0 0.45 0</pose><geometry><cylinder><radius>0.03</radius><length>1.8</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>
      <visual name="canopy_rod_2"><pose>6.5 11.4 4.3 0 -0.45 0</pose><geometry><cylinder><radius>0.03</radius><length>1.8</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>

      <!-- ==================== 門前不銹鋼手推車收納專區 (Shopping Cart Corral) ==================== -->
      <visual name="cart_shelter_roof">
        <pose>10.5 12.2 2.2 0 0 0</pose>
        <geometry><box><size>5.0 2.0 0.1</size></box></geometry>
        <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.38 0.40 0.45 1</diffuse></material>
      </visual>
      <visual name="cart_shelter_post1"><pose>8.2 11.4 1.1 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.2</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>
      <visual name="cart_shelter_post2"><pose>12.8 11.4 1.1 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.2</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>
      <visual name="cart_shelter_post3"><pose>8.2 13.0 1.1 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.2</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>
      <visual name="cart_shelter_post4"><pose>12.8 13.0 1.1 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.2</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>
      <!-- 排列整齊的購物手推車排 (Nested Carts) -->
      <visual name="px_carts_row1">
        <pose>10.5 11.9 0.45 0 0 0</pose>
        <geometry><box><size>4.2 0.45 0.75</size></box></geometry>
        <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.75 0.78 0.8 1</diffuse></material>
      </visual>
      <visual name="px_carts_row1_handles">
        <pose>10.5 11.9 0.85 0 0 0</pose>
        <geometry><box><size>4.2 0.08 0.05</size></box></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.95 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="px_carts_row2">
        <pose>10.5 12.5 0.45 0 0 0</pose>
        <geometry><box><size>4.2 0.45 0.75</size></box></geometry>
        <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.75 0.78 0.8 1</diffuse></material>
      </visual>
      <visual name="px_carts_row2_handles">
        <pose>10.5 12.5 0.85 0 0 0</pose>
        <geometry><box><size>4.2 0.08 0.05</size></box></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.95 0.12 0.12 1</diffuse></material>
      </visual>

      <!-- ==================== 門前不銹鋼防撞立柱 (Stainless Bollards) ==================== -->
      <visual name="bollard_1"><pose>-3.0 12.5 0.45 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>
      <visual name="bollard_2"><pose>-1.0 12.5 0.45 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>
      <visual name="bollard_3"><pose>1.0 12.5 0.45 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>
      <visual name="bollard_4"><pose>3.0 12.5 0.45 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material></visual>

      <!-- ==================== 後方生鮮與乾貨進貨卸貨專區 (Logistics Dock) ==================== -->
      <!-- 混凝土高架裝卸平台 (Dock Platform) -->
      <visual name="dock_platform">
        <pose>-6.0 -11.8 0.6 0 0 0</pose>
        <geometry><box><size>10.0 2.4 1.2</size></box></geometry>
        <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.58 0.60 0.62 1</diffuse></material>
      </visual>
      <!-- 防撞黑黃斜紋警示邊 (Hazard Striping) -->
      <visual name="dock_edge_hazard">
        <pose>-6.0 -12.98 0.6 0 0 0</pose>
        <geometry><box><size>9.8 0.05 1.1</size></box></geometry>
        <material><ambient>0.9 0.8 0.05 1</ambient><diffuse>0.95 0.85 0.08 1</diffuse></material>
      </visual>
      <!-- 金屬工業電動捲門 (Roll-up Shutter Doors: 2 樘進貨門) -->
      <visual name="dock_shutter_1">
        <pose>-8.0 -10.95 2.5 0 0 0</pose>
        <geometry><box><size>3.2 0.1 3.0</size></box></geometry>
        <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.36 0.38 0.42 1</diffuse></material>
      </visual>
      <visual name="dock_shutter_2">
        <pose>-4.0 -10.95 2.5 0 0 0</pose>
        <geometry><box><size>3.2 0.1 3.0</size></box></geometry>
        <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.36 0.38 0.42 1</diffuse></material>
      </visual>

      <!-- ==================== 屋頂空調冷卻水塔與通風設備 (Rooftop HVAC) ==================== -->
      <visual name="hvac_unit_1">
        <pose>-8.0 2.0 8.8 0 0 0</pose>
        <geometry><box><size>4.2 3.0 1.5</size></box></geometry>
        <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.48 0.50 0.52 1</diffuse></material>
      </visual>
      <visual name="hvac_fan_1">
        <pose>-8.0 2.0 9.6 0 0 0</pose>
        <geometry><cylinder><radius>1.0</radius><length>0.3</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <visual name="hvac_unit_2">
        <pose>6.0 -3.0 8.8 0 0 0</pose>
        <geometry><box><size>3.5 2.5 1.4</size></box></geometry>
        <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.48 0.50 0.52 1</diffuse></material>
      </visual>

      <!-- ==================== 台灣特色：頂樓雙聯不鏽鋼白鐵水塔 (Twin Stainless Steel Water Tanks) ==================== -->
      <visual name="water_tank_1_stand">
        <pose>10.0 -4.0 8.4 0 0 0</pose>
        <geometry><box><size>2.0 2.0 0.4</size></box></geometry>
        <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material>
      </visual>
      <visual name="water_tank_1_body">
        <pose>10.0 -4.0 9.5 0 0 0</pose>
        <geometry><cylinder><radius>0.9</radius><length>1.8</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.9</metalness></metal></pbr>
        </material>
      </visual>
      <visual name="water_tank_1_dome">
        <pose>10.0 -4.0 10.45 0 0 0</pose>
        <geometry><sphere><radius>0.92</radius></sphere></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.9</metalness></metal></pbr>
        </material>
      </visual>

      <visual name="water_tank_2_stand">
        <pose>10.0 -6.5 8.4 0 0 0</pose>
        <geometry><box><size>2.0 2.0 0.4</size></box></geometry>
        <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material>
      </visual>
      <visual name="water_tank_2_body">
        <pose>10.0 -6.5 9.5 0 0 0</pose>
        <geometry><cylinder><radius>0.9</radius><length>1.8</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.9</metalness></metal></pbr>
        </material>
      </visual>
      <visual name="water_tank_2_dome">
        <pose>10.0 -6.5 10.45 0 0 0</pose>
        <geometry><sphere><radius>0.92</radius></sphere></geometry>
        <material>
          <ambient>0.75 0.78 0.82 1</ambient>
          <diffuse>0.85 0.88 0.92 1</diffuse>
          <pbr><metal><roughness>0.15</roughness><metalness>0.9</metalness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
